---
import "@/styles/global.css";
import { siteConfig } from "../../site.config";
import { themeBootstrap } from "@/lib/theme";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArchiveRail from "@/components/ArchiveRail.astro";
import ContactForm from "@/components/ContactForm.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";

interface Props {
  title?: string;
  description?: string;
  /** Open Graph image URL (absolute). */
  ogImage?: string;
  /** Accessible description for the social preview image. */
  ogImageAlt?: string;
  /** Keep private utility pages out of search results. */
  noindex?: boolean;
  /** Slug of the current session, for nav highlight. */
  activeSlug?: string;
  /**
   * Top-level section. 'photography' (default) shows the sessions sidebar and
   * its hamburger; 'hobbies' hides them and highlights the Hobbies nav item.
   */
  section?: "photography" | "hobbies";
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  noindex = false,
  activeSlug,
  section = "photography",
} = Astro.props;
const pageTitle = title
  ? `${title} | ${siteConfig.siteTitle}`
  : siteConfig.siteTitle;
const pageDescription = description ?? siteConfig.siteDescription;
const siteOrigin = Astro.site ?? `https://${siteConfig.domain}`;
const blobOrigin = `https://${siteConfig.blobHost}`;
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
// Open Graph images must be absolute URLs so crawlers can fetch them. Blob
// URLs already are; resolve any relative local asset path against the site.
const ogImageAbsolute = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : new URL(ogImage, siteOrigin).toString()
  : undefined;
---

<!doctype html>
<html lang={siteConfig.defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={siteConfig.ownerName} />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    {/* The theme toggle keeps this in step with the paper colour. */}
    <meta name="theme-color" content="#fbfaf8" />
    <link rel="preconnect" href={blobOrigin} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.siteTitle} />
    <meta
      property="og:locale"
      content={siteConfig.defaultLocale.replace("-", "_")}
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    {ogImageAbsolute && <meta property="og:image" content={ogImageAbsolute} />}
    {
      ogImageAbsolute && (
        <meta property="og:image:alt" content={ogImageAlt ?? pageTitle} />
      )
    }
    <meta
      name="twitter:card"
      content={ogImageAbsolute ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImageAbsolute && <meta name="twitter:image" content={ogImageAbsolute} />}
    {
      ogImageAbsolute && (
        <meta name="twitter:image:alt" content={ogImageAlt ?? pageTitle} />
      )
    }

    <title>{pageTitle}</title>
    <script is:inline set:html={themeBootstrap} />
  </head>
  <body class="min-h-screen">
    <a class="skip-link" href="#main">Skip to content</a>
    {
      section === "photography" ? (
        <div id="page-shell" class="archive-shell">
          <ArchiveRail activeSlug={activeSlug} section={section} />
          <button
            class="archive-scrim"
            id="archive-scrim"
            type="button"
            aria-label="Close sessions"
            hidden
          />
          <div id="page-content" class="archive-main">
            <div class="archive-bar">
              <a class="bar-me" href="/">
                {siteConfig.ownerName}
              </a>
              <span class="bar-acts">
                <ThemeToggle class="bar-theme" />
                {siteConfig.sections.hobbies && (
                  <a class="bar-link" href="/hobbies">
                    Things to try
                  </a>
                )}
                <button id="rail-open" class="bar-button" type="button">
                  Sessions
                </button>
              </span>
            </div>
            <main id="main" tabindex="-1" class="flex-1">
              <slot />
            </main>
            <Footer />
          </div>
        </div>
      ) : (
        <div id="page-shell" class="flex min-h-screen lg:flex-row">
          <div
            id="page-content"
            class="flex min-h-screen min-w-0 flex-1 flex-col"
          >
            <Header section={section} />
            <main id="main" tabindex="-1" class="flex-1">
              <slot />
            </main>
            <Footer />
          </div>
        </div>
      )
    }
    <ContactForm />
    <script src="@/lib/analytics.ts"></script>
  </body>

  <style is:global>
    /* Hidden until a keyboard reaches it, then the first thing on the page. */
    .skip-link {
      position: absolute;
      top: 8px;
      left: 8px;
      z-index: 100;
      padding: 7px 11px;
      border: 1px solid var(--ink);
      background: var(--paper);
      color: var(--ink);
      font-size: 10px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-decoration: none;
      transform: translateY(-160%);
    }
    .skip-link:focus-visible {
      transform: none;
    }
    #main:focus {
      outline: none;
    }
    .archive-shell {
      display: flex;
      align-items: flex-start;
      min-height: 100vh;
    }
    .archive-main {
      /* One page gutter for everything in the shell. Defined here rather than
         per page so sections rendered straight into the slot inherit it. */
      --gutter: 34px;
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    @media (min-width: 1300px) {
      .archive-main {
        --gutter: 52px;
      }
    }
    @media (max-width: 899px) {
      .archive-main {
        --gutter: 18px;
      }
    }
    .archive-bar {
      display: none;
    }
    .archive-scrim {
      display: none;
    }

    @media (max-width: 899px) {
      /* Keep anything you tab to clear of the sticky bar. */
      html {
        scroll-padding-top: 60px;
      }
      .archive-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 14px var(--gutter, 18px);
        border-bottom: 1px solid var(--rule);
        position: sticky;
        top: 0;
        background: var(--paper);
        z-index: 30;
      }
      .archive-bar .bar-me {
        color: var(--ink);
        text-decoration: none;
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }
      .archive-bar .bar-acts {
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .archive-bar .bar-link {
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--ink-2);
      }
      .archive-bar .bar-button {
        font: inherit;
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        background: none;
        border: 1px solid var(--ink);
        color: var(--ink);
        padding: 7px 11px;
        cursor: pointer;
      }
      /* :not([hidden]) matters — a bare display:block here would override the
         hidden attribute and cover the page. */
      .archive-scrim:not([hidden]) {
        display: block;
        position: fixed;
        inset: 0;
        background: color-mix(in srgb, var(--ink) 35%, transparent);
        border: 0;
        z-index: 50;
      }
    }
    /* Left to wrap, "Things to try" breaks after "to" and its underline sits
       under "try" alone. From 360px up there's room for every label on one
       line; only the name stacks. */
    @media (min-width: 360px) and (max-width: 899px) {
      .archive-bar .bar-link,
      .archive-bar .bar-button {
        white-space: nowrap;
      }
    }
  </style>

  <script>
    const open = document.getElementById("rail-open");
    const scrim = document.getElementById("archive-scrim");
    function setOpen(next: boolean) {
      document.body.classList.toggle("rail-open", next);
      if (scrim) scrim.hidden = !next;
    }
    open?.addEventListener("click", () => setOpen(true));
    scrim?.addEventListener("click", () => setOpen(false));
    document
      .getElementById("rail-close")
      ?.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  </script>
</html>
