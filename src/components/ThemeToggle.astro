---
// Pure-client theme toggle. No framework, no hydration cost. A page can hold
// several (the rail, the phone bar, the hobby header); they share one state.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle color theme"
  aria-pressed="false"
  class:list={["theme-toggle", className]}
>
  <span class="hidden dark:inline">Light</span>
  <span class="inline dark:hidden">Dark</span>
</button>

<script is:inline>
  (function () {
    if (window.__themeToggle) return;
    window.__themeToggle = true;
    var root = document.documentElement;
    function sync() {
      var isDark = root.classList.contains('dark');
      document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
        btn.setAttribute('aria-label', isDark ? 'Use light theme' : 'Use dark theme');
        btn.setAttribute('aria-pressed', String(isDark));
      });
      var meta = document.querySelector('meta[name="theme-color"]');
      var paper = getComputedStyle(root).getPropertyValue('--paper').trim();
      if (meta && paper) meta.setAttribute('content', paper);
    }
    function apply(nextDark) {
      root.classList.toggle('dark', nextDark);
      try {
        localStorage.setItem('theme', nextDark ? 'dark' : 'light');
      } catch {}
      sync();
    }
    document.addEventListener('click', function (event) {
      var btn = event.target.closest && event.target.closest('[data-theme-toggle]');
      if (!btn) return;
      var nextDark = !root.classList.contains('dark');
      var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // The page dims into the other theme instead of snapping.
      if (document.startViewTransition && !still) {
        document.startViewTransition(function () {
          apply(nextDark);
        });
      } else {
        apply(nextDark);
      }
    });
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', sync);
    } else {
      sync();
    }
  })();
</script>

<style>
  /* A quiet word, like the rail's links, not a widget. */
  .theme-toggle {
    font: inherit;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    background: none;
    border: 0;
    padding: 4px 0;
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--ink);
  }
</style>
