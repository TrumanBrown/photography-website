---
import { getCollection } from "astro:content";
import PlateArt from "@/components/PlateArt.astro";
import { sortHobbies, hobbySlug } from "@/lib/hobbies";

const hobbies = sortHobbies(await getCollection("hobbies"));

/** The verb on each card, so the link names the world rather than the widget. */
const VERBS: Record<string, string> = {
  "aquarium-keeping": "Plan a tank",
  "tide-pooling": "Walk the beach",
  fishing: "Open the maps",
  birding: "Make a bird",
  herping: "Take the wheel",
  hiking: "Build a trail",
};
---

{
  hobbies.length > 0 && (
    <section class="band" aria-labelledby="things-to-try">
      <div class="in">
        <div class="bhead">
          <h2 id="things-to-try">Things to try</h2>
          <span class="u-label">Six hobbies I actually do</span>
        </div>
        <div class="toyrow">
          {hobbies.map((entry) => {
            const slug = hobbySlug(entry);
            return (
              <a class="tcard" href={`/hobbies/${slug}/`}>
                <PlateArt slug={slug} size="mini" />
                <span class="tn">{entry.data.title}</span>
                <span class="tv">{VERBS[slug] ?? "Have a go"} →</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )
}

<style>
  /* A band at the foot of the overview, so the toys are findable without
     hunting for a nav link. One small plate per hobby, like a drawer of
     specimens; the plates stay at least about 125px wide so the drawings
     don't turn into grey smudges. */
  .band {
    border-top: 1px solid var(--rule);
    background: var(--band);
  }
  .in {
    padding: 34px var(--gutter) 40px;
  }
  .bhead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .bhead h2 {
    font-size: 19px;
    font-weight: 300;
    margin: 0;
  }
  .toyrow {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 26px 16px;
  }
  .tcard {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .tcard:hover {
    text-decoration: none;
  }
  .tcard:hover .tn {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .tn {
    display: block;
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.3;
    color: var(--ink);
  }
  .tv {
    display: block;
    margin-top: 3px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  @media (max-width: 1299px) {
    .toyrow {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 899px) {
    .in {
      padding-block: 26px 32px;
    }
  }
  @media (max-width: 599px) {
    .toyrow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 14px;
    }
  }
</style>
