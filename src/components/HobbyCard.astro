---
import type { CollectionEntry } from "astro:content";
import PlateArt from "@/components/PlateArt.astro";
import { hobbySlug } from "@/lib/hobbies";

interface Props {
  entry: CollectionEntry<"hobbies">;
}

const { entry } = Astro.props;
const slug = hobbySlug(entry);
const { title, summary, plateNote } = entry.data;
---

<a href={`/hobbies/${slug}/`} class="hcard" data-open="hobby">
  <PlateArt slug={slug} size="card" />
  <h2 class="t"><span class="draw">{title}</span></h2>
  {plateNote && <span class="m">{plateNote}</span>}
  <p class="d">{summary}</p>
</a>

<style>
  /* The same anatomy as a session card (a picture, a title, one tracked
     line), so the two halves of the site read as one. The picture is a
     stipple plate drawn from one of my photos. */
  .hcard {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .hcard:hover {
    text-decoration: none;
  }

  .t {
    margin: 11px 0 0;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--ink);
  }
  .m {
    display: block;
    margin-top: 2px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .d {
    margin: 6px 0 0;
    max-width: 44ch;
    font-size: 13px;
    line-height: 1.45;
    color: var(--ink-3);
  }
</style>
