---
import type { CollectionEntry } from "astro:content";
import { hobbySlug } from "@/lib/hobbies";

interface Props {
  entry: CollectionEntry<"hobbies">;
}

const { entry } = Astro.props;
const slug = hobbySlug(entry);
const { title, summary, emoji, iconSrc, interactive } = entry.data;
const cta = interactive ? "Play it" : "Explore";
---

<a href={`/hobbies/${slug}/`} class="hcard">
  <span class="mark" aria-hidden="true">
    {
      iconSrc ? (
        <img src={iconSrc} alt="" width="52" height="52" loading="lazy" />
      ) : (
        <span class="emoji">{emoji}</span>
      )
    }
  </span>
  <span class="body">
    <h2>{title}</h2>
    <p>{summary}</p>
    <span class="cta u-label">{cta} →</span>
  </span>
</a>

<style>
  /* Deliberately not a card: a rule, a mark and some type. The tinted icon
     tile and accent-coloured call to action this replaced were the most
     generic-looking thing on the site. */
  .hcard {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    height: 100%;
    padding: 18px 10px 20px 0;
    border-top: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
  }
  .hcard:hover {
    text-decoration: none;
  }
  .hcard:hover h2 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .mark {
    flex: none;
    width: 52px;
    height: 52px;
    display: block;
  }
  .mark .emoji {
    font-size: 34px;
    line-height: 52px;
    display: block;
    text-align: center;
  }

  .body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  h2 {
    font-size: 17px;
    font-weight: 400;
    margin: 0;
    line-height: 1.25;
  }
  p {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .cta {
    margin-top: 10px;
  }
</style>
