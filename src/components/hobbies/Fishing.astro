---
/**
 * Fishing hobby island: two pixel maps (Minnesota + Washington) of where the
 * author fishes. Both maps render side-by-side on desktop; on mobile a segmented
 * toggle switches between them. Tap a fish (a named water) to open its species
 * panel. The bottom "fish I've caught" gallery pairs each fish's map sprite with
 * the real catch photo, which the lightbox shows at full size. All behaviour
 * lives in @/lib/hobbies/fishing, bound via [data-fish-*] hooks; the mounting
 * script is an Astro module so it satisfies the CSP.
 */
import catchesJson from '@/lib/hobbies/fishing-catches.json';
import { FISH_BY_ID } from '@/lib/hobbies/fishing-species';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from '@/components/Lightbox.astro';

interface Catch {
  fishId: string;
  state: string;
  where: string;
  photo: string;
  /** The full-size original in Blob Storage (scripts/upload-fishing-catches.mjs). */
  full?: { src: string; width: number; height: number };
}

const catches: Catch[] = catchesJson.catches;

// A small copy of each catch photo lives in src/assets and goes through Astro's
// image pipeline for the thumbnail and the lightbox's quick preview; the
// responsive variants get offloaded to Blob by sync-variants.mjs in CI. The
// lightbox then ends on the full-size original, like the photography pages.
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/hobbies/fishing/*.jpg',
  { eager: true },
);
const photoBy: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(photoModules)) {
  const base = path
    .split('/')
    .pop()!
    .replace(/\.jpg$/, '');
  photoBy[base] = mod.default;
}

async function buildCard(c: Catch) {
  const f = FISH_BY_ID[c.fishId];
  const meta = photoBy[c.photo];
  const viewW = Math.min(1600, meta.width);
  const viewH = Math.round((viewW * meta.height) / meta.width);
  const [thumb, view] = await Promise.all([
    getImage({ src: meta, width: 700 }),
    getImage({ src: meta, width: viewW }),
  ]);
  return {
    fishId: c.fishId,
    name: f?.common ?? c.fishId,
    where: c.where,
    thumb: thumb.src,
    view: view.src,
    full: c.full?.src,
    // The lightbox is sized to the full original, so zooming isn't capped.
    w: c.full?.width ?? viewW,
    h: c.full?.height ?? viewH,
  };
}

const groups = [
  { label: 'Washington', cards: await Promise.all(catches.filter((c) => c.state === 'wa').map(buildCard)) },
  { label: 'Minnesota', cards: await Promise.all(catches.filter((c) => c.state === 'mn').map(buildCard)) },
];
---

<section data-fishing aria-label="Fishing map" class="not-prose">
  <div class="mb-4 md:hidden">
    <div class="utabs" role="radiogroup" aria-label="Choose a state" data-utabs>
      <button type="button" role="radio" aria-checked="true" data-fish-tab="mn" data-value="mn">Minnesota</button>
      <button type="button" role="radio" aria-checked="false" data-fish-tab="wa" data-value="wa">Washington</button>
      <span class="utabs-bar" aria-hidden="true"></span>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2 md:items-start">
    <div data-fish-map="mn" class="is-active space-y-3">
      <div>
        <div class="u-label mb-1">Minnesota</div>
        <div class="overflow-hidden border border-rule bg-[#e9eff0]">
          <canvas
            data-fish-canvas="mn"
            class="block w-full"
            style="image-rendering: pixelated"
            role="img"
            aria-label="Pixel map of Minnesota fishing waters. Tap a fish to see its species"></canvas>
        </div>
      </div>
      <div>
        <div class="u-label mb-1">Twin Cities metro</div>
        <div class="overflow-hidden border border-rule bg-[#e9eff0]">
          <canvas
            data-fish-canvas="metro"
            class="block w-full"
            style="image-rendering: pixelated"
            role="img"
            aria-label="Zoomed pixel map of the Twin Cities metro lakes"></canvas>
        </div>
      </div>
    </div>
    <div data-fish-map="wa">
      <div class="u-label mb-1">Washington</div>
      <div class="overflow-hidden border border-rule bg-[#e9eff0]">
        <canvas
          data-fish-canvas="wa"
          class="block w-full"
          style="image-rendering: pixelated"
          role="img"
          aria-label="Pixel map of Washington fishing waters. Tap a fish to see its species"></canvas>
      </div>
    </div>
  </div>
  <p class="mt-2 max-w-[72ch] text-xs leading-relaxed text-ink-2">
    Each fish marks a real lake or river. Tap one to see what swims there. The boxed Twin Cities area gets its
    own zoomed map, since that area is small and I spent most my time there.
  </p>

  <!-- species panel -->
  <div data-fish-panel class="fish-panel fixed inset-0 z-50 items-center justify-center p-4">
    <div class="fish-card w-full max-w-md p-5" role="dialog" aria-modal="true" aria-labelledby="fish-panel-title">
      <div class="min-w-0">
        <h3 id="fish-panel-title" data-fish-panel-title class="text-[17px] font-normal leading-tight"></h3>
        <p data-fish-panel-kind class="u-label mt-1"></p>
      </div>
      <div data-fish-panel-list class="mt-4 max-h-[60vh] space-y-3 overflow-y-auto"></div>
      <div class="mt-4 flex justify-end border-t border-rule pt-3">
        <button type="button" data-fish-panel-close class="btn">Back to the map</button>
      </div>
    </div>
  </div>

  <!-- personal catch gallery -->
  <section class="mt-12" aria-label="Fish I've caught">
    <div class="shead">
      <h2>Fish I've caught</h2>
    </div>
    <p class="shead-blurb">
      The real fish I've caught alongside their pixel counterparts. Tap a photo to take a closer look.
    </p>
    <div id="fishing-catches" class="mt-6 space-y-8">
      {
        groups.map((g) => (
          <div>
            <div class="u-label mb-3">
              {g.label}
            </div>
            <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
              {g.cards.map((card) => (
                <li class="overflow-hidden border border-rule">
                  <div class="flex items-center justify-center border-b border-rule bg-band py-2">
                    <canvas
                      data-fish-sprite={card.fishId}
                      width="84"
                      height="48"
                      style="image-rendering: pixelated; width: 84px; height: 48px"
                      aria-hidden="true"
                    />
                  </div>
                  <a
                    href={card.view}
                    data-pswp-full={card.full}
                    data-pswp-width={card.w}
                    data-pswp-height={card.h}
                    data-pswp-caption={`${card.name} · ${card.where}`}
                    class="group block no-underline"
                    aria-label={`Open photo: ${card.name}, ${card.where}`}
                  >
                    <img
                      src={card.thumb}
                      alt={`${card.name} caught at ${card.where}`}
                      loading="lazy"
                      class="block aspect-[4/3] w-full bg-band object-cover transition-opacity duration-300 group-hover:opacity-90"
                    />
                  </a>
                  <div class="p-2">
                    <div class="text-xs leading-tight text-ink">{card.name}</div>
                    <div class="mt-0.5 text-[11px] text-ink-2">{card.where}</div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <Lightbox gallerySelector="#fishing-catches" />
  </section>
</section>

<style>
  .fish-panel {
    display: none;
    background: color-mix(in srgb, var(--paper) 72%, transparent);
  }
  .fish-card {
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }
  .fish-panel.is-open {
    display: flex;
  }
  @media (max-width: 767px) {
    [data-fish-map] {
      display: none;
    }
    [data-fish-map].is-active {
      display: block;
    }
  }
</style>

<script>
  import { initFishing } from '@/lib/hobbies/fishing';
  import { initAllUnderlineTabs } from '@/lib/motion';

  initAllUnderlineTabs();

  const root = document.querySelector<HTMLElement>('[data-fishing]');
  if (root) initFishing(root);
</script>
