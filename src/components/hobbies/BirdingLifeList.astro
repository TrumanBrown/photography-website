---
/**
 * A live "life list" of a hobby's iNaturalist species — the richer personal
 * counterpart to the selfie-to-bird game. Server-renders only the container,
 * heading, link, and skeletons; the (CSP-safe, Astro-processed) script fetches
 * the public iNat API when the section scrolls into view, features the
 * globally-rarest species the author has logged, and lists the rest. Driven by
 * the `lifeList` block in the hobby content schema.
 */
interface Props {
  /** iNaturalist login or numeric user id. */
  userId: string;
  /** Link to the full observations page on iNaturalist. */
  url: string;
  heading?: string;
  blurb?: string;
  /** Optional iNat iconic taxa filter, e.g. "Aves". */
  iconicTaxa?: string;
  /** How many of the rarest species to feature with a blurb. */
  featured?: number;
}
const {
  userId,
  url,
  heading = "My life list",
  blurb,
  iconicTaxa,
  featured = 6,
} = Astro.props;
---

<section
  class="not-prose mt-12"
  aria-label={heading}
  data-life
  data-life-user={userId}
  data-life-iconic={iconicTaxa}
  data-life-featured={featured}
>
  <div class="mb-6">
    <div class="shead">
      <h2>{heading}</h2>
      <span data-life-count class="u-label tabular-nums"></span>
    </div>
    {blurb && <p class="shead-blurb">{blurb}</p>}
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="shead-link mt-2 inline-block"
      ><span class="draw">View all on iNaturalist</span> →</a
    >
  </div>

  <h3 class="u-label mb-3">Most unique sightings</h3>
  <div
    data-life-featured
    class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
  >
    {
      Array.from({ length: featured }).map(() => (
        <div class="overflow-hidden border border-rule">
          <div class="aspect-[4/3] animate-pulse bg-rule-soft" />
          <div class="space-y-2 p-4">
            <div class="h-4 w-2/3 animate-pulse bg-rule-soft" />
            <div class="h-3 w-full animate-pulse bg-rule-soft" />
            <div class="h-3 w-5/6 animate-pulse bg-rule-soft" />
          </div>
        </div>
      ))
    }
  </div>

  <h3 class="u-label mb-3 mt-10">The full list</h3>

  <div
    data-life-controls
    hidden
    class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center"
  >
    <label class="relative flex-1">
      <span class="sr-only">Search species</span>
      <input
        data-life-search
        type="search"
        placeholder="Search by name…"
        autocomplete="off"
        class="life-input w-full"
      />
    </label>
    <label class="flex items-center gap-2 text-sm text-ink-3">
      <span class="shrink-0">Sort</span>
      <select data-life-sort class="life-input">
        <option value="family">By family</option>
        <option value="recent">Recently seen</option>
        <option value="name">Name (A–Z)</option>
        <option value="genus">Genus (scientific)</option>
        <option value="most-seen">Most seen</option>
        <option value="rarest">Rarest first</option>
      </select>
    </label>
  </div>

  <div data-life-list class="space-y-6">
    {
      Array.from({ length: 2 }).map(() => (
        <section class="space-y-2">
          <div class="h-4 w-40 animate-pulse bg-rule-soft" />
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {Array.from({ length: 3 }).map(() => (
              <div class="flex items-center gap-3 border-b border-rule-soft py-2">
                <div class="h-16 w-16 shrink-0 animate-pulse bg-rule-soft" />
                <div class="flex-1 space-y-1.5">
                  <div class="h-3.5 w-1/2 animate-pulse bg-rule-soft" />
                  <div class="h-3 w-2/3 animate-pulse bg-rule-soft" />
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
  <p data-life-status class="mt-2 text-xs text-ink-2"></p>
</section>

<style>
  /*
   * Preflight is disabled (applyBaseStyles: false), so there is no base
   * [hidden]{display:none} rule, and the `flex` utility on the controls would
   * otherwise beat the UA stylesheet and show them before the data loads. Force
   * it here so [data-life-controls][hidden] stays hidden until JS reveals it.
   */
  [data-life] [hidden] {
    display: none !important;
  }

  .life-input {
    min-height: 36px;
    padding: 6px 10px;
    border: 1px solid var(--rule);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 13px;
  }
  .life-input::placeholder {
    color: var(--ink-2);
  }
  .life-input:focus-visible {
    border-color: var(--ink);
  }
  .life-input option {
    background: var(--paper);
    color: var(--ink);
  }
</style>

<script>
  import { initBirdingLifeList } from "@/lib/hobbies/birding-life-list";

  document
    .querySelectorAll<HTMLElement>("[data-life]")
    .forEach((el) => initBirdingLifeList(el));
</script>
