---
/**
 * My reptile and amphibian finds from iNaturalist on a real map, drawn in the
 * page's ink and paper: the world, the US and its states, or one state or
 * country with its finds listed below. Server-renders the shell, the filter
 * and the zoom buttons; the (CSP-safe, Astro-processed) script fetches the
 * public iNat API when the map scrolls near and shades the finds as a heat map.
 * The frame is the keyboard stop (role="application", the keys in its label).
 * Behaviour lives in @/lib/hobbies/inat-herp-map, bound via [data-herpmap-*].
 */
interface Props {
  userId: string;
  url: string;
  heading?: string;
  blurb?: string;
  limit?: number;
}
const {
  userId,
  url,
  heading = "My reptiles & amphibians, by state",
  blurb,
  limit = 200,
} = Astro.props;
---

<section
  class="not-prose mt-12"
  aria-label={heading}
  data-herpmap
  data-herpmap-user={userId}
  data-herpmap-limit={limit}
>
  <div class="mb-4">
    <div class="shead">
      <h2>{heading}</h2>
      <a href={url} target="_blank" rel="noopener noreferrer" class="shead-link"
        ><span class="draw">View all on iNaturalist</span> →</a
      >
    </div>
    {blurb && <p class="shead-blurb">{blurb}</p>}
  </div>

  <div class="mb-4 flex items-end justify-between gap-4">
    <div
      class="utabs"
      role="radiogroup"
      aria-label="Show"
      data-utabs
      data-herpmap-tabs
    >
      <button
        type="button"
        role="radio"
        aria-checked="true"
        data-herpmap-cls="all"
        data-value="all">All</button
      >
      <button
        type="button"
        role="radio"
        aria-checked="false"
        data-herpmap-cls="reptiles"
        data-value="reptiles">Reptiles</button
      >
      <button
        type="button"
        role="radio"
        aria-checked="false"
        data-herpmap-cls="amphibians"
        data-value="amphibians">Amphibians</button
      >
      <span class="utabs-bar" aria-hidden="true"></span>
    </div>
    <button type="button" data-herpmap-back class="linkbtn draw hidden"
      ><span>← Back</span></button
    >
  </div>

  <div class="relative">
    <div
      class="overflow-hidden border border-rule bg-paper"
      tabindex="0"
      role="application"
      aria-label="Map of my reptile and amphibian finds, shaded by how many I found in each spot. Tap a shaded spot to see what I found there. Arrow keys move the ring and the map under it, plus and minus zoom, Enter opens the place in the ring and Escape goes back out."
      data-herpmap-frame
    >
      <canvas
        data-herpmap-canvas
        class="block w-full"
        style="touch-action: pan-y"
        aria-hidden="true"></canvas>
    </div>
    <div
      data-herpmap-tip
      class="pointer-events-none absolute hidden -translate-x-1/2 -translate-y-full whitespace-nowrap border border-rule bg-paper px-2 py-1 text-[11px] text-ink"
    >
    </div>
    <div class="hm-zoom" role="group" aria-label="Zoom">
      <button
        type="button"
        class="btn"
        data-herpmap-zoom="in"
        aria-label="Zoom in">+</button
      >
      <button
        type="button"
        class="btn"
        data-herpmap-zoom="out"
        aria-label="Zoom out"
        disabled>&minus;</button
      >
    </div>
  </div>

  <p data-herpmap-status class="mt-2 text-xs text-ink-2">
    Loading my finds from iNaturalist...
  </p>
  <p class="sr-only" aria-live="polite" data-herpmap-live></p>
  <div data-herpmap-detail class="mt-4"></div>
</section>

<style>
  /* The site's square buttons, stacked in the map's corner on a sheet of
     paper so they read over the land, the same as Narrow nature's. */
  .hm-zoom {
    position: absolute;
    top: 8px;
    right: 8px;
    display: grid;
  }
  .hm-zoom .btn {
    width: 32px;
    height: 32px;
    min-height: 0;
    padding: 0;
    font-size: 18px;
    line-height: 1;
    background: color-mix(in srgb, var(--paper) 90%, transparent);
  }
  .hm-zoom .btn + .btn {
    border-top: 0;
  }
  .hm-zoom .btn:hover:not(:disabled) {
    background: var(--hover);
  }
  .hm-zoom .btn:disabled {
    opacity: 1;
    color: var(--ink-2);
    cursor: default;
  }
  @media (pointer: coarse) {
    .hm-zoom .btn {
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  import { initHerpMap } from "@/lib/hobbies/inat-herp-map";
  import { initAllUnderlineTabs } from "@/lib/motion";

  initAllUnderlineTabs();

  document
    .querySelectorAll<HTMLElement>("[data-herpmap]")
    .forEach((el) => initHerpMap(el));
</script>
