---
/**
 * A live US map of a user's iNaturalist reptile + amphibian observations,
 * bucketed by state. Server-renders the shell, toggle, and link; the (CSP-safe,
 * Astro-processed) script fetches the public iNat API when scrolled into view,
 * shades the state tiles by count, and fills the per-state thumbnail strip.
 * Behaviour lives in @/lib/hobbies/inat-herp-map, bound via [data-herpmap-*].
 */
interface Props {
  userId: string;
  url: string;
  heading?: string;
  blurb?: string;
  limit?: number;
}
const {
  userId,
  url,
  heading = "My reptiles & amphibians, by state",
  blurb,
  limit = 200,
} = Astro.props;
---

<section
  class="not-prose mt-12"
  aria-label={heading}
  data-herpmap
  data-herpmap-user={userId}
  data-herpmap-limit={limit}
>
  <div class="mb-4">
    <div class="shead">
      <h2>{heading}</h2>
      <a href={url} target="_blank" rel="noopener noreferrer" class="shead-link"
        ><span class="draw">View all on iNaturalist</span> →</a
      >
    </div>
    {blurb && <p class="shead-blurb">{blurb}</p>}
  </div>

  <div class="mb-4 flex items-end justify-between gap-4">
    <div
      class="utabs"
      role="radiogroup"
      aria-label="Show"
      data-utabs
      data-herpmap-tabs
    >
      <button
        type="button"
        role="radio"
        aria-checked="true"
        data-herpmap-cls="all"
        data-value="all">All</button
      >
      <button
        type="button"
        role="radio"
        aria-checked="false"
        data-herpmap-cls="reptiles"
        data-value="reptiles">Reptiles</button
      >
      <button
        type="button"
        role="radio"
        aria-checked="false"
        data-herpmap-cls="amphibians"
        data-value="amphibians">Amphibians</button
      >
      <span class="utabs-bar" aria-hidden="true"></span>
    </div>
    <button type="button" data-herpmap-back class="linkbtn draw hidden"
      ><span>← Back</span></button
    >
  </div>

  <div class="relative overflow-hidden border border-rule bg-[#0b1220]">
    <canvas
      data-herpmap-canvas
      class="block w-full"
      style="touch-action: pan-y"
      role="img"
      aria-label="A world map showing a heat map of my reptile and amphibian observations. Tap a highlighted country (or the US, then a state) to zoom in and see individual observation pins. Pinch, scroll, or use the buttons to zoom, and drag to pan."
    ></canvas>
    <div
      data-herpmap-tip
      class="pointer-events-none absolute hidden -translate-x-1/2 -translate-y-full bg-[#0b1220] px-2 py-1 text-[11px] text-white ring-1 ring-white/20"
    >
    </div>
    <div class="absolute right-2 top-2 flex flex-col gap-1">
      <button
        type="button"
        data-herpmap-zoom="in"
        aria-label="Zoom in"
        class="flex h-8 w-8 items-center justify-center border border-white/20 bg-[#0b1220]/80 text-lg leading-none text-white hover:bg-[#0b1220]"
        >+</button
      >
      <button
        type="button"
        data-herpmap-zoom="out"
        aria-label="Zoom out"
        class="flex h-8 w-8 items-center justify-center border border-white/20 bg-[#0b1220]/80 text-lg leading-none text-white hover:bg-[#0b1220]"
        >−</button
      >
      <button
        type="button"
        data-herpmap-zoom="reset"
        aria-label="Reset zoom"
        class="flex h-8 w-8 items-center justify-center border border-white/20 bg-[#0b1220]/80 text-xs leading-none text-white hover:bg-[#0b1220]"
        >⤢</button
      >
    </div>
  </div>

  <p data-herpmap-status class="mt-2 text-xs text-ink-2"></p>
  <p class="mt-1 text-[11px] text-ink-2">
    Pinch or scroll to zoom, drag to pan, or use the + / − buttons.
  </p>
  <div data-herpmap-detail class="mt-4"></div>
</section>

<script>
  import { initHerpMap } from "@/lib/hobbies/inat-herp-map";
  import { initAllUnderlineTabs } from "@/lib/motion";

  initAllUnderlineTabs();

  document
    .querySelectorAll<HTMLElement>("[data-herpmap]")
    .forEach((el) => initHerpMap(el));
</script>
