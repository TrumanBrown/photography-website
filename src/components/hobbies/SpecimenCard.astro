---
/**
 * The reveal card shared by the tide pool and herping toys: the photograph
 * across the top at 4:3, and under it a specimen label with the name, the
 * Latin name, one fact and the photo credit, with one button that stays in
 * the fiction. The engine fills it through the data-<prefix>-* hooks, opens
 * it by adding "is-open" to the [data-<prefix>-card] scrim, and hides the
 * photo or its stand-in with "is-hidden". The photo comes in through one of
 * the reveals in src/lib/hobbies/specimen-reveal.ts.
 */
interface Props {
  /** Hook prefix the engine queries: "tp" for tide pooling, "hp" for herping. */
  prefix: "tp" | "hp";
  /** The dismiss button ("Keep looking"). */
  closeLabel: string;
}

const { prefix, closeLabel } = Astro.props;
const hook = (name: string) => ({ [`data-${prefix}-${name}`]: "" });
const nameId = `${prefix}-specimen-name`;
---

<div class="specimen-scrim" {...hook("card")}>
  <div
    class="specimen"
    role="dialog"
    aria-modal="true"
    aria-labelledby={nameId}
  >
    <div class="specimen-pic">
      <canvas {...hook("reveal")} width="160" height="120" aria-hidden="true"
      ></canvas>
      {
        /* Not lazy: it has no src until a card opens, and it stays hidden
          until the photo loads (specimen-reveal.ts). Chrome never fetches a
          lazy image that isn't displayed. */
      }
      <img
        {...hook("photo")}
        alt=""
        width="1024"
        height="768"
        class="is-hidden"
        decoding="async"
      />
    </div>
    <div class="specimen-label">
      <div class="specimen-head">
        <div class="specimen-names">
          <p class="u-label specimen-status" {...hook("badge")}></p>
          <h3 id={nameId} {...hook("name")}></h3>
          <p class="specimen-sci" {...hook("sci")}></p>
        </div>
        <div class="specimen-mark" {...hook("mark")}></div>
      </div>
      <p class="specimen-fact" {...hook("fact")}></p>
      <div class="specimen-foot">
        <p class="specimen-credit is-hidden" {...hook("credit")}></p>
        <button type="button" class="btn" {...hook("close")}
          >{closeLabel}</button
        >
      </div>
    </div>
  </div>
</div>

<style>
  /* The card is centred with margin: auto rather than align-items, so on a
     short screen it scrolls inside the scrim instead of losing its top. */
  .specimen-scrim {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: none;
    overflow-y: auto;
    padding: 16px;
    background: color-mix(in srgb, var(--paper) 72%, transparent);
  }
  .specimen-scrim.is-open {
    display: flex;
  }
  .specimen {
    width: 100%;
    max-width: 600px;
    margin: auto;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }
  /* The animal is the point of the card, so its photograph takes the full
     width. Capped on short screens so the label still fits beside it. */
  .specimen-pic {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: min(450px, 56dvh);
    overflow: hidden;
    border-bottom: 1px solid var(--ink);
    background: var(--band);
  }
  .specimen-pic canvas,
  .specimen-pic img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .specimen-pic img {
    object-fit: cover;
  }
  .specimen-label {
    padding: 16px 20px 18px;
  }
  /* The names on the left and a first find's stamp on the right, on the
     paper under the photo, so the stamp never covers the animal. */
  .specimen-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 16px;
  }
  .specimen-status {
    margin: 0 0 6px;
  }
  .specimen-status.is-warn {
    color: var(--ink);
  }
  /* A first find is stamped beside the names (src/lib/hobbies/specimen.ts);
     the plain label stays for screen readers. */
  .specimen-status.is-stamped {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .specimen-names h3 {
    margin: 0;
    font-size: 21px;
    font-weight: 300;
    line-height: 1.2;
  }
  .specimen-sci {
    margin: 2px 0 0;
    font-size: 13px;
    font-style: italic;
    color: var(--ink-3);
  }
  .specimen-mark {
    display: flex;
  }
  .specimen-mark :global(.specimen-stamp) {
    position: relative;
    top: auto;
    right: auto;
    transform-origin: 50% 50%;
  }
  .specimen-mark :global(.specimen-stamp > i) {
    letter-spacing: 0.14em;
  }
  .specimen-fact {
    margin: 12px 0 0;
    font-size: 15px;
    line-height: 1.55;
  }
  .specimen-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 14px;
  }
  .specimen-credit {
    margin: 0;
    max-width: 40ch;
    font-size: 11px;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .specimen-foot .btn {
    flex: none;
    min-height: 44px;
    margin-left: auto;
    padding-inline: 18px;
    border-color: var(--ink);
  }
  /* Astro scopes with attribute selectors, so `.specimen-pic img` outranks a
     plain class. Without !important the photo shows before its reveal lands. */
  .is-hidden {
    display: none !important;
  }

  @media (max-width: 520px) {
    .specimen-label {
      padding: 14px 16px 16px;
    }
    .specimen-names h3 {
      font-size: 19px;
    }
    .specimen-fact {
      font-size: 14px;
    }
    .specimen-foot {
      flex-direction: column;
      align-items: stretch;
    }
    .specimen-foot .btn {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
