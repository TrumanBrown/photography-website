---
/**
 * Herping "night drive" game. Static markup + the reveal card; all behaviour
 * (the roadside drawn by the headlights, eyeshine, the stippled animals, the
 * journal) lives in @/lib/hobbies/herping, bound via the [data-hp-*] hooks.
 * The mounting script is an Astro-processed module (served from /_astro/), so
 * it satisfies the strict `script-src 'self'` CSP.
 */
import FieldJournal from "@/components/hobbies/FieldJournal.astro";
import SpecimenCard from "@/components/hobbies/SpecimenCard.astro";
import { SPECIES } from "@/lib/hobbies/herping-species";
---

<section data-herping aria-label="Herping night drive game" class="not-prose">
  <FieldJournal prefix="hp" total={SPECIES.length} resetLabel="New road" />

  <div
    class="hp-frame"
    data-hp-frame
    tabindex="0"
    role="application"
    aria-label="A forest road at night, drawn only where your headlights reach. Steer the beam over the ferns and the road, watch for the eyeshine of animals crossing, then tap a lit one to identify it. Arrow keys steer, Enter stops for whatever's in the beam."
  >
    <canvas data-hp-canvas class="block w-full touch-none" aria-hidden="true"
    ></canvas>
  </div>
  <p class="sr-only" aria-live="polite" data-hp-live></p>
  <p class="hp-note">
    Steer with the mouse, by dragging on touch, or with the arrow keys, then tap
    an animal in the beam or press Enter to stop for it. Please never handle
    real salamanders with bug-sprayed or lotioned hands, and put any cover you
    flip back the way you found it.
  </p>

  <SpecimenCard prefix="hp" closeLabel="Keep driving" />
</section>

<style>
  .hp-frame {
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--paper);
    cursor: crosshair;
  }
  .hp-note {
    margin: 8px 0 0;
    max-width: 72ch;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
  }
</style>

<script>
  import { initHerping } from "@/lib/hobbies/herping";

  const root = document.querySelector<HTMLElement>("[data-herping]");
  if (root) initHerping(root);
</script>
