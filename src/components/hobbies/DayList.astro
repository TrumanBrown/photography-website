---
/**
 * Narrow nature, a daily puzzle built on iNaturalist records, as one pixel
 * world that fills the screen (mock D, "Pixel lens", picked 2026-11-24).
 *
 * Six species were all recorded at one place in one month. The world map
 * fills the screen at a quarter of its resolution, in a day palette and a
 * night one, and everything written over it sits on a solid navy panel. Each
 * species draws a ring round the pin of how far from the place half its
 * sightings are, in a colour picked from its photo. Showing the next one
 * costs points, and the most you can still score sits top right.
 *
 * Its own look, unlike the rest of the site (site-design.instructions.md):
 * Jersey pixel type, navy panels with hard drops, keys that press, no site
 * header or footer (BaseLayout's "game" section).
 *
 * Behaviour lives in @/lib/hobbies/day-list, bound via [data-daylist-*]; the
 * pixel drawing in ./day-list-pixel and the ring colours in ./day-list-tints.
 * Photos load from the iNaturalist CDN already allow-listed in the CSP.
 */
interface Props {
  /** The page's name, which the title panel carries as its h1. */
  title?: string;
  heading?: string;
}
const { title = "Narrow nature", heading = "Today's list" } = Astro.props;

const MONTHS = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];
---

<div class="dl" data-daylist>
  {
    /* Three layers in reading order: the title and the score over the map,
       the map, then the hand and the guess over it. */
  }
  <div class="dl-ui">
    <header class="dl-title dl-panel">
      <a class="dl-key dl-key-small dl-back" href="/hobbies/"
        ><span aria-hidden="true">←</span>
        <span class="dl-back-word">Things to try</span></a
      >
      <div class="dl-trow">
        <h1 class="dl-px25">{title}</h1>
        <button
          type="button"
          class="dl-key dl-key-small dl-howkey"
          data-daylist-how
          aria-expanded="false"
          aria-controls="dl-how">How to play</button
        >
      </div>
      <p class="dl-rule dl-px25">
        <span class="dl-r-a">6 species <i>·</i> 1 place <i>·</i> 1 month</span>
        <i class="dl-r-mid">·</i>
        <span class="dl-r-b">each one narrows the map</span>
      </p>
      <div class="dl-modes-row">
        <div
          class="dl-modes"
          role="radiogroup"
          aria-label="Which list"
          data-daylist-modes
        >
          <button
            type="button"
            role="radio"
            aria-checked="true"
            class="dl-key dl-tab"
            data-value="daily">{heading}</button
          >
          <button
            type="button"
            role="radio"
            aria-checked="false"
            class="dl-key dl-tab"
            data-value="extra">More lists</button
          >
        </div>
        <p class="dl-date dl-px15" data-daylist-meta></p>
      </div>
    </header>

    <div class="dl-how dl-panel" id="dl-how" data-daylist-howpanel hidden>
      <ol class="dl-how-steps">
        <li>
          <span class="dl-how-art dl-art-card" aria-hidden="true"
            ><i class="dl-hc-back"></i><i class="dl-hc-face"></i></span
          >
          <b class="dl-px15">Turn a card</b>
        </li>
        <li>
          <span class="dl-how-art dl-art-ring" aria-hidden="true"
            ><canvas data-daylist-howring width="40" height="24"></canvas></span
          >
          <b class="dl-px15">Rings close in</b>
        </li>
        <li>
          <span class="dl-how-art dl-art-pts" aria-hidden="true"
            ><i class="dl-hn-num dl-px25"
              ><s>6,000</s><s>5,400</s><s>4,800</s></i
            ></span
          >
          <b class="dl-px15">Fewer cards, more points</b>
        </li>
      </ol>
      <p class="dl-how-note">
        Each species draws a ring round your pin. Half its sightings are that
        close to the spot. Any place in a species' name stays hidden until you
        guess. Pick the month too, then lock it in. You get one guess, and a pin
        anywhere inside the place counts as spot on. Today's list is the same
        for everyone. More lists gives you ten others a day.
      </p>
      <button type="button" class="dl-key dl-key-small" data-daylist-how-close
        >Back to the map</button
      >
    </div>

    <div class="dl-stakes dl-panel" data-daylist-stakes>
      <span class="dl-s-up dl-px15" data-daylist-stakes-up>Up to</span>
      <span class="dl-s-num dl-px25" data-daylist-worth>6,000</span>
      <span class="dl-s-unit dl-px15">points</span>
    </div>

    <div class="dl-read dl-panel" data-daylist-reach-readout aria-hidden="true">
      <span class="dl-r-head dl-px15">Half its sightings</span>
      <span class="dl-r-line dl-px25"
        ><span class="dl-r-w">within</span>
        <b data-daylist-reach>?</b>
        <span class="dl-r-km">km</span></span
      >
    </div>
  </div>

  <div
    class="dl-map"
    data-daylist-mapwrap
    tabindex="0"
    role="application"
    aria-label="World map. Each species draws a ring round your pin, as far as half its sightings are from the spot. Tap where you think the six were seen. Arrow keys move the pin, plus and minus zoom."
  >
    <canvas data-daylist-map></canvas>
    <div class="dl-labels" data-daylist-labels aria-hidden="true"></div>
  </div>

  <div class="dl-ui">
    <div class="dl-zoom" role="group" aria-label="Zoom">
      <button
        type="button"
        class="dl-key dl-key-small dl-viewkey"
        data-daylist-view
        hidden>Whole world</button
      >
      <button
        type="button"
        class="dl-key dl-zkey"
        data-daylist-zoom="in"
        aria-label="Zoom in">+</button
      >
      <button
        type="button"
        class="dl-key dl-zkey"
        data-daylist-zoom="out"
        aria-label="Zoom out">&minus;</button
      >
    </div>

    <section class="dl-hand" aria-labelledby="dl-board-title" data-daylist-hand>
      <h2 class="dl-sr" id="dl-board-title" data-daylist-title>{heading}</h2>
      {
        /* A phone's cards are photos only: the one picked (the newest, or the
          last tapped) is named here. Screen readers get each card's name. */
      }
      <p class="dl-pick dl-panel" data-daylist-pick aria-hidden="true"></p>
      <ol
        class="dl-tray"
        aria-label="The six species, most widespread first"
        data-daylist-clues
      >
      </ol>
    </section>

    <div class="dl-guess" data-daylist-guess>
      <div
        class="dl-months"
        role="radiogroup"
        aria-label="Which month?"
        data-daylist-months
      >
        {
          MONTHS.map((name, i) => (
            <button
              type="button"
              class="dl-key"
              role="radio"
              aria-checked="false"
              aria-label={name}
              tabindex={i === 0 ? 0 : -1}
              data-daylist-month={i}
            >
              {name.slice(0, 3)}
            </button>
          ))
        }
      </div>
      <button
        type="button"
        class="dl-key dl-key-lock dl-key-amber"
        data-daylist-lock
        disabled
      >
        <span class="dl-lock-word">Lock it in</span>
        <small data-daylist-hint>Tap the map, pick a month</small>
      </button>
    </div>

    <section
      class="dl-post"
      data-daylist-result
      hidden
      aria-labelledby="dl-post-place"
    >
    </section>
  </div>

  <dialog class="dl-sheet" data-daylist-sheet aria-labelledby="dl-sheet-title">
    <div class="dl-sheet-head">
      <h2 class="dl-px25" id="dl-sheet-title">The full list</h2>
      <button type="button" class="dl-key dl-key-small" data-daylist-sheet-close
        >Back to the map</button
      >
    </div>
    <div class="dl-sheet-body">
      <ol class="dl-entries" data-daylist-roll></ol>
      <p class="dl-sheet-foot">
        Every species on a list was logged at that place in that month. The
        distance on each card is how far from the place half its sightings were
        logged, and sightings follow where people go looking as much as where
        the animal lives. Data from iNaturalist, terrain and borders from
        Natural Earth.
      </p>
      <details class="dl-credits" data-daylist-credits>
        <summary>Photo credits</summary>
        <ol class="dl-credits-list" data-daylist-credit-list></ol>
      </details>
    </div>
  </dialog>

  <p class="dl-sr" aria-live="polite" data-daylist-announce></p>
</div>

<script>
  import { initDayList } from "@/lib/hobbies/day-list";

  document
    .querySelectorAll<HTMLElement>("[data-daylist]")
    .forEach((el) => initDayList(el));
</script>

<style is:global>
  /* Global rather than scoped, and namespaced under .dl so nothing leaks:
     the cards, the labels on the map, the postcard and the full list are
     built by the script at runtime, and Astro's scoped styles only reach
     markup present at build time.

     Mock D's look, which breaks the house style on purpose (picked
     2026-11-24): a day and a night palette of its own, Jersey pixel type,
     solid navy panels with hard drops behind everything over the map, and
     keys that press. */

  /* Jersey 15 and 25 (OFL, public/fonts/OFL-jersey.txt), the title screen's
     pixel faces. Only .dl uses them, so no other page downloads them. */
  @font-face {
    font-family: "Jersey 25";
    src: url("/fonts/jersey-25.woff2") format("woff2");
    font-display: block;
  }
  @font-face {
    font-family: "Jersey 15";
    src: url("/fonts/jersey-15.woff2") format("woff2");
    font-display: block;
  }

  .dl {
    --slate: #122a5b;
    --rim: #2d4f8f;
    --drop: #0a1838;
    --snow: #f5f8fc;
    --dim: #b9c9de;
    --amber: #ffb000;
    --amber-hi: #ffd35c;
    --amber-lo: #c77f00;
    --red: #d8402c;
    --sea: #3f7fcf;
    --key: #f5f8fc;
    --key-hi: #ffffff;
    --key-lo: #b9c9de;
    --card-paper: #f5f8fc;
    --card-ink: #122a5b;
    --card-ink-2: #2d4f8f;
    --c1: #5577e0;
    --c2: #24a9b5;
    --c3: #4fae3c;
    --c4: #e9b21b;
    --c5: #ef7f22;
    --c6: #dd3f37;
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    /* The hand, the months and the postcard are drawn for a 1440 x 900
       screen and grow with a bigger one, so a big laptop screen shows them
       the same share of the screen (--hud-b, one of their pixels). */
    --hud-b: clamp(1px, min(calc(100vw / 1440), calc(100vh / 900)), 1.6px);
    --b: 1px;
    /* Six cards in a row beside the months: the hand starts 18px in, with
       five 14px gaps, then a 22px gap and the 372px months 18px from the
       right edge. They're as tall as the band under the map allows and
       take any spare width, up to 1.25 times as wide as tall, as a wider
       photo, so the cards never cover more of the map's southern edge. */
    --card-w: clamp(
      84px,
      calc((100vw - 500 * var(--hud-b)) / 6),
      calc(164 * var(--hud-b))
    );
    --card-hd: calc(205 * var(--hud-b));
    --edge: 15px;
  }
  html.dark .dl {
    --slate: #071230;
    --rim: #1f3a72;
    --drop: #030918;
    --snow: #e9eff8;
    --dim: #8fa3c4;
    --sea: #10224a;
    --key: #2a3f6e;
    --key-hi: #3d5690;
    --key-lo: #16264a;
    --card-paper: #dfe7f3;
    --amber-lo: #b06f00;
    --red: #f0604a;
    --c1: #6f8cf0;
    --c2: #2fc0c9;
    --c3: #62c44c;
    --c4: #f2c230;
    --c5: #f59238;
    --c6: #f0584f;
  }

  /* The game is the page: no scroll either way, and the sea behind it. */
  html:has(.dl),
  html:has(.dl) body {
    overflow: hidden;
    overscroll-behavior: none;
  }
  html:has(.dl) {
    background: #3f7fcf;
  }
  html.dark:has(.dl) {
    background: #10224a;
  }
  html:has(.dl) body {
    background: transparent;
  }

  .dl {
    position: fixed;
    inset: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--sea);
    color: var(--snow);
    font-family: "Libre Franklin", ui-sans-serif, system-ui, sans-serif;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    text-wrap-style: pretty;
  }
  .dl *,
  .dl *::before,
  .dl *::after {
    box-sizing: border-box;
  }
  .dl [hidden] {
    display: none !important;
  }
  .dl :focus-visible {
    outline: 3px solid var(--amber);
    outline-offset: 3px;
    border-radius: 0;
  }
  .dl :focus-visible:not(.dl-key) {
    box-shadow: none;
  }
  .dl-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Pixel type ---------- */

  .dl-px25,
  .dl-px15 {
    font-weight: 400;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
    -webkit-font-smoothing: none;
  }
  .dl-px25 {
    font-family: "Jersey 25", ui-sans-serif, sans-serif;
  }
  .dl-px15 {
    font-family: "Jersey 15", ui-sans-serif, sans-serif;
  }

  /* A solid pixel panel: slate, a lit rim, a hard drop. Everything written
     over the map sits on one, so the land never shows through small type. */
  .dl-panel {
    background: var(--slate);
    color: var(--snow);
    box-shadow:
      inset 0 0 0 3px var(--rim),
      0 0 0 3px var(--drop),
      6px 6px 0 3px var(--drop);
  }

  /* ---------- The scene ---------- */

  .dl-map {
    position: absolute;
    left: 0;
    top: 0;
    cursor: crosshair;
    touch-action: pan-y;
    outline: none;
  }
  .dl-map.is-zoomed {
    cursor: grab;
  }
  .dl-map.is-panning {
    cursor: grabbing;
  }
  .dl.is-done .dl-map:not(.is-zoomed) {
    cursor: default;
  }
  .dl-map:focus-visible {
    outline: none;
  }
  .dl-map:focus-visible::after {
    content: "";
    position: absolute;
    inset: 3px;
    border: 3px solid var(--amber);
    pointer-events: none;
  }
  .dl-map canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    image-rendering: pixelated;
  }
  .dl-ui {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .dl-ui > * {
    pointer-events: auto;
  }

  /* What the map puts down: each ring's km, the place's name, its
     coordinates. */
  .dl-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .dl-place {
    position: absolute;
    left: 0;
    top: 0;
    padding: 3px 8px 5px;
    font-size: 24px;
    line-height: 1;
    white-space: nowrap;
    background: var(--slate);
    color: var(--snow);
    box-shadow:
      0 0 0 3px var(--red),
      4px 4px 0 3px var(--drop);
  }
  .dl-rk,
  .dl-rh {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    height: 24px;
    padding: 0 7px;
    font-size: 18px;
    line-height: 23px;
    white-space: nowrap;
    background: var(--slate);
    color: var(--snow);
    box-shadow:
      0 0 0 2px var(--drop),
      3px 3px 0 2px var(--drop);
  }
  .dl-rk.is-hot {
    background: var(--drop);
    box-shadow:
      0 0 0 2px currentColor,
      3px 3px 0 2px var(--drop);
  }
  .dl-coords {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    padding: 2px 8px 4px;
    font-size: 22px;
    line-height: 1;
    white-space: nowrap;
    color: #ff7a5c;
    background: var(--slate);
    box-shadow:
      0 0 0 2px var(--drop),
      3px 3px 0 2px var(--drop);
  }
  .dl-coords .dl-c-off {
    color: transparent;
  }
  /* A photo flying from its card to its ring, in whole map pixels. */
  .dl-fly {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 30;
    image-rendering: pixelated;
    pointer-events: none;
  }

  /* The verdict, dropped in from the top edge once the map has shown the
     answer. */
  .dl-banner {
    position: absolute;
    z-index: 5;
    left: calc(var(--edge) + 3px);
    top: 0;
    display: grid;
    justify-items: start;
    gap: 4px;
    padding: 22px 22px 12px;
    background: var(--amber);
    color: var(--slate);
    white-space: nowrap;
    box-shadow:
      inset 0 -4px 0 var(--amber-lo),
      0 0 0 3px var(--drop),
      6px 6px 0 3px var(--drop);
  }
  html.dark .dl-banner {
    color: #071230;
  }
  .dl-banner b {
    font-size: 41px;
    line-height: 0.85;
    font-weight: 400;
  }
  .dl-banner span {
    font-size: 22px;
    line-height: 1;
  }

  /* ---------- The title panel ---------- */

  .dl-title {
    position: absolute;
    left: var(--edge);
    top: var(--edge);
    display: grid;
    justify-items: start;
    padding: 10px 16px 12px;
    transition: translate 220ms var(--ease-out);
  }
  .dl-trow {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 10px;
  }
  .dl-title h1 {
    margin: 0;
    font-size: 58px;
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: 0;
    white-space: nowrap;
    color: var(--snow);
    text-shadow: 3px 3px 0 var(--drop);
  }
  .dl-rule {
    margin: 9px 0 0 2px;
    font-size: 21px;
    line-height: 1;
    white-space: nowrap;
    color: var(--snow);
  }
  .dl-rule i {
    font-style: normal;
    color: var(--amber);
    padding: 0 2px;
  }
  .dl-modes-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 12px;
  }
  .dl-modes {
    display: flex;
    gap: 10px;
  }
  /* The tabs press like keys; the underline the shared tabs slide along has
     no place here. */
  .dl-modes > .utabs-bar {
    display: none;
  }
  .dl-date {
    margin: 0 0 4px;
    font-size: 19px;
    line-height: 1;
    white-space: nowrap;
    color: var(--dim);
  }
  .dl.is-done .dl-title {
    translate: 0 calc(-100% - 40px);
    visibility: hidden;
    transition:
      translate 220ms var(--ease-out),
      visibility 0s linear 220ms;
  }

  /* ---------- Keys ---------- */
  /* A square key with a dark outline, a lit top edge and a hard drop under
     it. Pressed, it sits 4px down on its own drop. */
  .dl-key {
    --k-face: var(--key);
    --k-hi: var(--key-hi);
    --k-lo: var(--key-lo);
    --k-ink: var(--drop);
    --k-drop: calc(4 * var(--b));
    --k-text: var(--slate);
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(6 * var(--b));
    margin: 0 0 var(--k-drop);
    padding: 0 calc(12 * var(--b));
    border: 0;
    border-radius: 0;
    background: var(--k-face);
    color: var(--k-text);
    font-family: "Jersey 15", ui-sans-serif, sans-serif;
    font-size: calc(24 * var(--b));
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    box-shadow:
      inset 0 calc(3 * var(--b)) 0 var(--k-hi),
      inset 0 calc(-3 * var(--b)) 0 var(--k-lo),
      0 0 0 calc(3 * var(--b)) var(--k-ink),
      0 calc(var(--k-drop) + 3 * var(--b)) 0 0 var(--k-ink);
    transition:
      transform 60ms var(--ease-out),
      box-shadow 60ms var(--ease-out);
    -webkit-font-smoothing: none;
  }
  a.dl-key:hover {
    text-decoration: none;
  }
  html.dark .dl-key {
    --k-text: var(--snow);
  }
  .dl-key:focus-visible {
    outline: calc(3 * var(--b)) solid var(--amber);
    outline-offset: calc(5 * var(--b));
  }
  .dl-key.is-down,
  .dl-key[aria-checked="true"] {
    transform: translateY(var(--k-drop));
    box-shadow:
      inset 0 calc(3 * var(--b)) 0 var(--k-lo),
      inset 0 calc(-3 * var(--b)) 0 var(--k-hi),
      0 0 0 calc(3 * var(--b)) var(--k-ink),
      0 calc(3 * var(--b)) 0 0 var(--k-ink);
  }
  .dl-key:disabled {
    cursor: default;
  }
  .dl-key-amber,
  html.dark .dl-key-amber,
  .dl-key[aria-expanded="true"],
  .dl-key[aria-checked="true"],
  html.dark .dl-key[aria-checked="true"] {
    --k-face: var(--amber);
    --k-hi: var(--amber-hi);
    --k-lo: var(--amber-lo);
    --k-text: var(--slate);
  }
  html.dark .dl-key-amber,
  html.dark .dl-key[aria-checked="true"],
  html.dark .dl-key[aria-expanded="true"] {
    --k-text: #071230;
  }
  .dl-key-small {
    height: 30px;
    padding: 0 11px 2px;
    font-size: 21px;
    white-space: nowrap;
  }
  .dl-back {
    height: 26px;
    padding: 0 9px 2px;
    font-size: 19px;
  }
  .dl-tab {
    height: 30px;
    padding: 0 11px 2px;
    font-size: 20px;
    white-space: nowrap;
  }
  .dl-zkey {
    width: 42px;
    height: 38px;
    padding: 0 0 3px;
    font-family: "Jersey 25", ui-sans-serif, sans-serif;
    font-size: 41px;
  }
  .dl-zkey:disabled {
    --k-text: var(--dim);
  }
  /* Thumb room on touch screens without moving the layout. */
  @media (pointer: coarse) {
    .dl-key::after {
      content: "";
      position: absolute;
      inset: -6px -3px;
    }
  }

  /* ---------- How to play ---------- */

  .dl-how {
    position: absolute;
    left: var(--edge);
    top: 230px;
    z-index: 6;
    width: 540px;
    padding: 16px 16px 14px;
  }
  .dl-how-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .dl-how-steps li {
    display: grid;
    gap: 8px;
    justify-items: center;
    text-align: center;
  }
  .dl-how-steps b {
    font-weight: 400;
    font-size: 22px;
    line-height: 1;
    color: var(--snow);
  }
  .dl-how-note {
    margin: 14px 2px 12px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--dim);
  }
  .dl-how-art {
    position: relative;
    display: block;
    width: 100%;
    height: 96px;
    background: var(--sea);
    box-shadow: inset 0 0 0 3px var(--drop);
    overflow: hidden;
    image-rendering: pixelated;
  }
  /* A card turning: its "?" back folds away and its face comes round. */
  .dl-art-card i {
    position: absolute;
    left: 50%;
    top: 14px;
    width: 48px;
    height: 66px;
    margin-left: -24px;
    box-shadow: 0 0 0 3px var(--drop);
  }
  .dl-hc-back {
    background:
      linear-gradient(var(--c3), var(--c3)) 50% 26px / 6px 6px no-repeat,
      linear-gradient(var(--c3), var(--c3)) 50% 40px / 6px 6px no-repeat,
      linear-gradient(var(--c3), var(--c3)) 50% 14px / 18px 6px no-repeat,
      linear-gradient(var(--c3), var(--c3)) 30px 20px / 6px 12px no-repeat,
      var(--slate);
    animation: dl-hc-back 2400ms steps(1, end) infinite;
  }
  .dl-hc-face {
    background:
      linear-gradient(var(--slate), var(--slate)) 50% 52px / 36px 6px no-repeat,
      linear-gradient(#8a6a4a, #8a6a4a) 16px 18px / 18px 12px no-repeat,
      linear-gradient(#cfd98a, #cfd98a) 6px 6px / 36px 36px no-repeat,
      var(--c3);
    transform: scaleX(0);
    animation: dl-hc-face 2400ms steps(1, end) infinite;
  }
  @keyframes dl-hc-back {
    0%,
    30% {
      transform: scaleX(1);
    }
    33% {
      transform: scaleX(0.66);
    }
    36% {
      transform: scaleX(0.33);
    }
    39%,
    100% {
      transform: scaleX(0);
    }
  }
  @keyframes dl-hc-face {
    0%,
    38.9% {
      transform: scaleX(0);
    }
    39% {
      transform: scaleX(0.33);
    }
    42% {
      transform: scaleX(0.66);
    }
    45% {
      transform: scaleX(1.12);
    }
    48%,
    100% {
      transform: scaleX(1);
    }
  }
  /* A ring tightening round a pin, drawn in the map's own pixels. */
  .dl-art-ring {
    display: grid;
    place-items: center;
  }
  .dl-art-ring canvas {
    display: block;
    image-rendering: pixelated;
  }
  /* Points ticking down as cards turn. */
  .dl-art-pts {
    display: grid;
    place-items: center;
  }
  .dl-hn-num {
    position: relative;
    display: block;
    height: 44px;
    width: 100%;
    overflow: hidden;
    font-style: normal;
  }
  .dl-hn-num s {
    position: absolute;
    inset: 0;
    text-decoration: none;
    text-align: center;
    font-size: 50px;
    line-height: 44px;
    color: var(--amber);
    text-shadow: 3px 3px 0 var(--drop);
    opacity: 0;
  }
  .dl-hn-num s:nth-child(1) {
    animation: dl-hn1 2400ms steps(1, end) infinite;
  }
  .dl-hn-num s:nth-child(2) {
    animation: dl-hn2 2400ms steps(1, end) infinite;
  }
  .dl-hn-num s:nth-child(3) {
    animation: dl-hn3 2400ms steps(1, end) infinite;
  }
  @keyframes dl-hn1 {
    0%,
    33% {
      opacity: 1;
      transform: none;
    }
    34%,
    100% {
      opacity: 0;
    }
  }
  @keyframes dl-hn2 {
    0%,
    33% {
      opacity: 0;
    }
    34% {
      opacity: 1;
      transform: translateY(-6px);
    }
    37%,
    66% {
      opacity: 1;
      transform: none;
    }
    67%,
    100% {
      opacity: 0;
    }
  }
  @keyframes dl-hn3 {
    0%,
    66% {
      opacity: 0;
    }
    67% {
      opacity: 1;
      transform: translateY(-6px);
    }
    70%,
    100% {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Stakes, the newest reach, zoom ---------- */

  .dl-stakes {
    position: absolute;
    right: var(--edge);
    top: var(--edge);
    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 12px;
    padding: 10px 16px 10px;
    pointer-events: none;
  }
  .dl-s-up,
  .dl-s-unit {
    grid-column: 1;
    font-size: 22px;
    line-height: 1;
    color: var(--dim);
    text-align: right;
    white-space: nowrap;
  }
  .dl-s-up {
    align-self: end;
  }
  .dl-s-unit {
    align-self: start;
  }
  .dl-s-num {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: block;
    min-width: 4.6ch;
    font-size: 72px;
    line-height: 0.8;
    font-weight: 400;
    text-align: right;
    color: var(--amber);
    text-shadow: 3px 3px 0 var(--drop);
  }

  /* The newest ring's reach, a slim strip under the score. */
  .dl-read {
    position: absolute;
    right: var(--edge);
    top: 108px;
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 6px 14px 8px;
    pointer-events: none;
    transition:
      translate 260ms var(--ease-out),
      opacity 200ms linear;
  }
  .dl-r-head {
    font-size: 19px;
    line-height: 1;
    color: var(--dim);
    white-space: nowrap;
  }
  .dl-r-line {
    font-size: 30px;
    line-height: 0.85;
    white-space: nowrap;
    color: var(--snow);
  }
  .dl-r-line b {
    font-weight: 400;
    color: var(--g-c, var(--snow));
    text-shadow: 2px 2px 0 var(--drop);
  }
  .dl-r-w,
  .dl-r-km {
    font-family: "Jersey 15", ui-sans-serif, sans-serif;
    font-size: 19px;
    color: var(--dim);
  }

  .dl-zoom {
    position: absolute;
    top: 164px;
    right: calc(var(--edge) + 3px);
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  /* On a screen wide enough the zoom keys sit in the top band beside the
     score, over the Arctic, rather than under it over Japan and the Kurils,
     where a pin's rings would run beneath them. After the answer they drop
     to the corner the months left, beside the postcard. */
  @media (min-width: 1200px) {
    .dl:not(.is-phone) .dl-zoom {
      top: calc(var(--edge) + 3px);
      right: calc(var(--stakes-w, 260px) + var(--edge) + 22px);
    }
    .dl.is-done:not(.is-phone) .dl-zoom {
      top: auto;
      right: calc(var(--edge) + 3px);
      bottom: calc(var(--edge) + 4px);
    }
  }
  .dl-viewkey {
    height: 38px;
    font-size: 21px;
  }

  /* ---------- The hand ---------- */

  .dl-hand,
  .dl-guess,
  .dl-post {
    --b: var(--hud-b);
  }
  .dl-hand {
    position: absolute;
    left: calc(18 * var(--b));
    bottom: calc(19 * var(--b));
    transition:
      translate 260ms var(--ease-out),
      opacity 200ms linear;
  }
  .dl-hand.is-waiting {
    visibility: hidden;
  }
  .dl-tray {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, var(--card-w));
    gap: calc(14 * var(--b));
  }
  .dl-card {
    --c: var(--c1);
    position: relative;
    width: var(--card-w);
    height: var(--card-hd);
  }
  .dl-card:nth-child(2) {
    --c: var(--c2);
  }
  .dl-card:nth-child(3) {
    --c: var(--c3);
  }
  .dl-card:nth-child(4) {
    --c: var(--c4);
  }
  .dl-card:nth-child(5) {
    --c: var(--c5);
  }
  .dl-card:nth-child(6) {
    --c: var(--c6);
  }
  .dl-card-face,
  .dl-card-back {
    position: absolute;
    inset: 0;
    background: var(--c);
    box-shadow:
      0 0 0 calc(3 * var(--b)) var(--drop),
      calc(5 * var(--b)) calc(5 * var(--b)) 0 calc(3 * var(--b)) var(--drop);
  }
  .dl-card-face {
    display: flex;
    flex-direction: column;
    padding: calc(6 * var(--b)) calc(6 * var(--b)) 0;
  }
  /* The photo takes whatever the name and the reach leave. */
  .dl-card-pic {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
    background: var(--slate);
    box-shadow: 0 0 0 calc(3 * var(--b)) var(--drop);
    overflow: hidden;
  }
  .dl-card-pic img,
  .dl-card-pic canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dl-card-pic canvas {
    image-rendering: pixelated;
  }
  .dl-card-name {
    flex: none;
    height: calc(40 * var(--b));
    display: flex;
    align-items: center;
    margin: calc(3 * var(--b)) 0 0;
    padding: calc(3 * var(--b)) calc(4 * var(--b));
    background: var(--card-paper);
    box-shadow: 0 0 0 calc(3 * var(--b)) var(--drop);
    font-size: calc(12.5 * var(--b));
    font-weight: 500;
    line-height: 1.15;
    color: var(--card-ink);
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  .dl-card-name > span {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* A place in a species' name, hidden until the answer (day-list-names.ts):
     a bar in the text's colour, like a word blacked out, the same width
     whatever the word, so its length gives nothing away. */
  .dl .dl-hide {
    display: inline-block;
    width: 2.4em;
    height: 0.74em;
    vertical-align: -0.05em;
    background: currentColor;
  }

  .dl-card-reach {
    flex: none;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: calc(4 * var(--b));
    margin: calc(6 * var(--b)) calc(-6 * var(--b)) 0;
    padding: calc(3 * var(--b)) calc(4 * var(--b)) calc(5 * var(--b));
    background: var(--slate);
    color: var(--snow);
    font-size: calc(22 * var(--b));
    line-height: 1;
    white-space: nowrap;
  }
  .dl-card-reach small {
    font-size: calc(15 * var(--b));
    color: var(--dim);
  }
  .dl-card-n {
    position: absolute;
    left: calc(-9 * var(--b));
    top: calc(-11 * var(--b));
    z-index: 2;
    width: calc(26 * var(--b));
    height: calc(26 * var(--b));
    display: grid;
    place-items: center;
    background: var(--drop);
    color: var(--snow);
    font-size: calc(22 * var(--b));
    line-height: 1;
  }
  .dl-card-back {
    display: grid;
    place-items: center;
    background: var(--slate);
  }
  .dl-card-back::before {
    content: "";
    position: absolute;
    inset: calc(8 * var(--b));
    border: calc(3 * var(--b)) solid
      color-mix(in srgb, var(--c) 70%, var(--slate));
  }
  .dl-card-q {
    font-size: calc(58 * var(--b));
    line-height: 1;
    color: color-mix(in srgb, var(--c) 85%, var(--slate));
  }
  .dl-card .dl-key-next {
    position: absolute;
    inset: 0;
    margin: 0;
    flex-direction: column;
    gap: calc(6 * var(--b));
    padding: calc(8 * var(--b)) calc(6 * var(--b)) calc(10 * var(--b));
    text-align: center;
    white-space: normal;
    line-height: 0.95;
    font-size: calc(22 * var(--b));
  }
  .dl-price {
    font-family: "Jersey 25", ui-sans-serif, sans-serif;
    font-size: calc(41 * var(--b));
    line-height: 0.85;
    color: var(--red);
  }
  html.dark .dl-price {
    color: var(--amber);
  }
  .dl-price-unit {
    font-size: calc(20 * var(--b));
  }
  /* A narrow card (a small laptop or a tablet) keeps its words inside it:
     the reach, the name and the price go down a size, as on a phone. */
  .dl-card {
    container-type: inline-size;
  }
  @container (max-width: 111px) {
    .dl:not(.is-phone) .dl-card-name {
      height: 30px;
      font-size: 10.5px;
      line-height: 1.1;
    }
    .dl:not(.is-phone) .dl-card-reach {
      gap: 3px;
      font-size: 18px;
    }
    .dl:not(.is-phone) .dl-card-reach small {
      font-size: 13px;
    }
    .dl:not(.is-phone) .dl-card .dl-key-next {
      gap: 4px;
      padding: 6px 4px 8px;
      font-size: 18px;
    }
    .dl:not(.is-phone) .dl-price {
      font-size: 33px;
    }
    .dl:not(.is-phone) .dl-price-unit {
      font-size: 17px;
    }
  }

  /* The points a species cost, rising off its card's corner. */
  .dl-pop {
    --p: calc(3 * var(--b));
    position: absolute;
    right: calc(-14 * var(--b));
    top: calc(-24 * var(--b));
    z-index: 5;
    font-size: calc(41 * var(--b));
    line-height: 1;
    color: #ff6a50;
    white-space: nowrap;
    pointer-events: none;
    text-shadow:
      calc(-1 * var(--p)) 0 0 var(--drop),
      var(--p) 0 0 var(--drop),
      0 calc(-1 * var(--p)) 0 var(--drop),
      0 var(--p) 0 var(--drop),
      calc(-1 * var(--p)) calc(-1 * var(--p)) 0 var(--drop),
      var(--p) calc(-1 * var(--p)) 0 var(--drop),
      calc(-1 * var(--p)) var(--p) 0 var(--drop),
      var(--p) var(--p) 0 var(--drop),
      calc(5 * var(--b)) calc(5 * var(--b)) 0 var(--drop);
  }

  /* ---------- Months and Lock it in ---------- */

  .dl-guess {
    position: absolute;
    right: calc(18 * var(--b));
    bottom: calc(19 * var(--b));
    width: calc(372 * var(--b));
    display: grid;
    gap: calc(12 * var(--b));
    transition:
      translate 260ms var(--ease-out),
      opacity 200ms linear;
  }
  .dl-months {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: calc(10 * var(--b));
    margin: 0;
  }
  .dl-months .dl-key {
    height: calc(34 * var(--b));
    padding: 0 0 calc(2 * var(--b));
    font-size: calc(22 * var(--b));
  }
  .dl-key-lock {
    height: calc(66 * var(--b));
    flex-direction: column;
    gap: calc(3 * var(--b));
    font-family: "Jersey 25", ui-sans-serif, sans-serif;
    font-size: calc(41 * var(--b));
    --k-drop: calc(6 * var(--b));
  }
  .dl-key-lock small {
    font-family: "Jersey 15", ui-sans-serif, sans-serif;
    font-size: calc(20 * var(--b));
    line-height: 0.8;
  }
  .dl-key-lock:disabled,
  html.dark .dl-key-lock:disabled {
    --k-face: var(--key);
    --k-hi: var(--key-hi);
    --k-lo: var(--key-lo);
    --k-text: var(--slate);
  }
  html.dark .dl-key-lock:disabled {
    --k-text: var(--snow);
  }
  .dl-key-lock:disabled .dl-lock-word {
    opacity: 0.5;
  }
  .dl.is-done .dl-hand,
  .dl.is-done .dl-guess {
    translate: 0 calc(100% + 60px);
    opacity: 0;
    pointer-events: none;
  }
  .dl.is-done .dl-read {
    translate: calc(100% + 60px) 0;
    opacity: 0;
  }

  /* More lists loading: the board can't be played (it's inert), and looks it. */
  .dl.is-loading .dl-hand,
  .dl.is-loading .dl-guess {
    opacity: 0.55;
  }

  /* ---------- The postcard ---------- */

  .dl-post {
    position: absolute;
    left: calc(18 * var(--b));
    bottom: calc(19 * var(--b));
    z-index: 4;
    width: min(calc(900 * var(--b)), calc(100vw - 2 * var(--edge) - 12px));
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: calc(14 * var(--b)) calc(18 * var(--b));
    padding: calc(14 * var(--b)) calc(16 * var(--b));
    background: var(--card-paper);
    color: var(--card-ink);
    user-select: text;
    -webkit-user-select: text;
    box-shadow:
      inset 0 0 0 calc(3 * var(--b)) var(--card-paper),
      inset 0 0 0 calc(6 * var(--b)) var(--red),
      inset 0 0 0 calc(9 * var(--b)) var(--card-paper),
      inset 0 0 0 calc(12 * var(--b)) var(--c1),
      0 0 0 calc(3 * var(--b)) var(--drop),
      calc(8 * var(--b)) calc(8 * var(--b)) 0 calc(3 * var(--b)) var(--drop);
  }
  .dl-post-thumbs {
    list-style: none;
    margin: 0;
    padding: calc(6 * var(--b)) 0 0 calc(6 * var(--b));
    display: grid;
    grid-template-columns: repeat(3, calc(62 * var(--b)));
    gap: calc(8 * var(--b));
    align-content: start;
  }
  .dl-post-thumbs li {
    position: relative;
    width: calc(62 * var(--b));
    height: calc(62 * var(--b));
    background: var(--slate);
    box-shadow: 0 0 0 calc(3 * var(--b)) var(--drop);
  }
  .dl-post-thumbs img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dl-post-thumbs li.is-unused img {
    filter: grayscale(1) contrast(0.8);
    opacity: 0.55;
  }
  .dl-post-thumbs li span {
    position: absolute;
    left: calc(-6 * var(--b));
    top: calc(-8 * var(--b));
    width: calc(20 * var(--b));
    height: calc(20 * var(--b));
    display: grid;
    place-items: center;
    background: var(--c);
    color: #122a5b;
    box-shadow: 0 0 0 calc(2 * var(--b)) var(--drop);
    font-size: calc(18 * var(--b));
    line-height: 1;
  }
  .dl-post-thumbs li.is-unused span {
    background: var(--dim);
  }
  .dl-post-where {
    min-width: 0;
    padding-top: calc(6 * var(--b));
  }
  .dl-post-where h2 {
    margin: 0;
    font-size: calc(50 * var(--b));
    line-height: 0.85;
    font-weight: 400;
    color: var(--card-ink);
    overflow-wrap: anywhere;
  }
  .dl-post-where h2:focus,
  .dl-post-where h2:focus-visible {
    outline: none;
  }
  .dl-post-where p {
    margin: calc(6 * var(--b)) 0 0;
    font-size: calc(22 * var(--b));
    line-height: 1;
    color: var(--card-ink-2);
  }
  .dl-post-where .dl-post-used {
    margin-top: calc(12 * var(--b));
    font-family: "Libre Franklin", ui-sans-serif, sans-serif;
    font-size: calc(13 * var(--b));
    line-height: 1.4;
  }
  .dl-post-pts {
    display: grid;
    grid-template-columns: auto auto;
    align-content: start;
    gap: calc(4 * var(--b)) calc(16 * var(--b));
    margin: 0;
    padding: calc(6 * var(--b)) calc(6 * var(--b)) 0 0;
    font-size: calc(22 * var(--b));
    line-height: 1;
  }
  .dl-post-pts dt {
    color: var(--card-ink-2);
  }
  .dl-post-pts dd {
    margin: 0;
    text-align: right;
    color: var(--card-ink);
  }
  .dl-post-pts .dl-tot {
    margin-top: calc(6 * var(--b));
    padding-top: calc(6 * var(--b));
    border-top: calc(3 * var(--b)) solid var(--card-ink);
    font-size: calc(30 * var(--b));
  }
  .dl-post-pts dd.dl-tot {
    color: #c77f00;
  }
  .dl-post-acts {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(14 * var(--b));
    margin: 0 calc(6 * var(--b)) calc(4 * var(--b));
  }
  .dl-post-acts .dl-key {
    height: calc(40 * var(--b));
    padding: 0 calc(14 * var(--b)) calc(3 * var(--b));
    font-size: calc(22 * var(--b));
  }
  .dl-post-acts .dl-key-amber {
    font-family: "Jersey 25", ui-sans-serif, sans-serif;
    font-size: calc(28 * var(--b));
  }
  .dl-post-note {
    flex: 1 1 calc(192 * var(--b));
    margin: 0 0 calc(4 * var(--b));
    text-align: right;
    font-size: calc(19 * var(--b));
    line-height: 1.05;
    color: var(--card-ink-2);
  }

  /* ---------- The full list ---------- */

  .dl-sheet {
    width: min(980px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 48px);
    margin: auto;
    padding: 12px;
    border: 0;
    overflow: hidden;
    background: var(--card-paper);
