---
/**
 * Day list - a daily puzzle built on real iNaturalist records.
 *
 * Six species were all recorded at one place in one month. The board shows
 * them one at a time, most widely recorded first, so each one narrows the map
 * further. The visitor drops a pin, picks a month and locks it in once. Every
 * extra species lowers the most they can score, and the board shows that
 * number before they ask (the "Reveal next clue -750" idea from Originle).
 *
 * The rules come first and are the largest text on the page, because the
 * premise is the part people got stuck on.
 *
 * Behaviour lives in @/lib/hobbies/day-list, bound via [data-daylist-*].
 * Photos load from the iNaturalist CDNs already allow-listed in the CSP.
 */
interface Props {
  heading?: string;
}
const { heading = "Today's list" } = Astro.props;

const STEPS = [
  "You start with one species. It's the most common of the six, so it could be almost anywhere.",
  "If you're stuck, show the next one. Each is rarer than the last and narrows things down, but it costs you points.",
  "Whenever you have a hunch, tap the map where you think they were seen and pick a month.",
  "Lock it in. You only get one guess, and a pin anywhere inside the real place counts as spot on.",
];

const MONTHS = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];
---

<div class="dl not-prose" data-daylist>
  <section class="dl-how" aria-labelledby="dl-how-title">
    <div class="shead">
      <h2 id="dl-how-title">How to play</h2>
    </div>
    <ol class="dl-steps" role="list">
      {STEPS.map((step) => <li>{step}</li>)}
    </ol>
    <p class="dl-how-note">
      Today's list is the same for everyone and changes each day. More lists
      gives you ten others a day, from places the daily list never uses.
    </p>
  </section>

  <section class="dl-board" aria-labelledby="dl-board-title" data-daylist-board>
    <h2 class="dl-sr" id="dl-board-title" data-daylist-title>{heading}</h2>
    <div class="dl-boardhead">
      <div
        class="utabs dl-modes"
        role="radiogroup"
        aria-label="Which list"
        data-daylist-modes
      >
        <button
          type="button"
          role="radio"
          aria-checked="true"
          data-value="daily">{heading}</button
        >
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-value="extra">More lists</button
        >
      </div>
      <p class="dl-date" data-daylist-meta></p>
    </div>

    <div class="dl-axis" aria-hidden="true">
      <span>Most common</span><i></i><span>Rarest</span>
    </div>
    <ol
      class="dl-tray"
      role="list"
      aria-label="The six species, most common first"
      data-daylist-clues
    >
    </ol>
    <p class="dl-sr" aria-live="polite" data-daylist-announce></p>

    <div class="dl-play" data-daylist-play>
      <div class="dl-mapbox">
        <div
          class="dl-mapwrap"
          data-daylist-mapwrap
          tabindex="0"
          role="application"
          aria-label="World map. Tap where you think the six species were seen. Arrow keys move the pin, plus and minus zoom."
        >
          <canvas data-daylist-map></canvas>
        </div>
        <p class="dl-maphint" aria-hidden="true">Tap the map to drop a pin</p>
        <div class="dl-scale" data-daylist-scale aria-hidden="true" hidden>
          <i></i><span></span>
        </div>
        <div class="dl-zoom" role="group" aria-label="Zoom">
          <button type="button" data-daylist-zoom="in" aria-label="Zoom in"
            >+</button
          >
          <button
            type="button"
            data-daylist-zoom="out"
            aria-label="Zoom out"
            disabled>&minus;</button
          >
        </div>
        <button type="button" class="dl-mapbtn" data-daylist-view hidden
          >Whole world</button
        >
        <p class="dl-wheelhint" data-daylist-wheelhint aria-hidden="true"></p>
      </div>

      <div class="dl-panel">
        <div class="dl-guess" data-daylist-guess>
          <p class="dl-worth">
            Up to <span class="dl-worth__n" data-daylist-worth>6,000</span> points
          </p>

          <fieldset class="dl-months">
            <legend class="dl-legend">Which month?</legend>
            <div class="dl-months__grid">
              {
                MONTHS.map((name, i) => (
                  <label class="dl-month">
                    <input
                      type="radio"
                      name="dl-month"
                      value={i}
                      autocomplete="off"
                      data-daylist-month
                    />
                    <span class="dl-month__cell" aria-hidden="true">
                      {name.slice(0, 3)}
                    </span>
                    <span class="dl-sr">{name}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <p class="dl-readout" aria-live="polite" data-daylist-readout>
            Drop a pin, then pick a month.
          </p>
          <button
            type="button"
            class="btn btn-ink dl-lock"
            data-daylist-lock
            disabled>Lock it in</button
          >
        </div>

        <div class="dl-result" data-daylist-result hidden></div>
      </div>
    </div>
  </section>

  <div data-daylist-roll></div>

  <p class="dl-foot">
    Every species on a list really was logged at that place in that month, and
    every place is a real one with a published boundary. Sighting counts show
    how often something gets logged worldwide, which follows where people go
    looking as much as where the animal lives. The full list flags introduced
    and endemic species, because a kookaburra in Tasmania is a very different
    clue once you know it was put there. Data from iNaturalist, terrain and
    borders from Natural Earth, photos credited to whoever took them.
  </p>
</div>

<script>
  import { initDayList } from "@/lib/hobbies/day-list";

  document
    .querySelectorAll<HTMLElement>("[data-daylist]")
    .forEach((el) => initDayList(el));
</script>

<style is:global>
  /* Global rather than scoped, and namespaced under .dl so nothing leaks.
     Astro's scoped styles only reach markup present at build time, and the
     species slots, result and full list are built by the script at runtime,
     so scoping would silently miss them. Rules that adjust a shared class
     (.btn, .shead) are prefixed with .dl so they win on specificity. */

  .dl [hidden] {
    display: none !important;
  }
  .dl-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------------- how to play ----------------
     The largest body text on the page. The numbers are a real sequence. */
  .dl-how {
    max-width: 46rem;
  }
  .dl-steps {
    counter-reset: dl-step;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .dl-steps > li {
    counter-increment: dl-step;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: baseline;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink);
    text-wrap: pretty;
  }
  .dl-steps > li::before {
    content: counter(dl-step);
    font-weight: 300;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .dl-how-note {
    margin: 16px 0 0 2rem;
    max-width: 60ch;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-3);
  }

  /* ---------------- board ---------------- */
  .dl-board {
    margin-top: 44px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 16px;
  }
  .dl-boardhead {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 6px 16px;
  }
  /* The two modes are the board's title: Cult UI direction-aware-tabs at
     heading size, one ink bar sliding between them (src/lib/motion.ts). */
  .dl .dl-modes {
    gap: 26px;
  }
  .dl .dl-modes > [role="radio"] {
    min-height: 40px;
    padding: 4px 0 8px;
    font-size: 19px;
    font-weight: 300;
    line-height: 1.25;
  }
  .dl-date {
    margin: 0 0 9px;
    font-size: 12px;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  /* Says why the order matters, right where the order is. */
  .dl-axis {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 18px 0 10px;
    font-size: 11px;
    color: var(--ink-2);
  }
  .dl-axis i {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--rule);
  }
  .dl-axis i::after {
    content: "";
    position: absolute;
    right: 0;
    top: -3px;
    border-left: 6px solid var(--ink-2);
    border-top: 3.5px solid transparent;
    border-bottom: 3.5px solid transparent;
  }

  /* ---------------- the six species ---------------- */
  .dl-tray {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px 12px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (min-width: 1024px) {
    .dl-tray {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .dl-slot {
    min-width: 0;
  }
  .dl-slot__fig {
    margin: 0;
  }
  .dl-slot__pic {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--band);
  }
  .dl-slot__pic img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 320ms var(--ease);
  }
  .dl-slot__pic img.is-loaded {
    opacity: 1;
  }
  .dl-slot__body {
    display: block;
    padding-top: 10px;
  }
  .dl-slot__name {
    display: block;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .dl-slot__sci {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    font-style: italic;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .dl-slot__count {
    display: block;
    margin-top: 6px;
    font-size: 12px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  /* CC BY and CC BY-NC both require the photographer to be named, so the
     credit rides with the photo rather than living in a footnote. */
  .dl-slot__credit {
    display: block;
    margin-top: 3px;
    font-size: 10px;
    line-height: 1.35;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .dl-slot.is-new .dl-slot__body {
    animation: dl-rise 320ms var(--ease) var(--dl-delay, 0ms) both;
  }
  .dl-slot.is-new .dl-slot__pic img {
    transition-delay: var(--dl-delay, 0ms);
  }
  @keyframes dl-rise {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  /* Still hidden: the same square, empty, with its place in the order. */
  .dl-slot__blank {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--rule);
    font-size: 22px;
    font-weight: 300;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  /* The next square is the button, and says what it costs. */
  .dl-slot__next {
    display: grid;
    place-content: center;
    gap: 6px;
    width: 100%;
    aspect-ratio: 1 / 1;
    padding: 10px;
    border: 1px dashed var(--ink-2);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    line-height: 1.3;
    text-align: center;
    cursor: pointer;
    transition:
      background-color 150ms var(--ease),
      border-color 150ms var(--ease);
  }
  .dl-slot__next:hover {
    background: var(--hover);
    border-style: solid;
    border-color: var(--ink);
  }
  .dl-slot__cta {
    text-wrap: balance;
  }
  .dl-slot__cost {
    font-size: 12px;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .dl-nowrap {
    white-space: nowrap;
  }

  /* ---------------- map and guess ---------------- */
  /* More lists loading: the board can't be played (it's inert), and looks it. */
  .dl-board.is-loading .dl-tray,
  .dl-board.is-loading .dl-play {
    opacity: 0.45;
  }
  .dl-play {
    margin-top: 28px;
    display: grid;
    gap: 22px;
  }
  @media (min-width: 1024px) {
    .dl-play {
      grid-template-columns: minmax(0, 1fr) 18.5rem;
      gap: 28px;
      align-items: start;
    }
  }

  .dl-mapbox {
    position: relative;
  }
  .dl-mapwrap {
    position: relative;
    aspect-ratio: 2 / 1;
    border: 1px solid var(--rule);
    cursor: crosshair;
    /* The map module sets pan-y at world view and none once zoomed in. */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .dl-mapwrap.is-zoomed {
    cursor: grab;
  }
  .dl-mapwrap.is-done {
    cursor: default;
  }
  .dl-mapwrap.is-done.is-zoomed {
    cursor: grab;
  }
  .dl-mapwrap.is-panning,
  .dl-mapwrap.is-done.is-panning {
    cursor: grabbing;
  }
  .dl-mapwrap canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .dl-maphint {
    position: absolute;
    left: 8px;
    bottom: 8px;
    margin: 0;
    padding: 4px 8px;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    font-size: 12px;
    color: var(--ink-3);
    pointer-events: none;
    transition: opacity 250ms var(--ease);
  }
  .dl-mapwrap.is-placed ~ .dl-maphint,
  .dl-mapwrap.is-zoomed ~ .dl-maphint,
  .dl-mapwrap.is-done ~ .dl-maphint {
    opacity: 0;
  }

  /* Map controls sit over the map but outside it, so pressing one is never a
     tap on the map. */
  .dl-zoom {
    position: absolute;
    top: 8px;
    right: 8px;
    display: grid;
  }
  .dl-zoom button,
  .dl-mapbtn {
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    transition:
      background-color 150ms var(--ease),
      border-color 150ms var(--ease);
  }
  .dl-zoom button {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    font-size: 18px;
    line-height: 1;
  }
  .dl-zoom button + button {
    border-top: 0;
  }
  .dl-zoom button:hover:not(:disabled),
  .dl-mapbtn:hover {
    background: var(--hover);
    border-color: var(--ink-2);
  }
  .dl-zoom button:disabled {
    color: var(--ink-2);
    cursor: default;
  }
  .dl-mapbtn {
    position: absolute;
    right: 8px;
    bottom: 8px;
    min-height: 32px;
    padding: 4px 10px;
    font-size: 12px;
  }
  @media (pointer: coarse) {
    .dl-zoom button {
      width: 40px;
      height: 40px;
    }
    .dl-mapbtn {
      min-height: 40px;
    }
  }
  /* A phone's map is only ~195px tall, so the controls go flush to the edge
     and stay small. 36px is still a comfortable thumb. */
  @media (max-width: 639px) {
    .dl-zoom {
      top: 0;
      right: 0;
    }
    .dl-zoom button {
      width: 36px;
      height: 36px;
    }
    .dl-mapbtn {
      right: 0;
      bottom: 0;
      min-height: 36px;
    }
    .dl-scale,
    .dl-maphint {
      left: 6px;
      bottom: 6px;
    }
  }

  /* A scale bar for the latitude in the middle of the view: a hairline with
     end ticks and a round distance under it. */
  .dl-scale {
    position: absolute;
    left: 8px;
    bottom: 8px;
    display: grid;
    gap: 3px;
    padding: 4px 6px 3px;
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    font-size: 11px;
    line-height: 1;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  .dl-scale i {
    display: block;
    height: 5px;
    border: 1px solid var(--ink-2);
    border-top: 0;
  }

  .dl-wheelhint {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    background: color-mix(in srgb, var(--paper) 60%, transparent);
    font-size: 14px;
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms var(--ease);
  }
  .dl-wheelhint.is-on {
    opacity: 1;
  }

  .dl-guess,
  .dl-result {
    display: grid;
    gap: 18px;
  }
  /* Under the map on narrower screens; a receipt the full page wide puts
     each number too far from its label. */
  .dl-panel {
    max-width: 32rem;
  }

  .dl-worth {
    margin: 0;
    font-size: 14px;
    color: var(--ink-3);
  }
  .dl-worth__n {
    display: inline-block;
    font-size: 28px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .dl-months {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .dl-legend {
    margin: 0 0 8px;
    padding: 0;
    font-size: 13px;
    color: var(--ink);
  }
  .dl-months__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 4px;
  }
  @media (min-width: 1024px) {
    .dl-months__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .dl-month {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .dl-month input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .dl-month__cell {
    display: grid;
    place-items: center;
    min-height: 40px;
    border: 1px solid var(--rule);
    font-size: 13px;
    color: var(--ink-3);
    transition:
      background-color 150ms var(--ease),
      border-color 150ms var(--ease),
      color 150ms var(--ease);
  }
  .dl-month:hover .dl-month__cell {
    background: var(--hover);
    border-color: var(--ink-2);
    color: var(--ink);
  }
  .dl-month input:checked + .dl-month__cell {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .dl-month input:focus-visible + .dl-month__cell {
    box-shadow:
      0 0 0 2px var(--paper),
      0 0 0 4px var(--ink);
  }

  .dl-readout {
    margin: 0;
    min-height: 2.9em;
    font-size: 13px;
    line-height: 1.45;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .dl .dl-lock {
    width: 100%;
    min-height: 44px;
    font-size: 14px;
  }
  /* Outlined until there's a pin and a month, so turning ink means ready. */
  .dl .dl-lock:disabled {
    background: transparent;
    border-color: var(--rule);
    color: var(--ink-2);
    opacity: 1;
  }

  /* ---------------- result ---------------- */
  .dl-verdict {
    margin: 0;
    font-size: 13px;
    color: var(--ink-2);
  }
  .dl-place {
    margin: 4px 0 0;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--ink);
    text-wrap: balance;
  }
  /* Focus lands here after "Lock it in" so the result is read out next. It
     isn't a control, so it doesn't get the ring. */
  .dl-place:focus,
  .dl-place:focus-visible {
    outline: none;
    box-shadow: none;
  }
  .dl-region {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--ink-3);
  }

  /* A receipt: where the points came from, so the scoring explains itself. */
  .dl-receipt {
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .dl-receipt > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .dl-receipt dt {
    font-size: 13px;
    color: var(--ink);
  }
  .dl-receipt dd {
    margin: 0;
  }
  .dl-receipt__pts {
    font-size: 13px;
    text-align: right;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .dl-receipt__why {
    grid-column: 1 / -1;
    margin-top: 2px;
    font-size: 12px;
    line-height: 1.45;
    color: var(--ink-2);
  }
  /* A number that counts up in place (rollTo); a one-step change slides. */
  .dl-num {
    display: inline-block;
    font-variant-numeric: tabular-nums;
  }
  .dl-receipt > .dl-receipt__total {
    align-items: baseline;
    border-bottom: 0;
  }
  .dl-score {
    display: inline-block;
    font-size: 28px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .dl-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .dl-next {
    margin: 0;
    font-size: 12px;
    color: var(--ink-2);
  }

  /* ---------------- the full list ---------------- */
  .dl-roll {
    margin-top: 44px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }
  .dl-roll h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 300;
    line-height: 1.25;
    color: var(--ink);
  }
  .dl-entries {
    counter-reset: dl-entry;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 22px 28px;
  }
  @media (min-width: 640px) {
    .dl-entries {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
