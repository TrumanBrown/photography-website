---
/**
 * Tide-pooling "flip a rock" game. Static markup + the reveal card; all
 * behaviour (beach, flipping, sprites, journal) lives in @/lib/hobbies/tidepool,
 * bound via the [data-tp-*] hooks. The mounting script is an Astro-processed module
 * (served from /_astro/), so it satisfies the strict `script-src 'self'` CSP.
 */
import FieldJournal from "@/components/hobbies/FieldJournal.astro";
import SpecimenCard from "@/components/hobbies/SpecimenCard.astro";
import { SPECIES } from "@/lib/hobbies/tidepool-species";
---

<section data-tidepool aria-label="Tide pooling game" class="not-prose">
  <FieldJournal prefix="tp" total={SPECIES.length} resetLabel="New beach" />

  <div
    class="tp-frame"
    data-tp-frame
    tabindex="0"
    role="application"
    aria-label="A pixel beach at low tide. Tap rocks and driftwood logs to find the creatures hiding underneath. Arrow keys pick one, Enter looks underneath."
  >
    <canvas
      data-tp-canvas
      class="block w-full touch-manipulation"
      style="image-rendering: pixelated"
      aria-hidden="true"></canvas>
  </div>
  <p class="sr-only" aria-live="polite" data-tp-live></p>
  <p class="tp-note">
    Pick a rock or log with the arrow keys and press Enter to look underneath.
    Your field journal remembers what you've found. Just like IRL, put the rocks
    back where you found them.
  </p>

  <SpecimenCard prefix="tp" closeLabel="Keep looking" />
</section>

<style>
  .tp-frame {
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--band);
  }
  .tp-note {
    margin: 8px 0 0;
    max-width: 72ch;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
  }
</style>

<script>
  import { initTidepool } from "@/lib/hobbies/tidepool";

  const root = document.querySelector<HTMLElement>("[data-tidepool]");
  if (root) initTidepool(root);
</script>
