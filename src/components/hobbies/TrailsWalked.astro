---
/**
 * "Trails I've walked": hikes from the photo archive, each a card that opens
 * its session. The hiking page's personal element. A card is a session card
 * (a photograph on two sheets of paper, the place, one tracked line) and
 * opens its session with the same plain page change (src/lib/open.ts).
 */
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { trailCards, type Hike } from "@/lib/hobbies/hiking-trails";

interface Props {
  heading?: string;
  hikes: Hike[];
}

const { heading = "Trails I've walked", hikes } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/sessions/**/images/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);

const cards = trailCards(hikes, await getCollection("sessions")).flatMap(
  (card) => {
    const image =
      images[`/src/content/sessions/${card.slug}/images/${card.file}`]?.default;
    return image ? [{ ...card, image }] : [];
  },
);
---

{
  cards.length > 0 && (
    <section class="mt-12" aria-labelledby="trails-walked">
      <div class="mb-4">
        <div class="shead">
          <h2 id="trails-walked">{heading}</h2>
          <span class="u-label tabular-nums">
            {cards.length} hike{cards.length === 1 ? "" : "s"}
          </span>
        </div>
      </div>
      <ul class="trails">
        {cards.map((card) => (
          <li>
            <a
              class="trail"
              href={`/sessions/${card.slug}/`}
              data-open="session"
            >
              <span class="shotwrap">
                <i class="s1" aria-hidden="true" />
                <i class="s2" aria-hidden="true" />
                <span class="shot">
                  <Picture
                    src={card.image}
                    alt={card.alt}
                    widths={[320, 480, 640, 960]}
                    sizes="(min-width: 1152px) 341px, (min-width: 640px) 30vw, 42vw"
                    formats={["webp"]}
                    fallbackFormat="jpeg"
                    loading="lazy"
                    decoding="async"
                    class="shot-img"
                  />
                </span>
              </span>
              <span class="t">{card.place}</span>
              <span class="m">
                <time datetime={card.date}>{card.dateText}</time>
              </span>
              {card.stats && <span class="m">{card.stats}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .trails {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px 18px;
  }
  @media (min-width: 640px) {
    .trails {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px 28px;
    }
  }

  .trail {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .trail:hover {
    text-decoration: none;
  }

  /* The two sheets sit 8px down and right of the photograph, so the margin
     keeps them inside the grid cell. */
  .shotwrap {
    position: relative;
    display: block;
    margin: 0 8px 8px 0;
  }
  .shotwrap i {
    position: absolute;
    inset: 0;
    display: block;
    transition: transform 260ms var(--ease);
  }
  .shotwrap i.s1 {
    background: var(--stack-1);
    transform: translate(8px, 8px);
  }
  .shotwrap i.s2 {
    background: var(--stack-2);
    transform: translate(4px, 4px);
  }
  .shot {
    position: relative;
    display: block;
  }
  .shot :global(.shot-img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--band);
  }

  .t {
    display: block;
    margin-top: 3px;
    font-size: 15px;
    line-height: 1.3;
    color: var(--ink);
  }
  .m {
    display: block;
    margin-top: 2px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  @media (hover: hover) and (pointer: fine) {
    .trail:hover .shotwrap i.s1 {
      transform: translate(11px, 11px);
    }
    .trail:hover .shotwrap i.s2 {
      transform: translate(5.5px, 5.5px);
    }
    .trail:hover .t {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  @media (max-width: 899px) {
    .t {
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shotwrap i {
      transition: none;
    }
  }
</style>
