---
/**
 * Interactive hike builder and postcard studio. The controls are static and
 * accessible; @/lib/hobbies/hiking owns the scene state and canvas behavior.
 *
 * Dressed like the rest of the archive with the shared .u-label, .btn,
 * .linkbtn, .draw and .utabs parts from src/styles/global.css. Every colour
 * is an ink/paper token, so dark mode needs nothing extra here.
 */
const biomes = [
  { id: "cascades", label: "Cascades" },
  { id: "fjord", label: "Fjords" },
  { id: "karst", label: "Karst" },
  { id: "himalaya", label: "Himalaya" },
];

const lights = [
  { id: "dawn", label: "Dawn", title: "Dawn" },
  { id: "day", label: "Day", title: "Daylight" },
  { id: "golden", label: "Gold", title: "Golden hour" },
];

const moments = [
  { id: "forest", label: "Forest", title: "Add a dense forest corridor" },
  { id: "meadow", label: "Meadow", title: "Add an open meadow bench" },
  { id: "lake", label: "Alpine lake", title: "Carve an alpine lake basin" },
  { id: "waterfall", label: "Waterfall", title: "Cut a waterfall crossing" },
  {
    id: "wildflowers",
    label: "Wildflowers",
    title: "Add a flowering trail bench",
  },
  { id: "snowfield", label: "Snowfield", title: "Add a high snow crossing" },
  { id: "camp", label: "Camp", title: "Flatten a sheltered campsite" },
  { id: "lookout", label: "Lookout", title: "Raise a lookout spur" },
];

const hikerColors = ["#d5523f", "#e1a13a", "#247d72", "#355f9b", "#7d4f8f"];
---

<section data-pixel-hike aria-label="Build an imaginary hike" class="not-prose">
  <div class="hike-stage">
    <canvas
      data-hike-canvas
      class="hike-canvas"
      tabindex="0"
      role="img"
      aria-label="An editable mountain route with draggable ridgeline and trail moments"
    ></canvas>
    <div class="hike-overlay">
      <span data-hike-region-label class="hike-chip u-label">Cascades</span>
      <span data-hike-stage-stat class="hike-chip hike-stat"
        >9.2 mi · 3 mountains · 3,050 ft</span
      >
    </div>
  </div>
  <p data-hike-save-state class="hike-save" aria-live="polite">
    Saved on this device
  </p>

  <div class="hike-studio">
    <div class="hike-controls">
      <div class="hike-field">
        <span class="u-label hike-label" id="hike-landscape-label"
          >Landscape</span
        >
        <div
          class="utabs"
          role="radiogroup"
          aria-labelledby="hike-landscape-label"
          data-utabs
        >
          {
            biomes.map((biome) => (
              <button
                type="button"
                role="radio"
                aria-checked={biome.id === "cascades" ? "true" : "false"}
                data-hike-biome={biome.id}
              >
                {biome.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="hike-field">
        <span class="u-label hike-label" id="hike-light-label">Light</span>
        <div
          class="utabs"
          role="radiogroup"
          aria-labelledby="hike-light-label"
          data-utabs
        >
          {
            lights.map((light) => (
              <button
                type="button"
                role="radio"
                aria-checked={light.id === "golden" ? "true" : "false"}
                data-hike-light={light.id}
                title={light.title}
              >
                {light.label}
              </button>
            ))
          }
        </div>
      </div>

      <fieldset class="hike-field">
        <legend class="u-label">Trail moments</legend>
        <div class="hike-moments">
          {
            moments.map((moment) => (
              <button
                type="button"
                class="btn hike-moment"
                data-hike-feature={moment.id}
                title={moment.title}
              >
                <span class="hike-plus" aria-hidden="true">
                  +
                </span>
                <span>{moment.label}</span>
              </button>
            ))
          }
        </div>
      </fieldset>

      <div class="hike-trail">
        <div class="hike-trail-head">
          <p id="hike-trail-label" class="hike-trail-label">On your trail</p>
          <span data-hike-feature-count class="hike-count">3 / 10 moments</span>
        </div>
        <div
          data-hike-itinerary
          class="hike-itinerary"
          role="group"
          aria-labelledby="hike-trail-label"
        >
        </div>
      </div>

      <details class="hike-fine">
        <summary>
          <span data-hike-terrain-summary>Fine-tune 13 terrain points</span>
        </summary>
        <div data-hike-terrain-controls class="hike-points"></div>
      </details>
    </div>

    <aside class="hike-route">
      <label class="hike-block">
        <span class="u-label hike-label">Route name</span>
        <input
          data-hike-name
          type="text"
          maxlength="48"
          value="A trail above the trees"
          autocomplete="off"
          class="hike-name"
        />
      </label>

      <dl class="hike-stats">
        <div>
          <dt class="u-label">Miles</dt>
          <dd data-hike-distance-stat>9.2</dd>
        </div>
        <div>
          <dt class="u-label">Gain</dt>
          <dd><span data-hike-gain-stat>3,050</span> ft</dd>
        </div>
        <div>
          <dt class="u-label">Feel</dt>
          <dd data-hike-effort-stat>Big day</dd>
        </div>
      </dl>
      <p class="hike-est">A playful estimate, not trail guidance.</p>

      <label class="hike-block hike-length">
        <span class="hike-length-row">
          <span>Route length</span>
          <span data-hike-distance-label class="hike-length-value">9.2 mi</span>
        </span>
        <input
          data-hike-distance
          type="range"
          min="3"
          max="18"
          step="0.1"
          value="9.2"
          class="hike-range"
        />
      </label>

      <div class="hike-selects">
        <label>
          <span class="u-label">Season</span>
          <select data-hike-season class="hike-select">
            <option value="spring">Spring</option>
            <option value="summer" selected>Summer</option>
            <option value="autumn">Autumn</option>
            <option value="winter">Winter</option>
          </select>
        </label>
        <label>
          <span class="u-label">Weather</span>
          <select data-hike-weather class="hike-select">
            <option value="clear">Clear</option>
            <option value="clouds" selected>Clouds</option>
            <option value="mist">Mist</option>
          </select>
        </label>
      </div>

      <fieldset class="hike-jacket">
        <legend class="u-label">Hiker jacket</legend>
        <div class="hike-swatches">
          {
            hikerColors.map((color, index) => (
              <button
                type="button"
                data-hike-color={color}
                aria-label={`Jacket color ${index + 1}`}
                aria-pressed={index === 0 ? "true" : "false"}
                class="hike-swatch"
                style={`--hike-swatch:${color}`}
              />
            ))
          }
        </div>
      </fieldset>
    </aside>
  </div>

  <div class="hike-acts">
    <div class="hike-tools">
      <button type="button" data-hike-undo class="linkbtn draw" disabled
        ><span>Undo</span></button
      >
      <button
        type="button"
        data-hike-shuffle
        class="linkbtn draw"
        title="Make another trail"><span>Shuffle</span></button
      >
      <button type="button" data-hike-reset class="linkbtn draw"
        ><span>Start over</span></button
      >
    </div>
    <div class="hike-go">
      <button type="button" data-hike-walk class="btn"
        ><span>Walk the trail</span></button
      >
      <button type="button" data-hike-develop class="btn btn-ink"
        >Develop postcard</button
      >
    </div>
  </div>

  <dialog
    data-hike-dialog
    class="hike-dialog"
    aria-labelledby="hike-dialog-label hike-dialog-title"
  >
    <div class="hike-dialog-head">
      <div>
        <p id="hike-dialog-label" class="u-label">Your postcard</p>
        <h2
          id="hike-dialog-title"
          data-hike-dialog-title
          class="hike-dialog-title"
        >
          A trail above the trees
        </h2>
      </div>
      <button type="button" data-hike-close class="linkbtn draw"
        ><span>Back to the trail</span></button
      >
    </div>
    <div class="hike-well">
      <div class="hike-print" data-hike-print>
        <canvas
          data-hike-postcard
          width="2400"
          height="1600"
          class="hike-postcard"
          role="img"
          aria-label="Your generated hiking postcard"></canvas>
        <span class="hike-grain" aria-hidden="true"></span>
      </div>
    </div>
    <div class="hike-dialog-foot">
      <p data-hike-export-status class="hike-export" aria-live="polite">
        Rendered on your device at 2,400 × 1,600.
      </p>
      <div class="hike-dialog-acts">
        <button type="button" data-hike-share class="btn" hidden>Share</button>
        <button type="button" data-hike-download class="btn btn-ink"
          >Download PNG</button
        >
      </div>
    </div>
  </dialog>
</section>

<style>
  /* Ink on paper like the rest of the archive: hairline rules, tracked caps
     labels, square corners, no fills beyond --hover and --band. */

  .hike-stage {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--band);
  }

  .hike-canvas {
    display: block;
    width: 100%;
    height: clamp(18rem, 58vw, 38rem);
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .hike-canvas[data-moment="true"] {
    cursor: grab;
  }

  .hike-canvas[data-dragging="moment"] {
    cursor: grabbing;
  }

  .hike-canvas[data-dragging="terrain"] {
    cursor: ns-resize;
  }

  /* The two labels that sit on the artwork. They stack on narrow screens
     rather than squeezing the stat onto three lines. */
  .hike-overlay {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 6px 12px;
    padding: 12px;
    pointer-events: none;
  }

  .hike-chip {
    padding: 3px 8px;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    color: var(--ink);
    line-height: 18px;
    white-space: nowrap;
  }

  .hike-stat {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .hike-save {
    margin: 8px 0 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .hike-studio {
    display: grid;
    gap: 28px;
    margin-top: 22px;
  }

  .hike-controls,
  .hike-route {
    min-width: 0;
  }

  .hike-field {
    min-inline-size: 0;
    margin: 20px 0 0;
  }

  .hike-field:first-child {
    margin-top: 0;
  }

  .hike-label {
    display: block;
    margin-bottom: 6px;
  }

  .hike-moments {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    margin-top: 8px;
  }

  .hike-moment {
    justify-content: flex-start;
    padding-inline: 12px;
    text-align: left;
  }

  .hike-plus {
    color: var(--ink-2);
  }

  .hike-trail {
    margin-top: 22px;
    padding: 10px 0 12px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .hike-trail-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .hike-trail-label {
    margin: 0;
    font-size: 13px;
  }

  .hike-count {
    font-size: 12px;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .hike-itinerary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    margin-top: 8px;
  }

  .hike-fine {
    margin-top: 8px;
  }

  .hike-fine > summary {
    width: fit-content;
    padding: 6px 0;
    font-size: 13px;
    line-height: 20px;
    color: var(--ink);
    cursor: pointer;
  }

  .hike-fine > summary::marker {
    color: var(--ink-2);
  }

  .hike-fine > summary::-webkit-details-marker {
    color: var(--ink-2);
  }

  .hike-points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 16px;
    margin-top: 4px;
  }

  .hike-route {
    padding-top: 22px;
    border-top: 1px solid var(--rule);
  }

  .hike-block {
    display: block;
  }

  .hike-name {
    display: block;
    width: 100%;
    padding: 4px 0 8px;
    border: 0;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 19px;
    font-weight: 300;
  }

  /* The ink rule replaces the global focus ring here. */
  .hike-name:focus-visible {
    border-bottom-color: var(--ink);
    box-shadow: none;
  }

  .hike-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 16px 0 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .hike-stats > div {
    min-width: 0;
    padding: 8px 0;
  }

  .hike-stats dd {
    margin: 2px 0 0;
    overflow: hidden;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hike-est {
    margin: 6px 0 0;
    font-size: 11px;
    color: var(--ink-2);
  }

  .hike-length {
    margin-top: 18px;
  }

  .hike-length-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
  }

  .hike-length-value {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .hike-range {
    display: block;
    width: 100%;
    height: 32px;
    margin: 0;
    accent-color: var(--ink);
  }

  .hike-selects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 18px;
  }

  .hike-selects label {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .hike-select {
    width: 100%;
    padding: 6px 8px;
    border: 1px solid var(--rule);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 13px;
  }

  /* Windows draws the open list in system colours unless told otherwise. */
  .hike-select option {
    background: var(--paper);
    color: var(--ink);
  }

  .hike-jacket {
    min-inline-size: 0;
    margin: 18px 0 0;
  }

  .hike-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .hike-swatch {
    --hike-ring: var(--rule);
    position: relative;
    width: 22px;
    height: 22px;
    padding: 0;
    border: 2px solid var(--paper);
    border-radius: 0;
    background: var(--hike-swatch);
    box-shadow: 0 0 0 1px var(--hike-ring);
    cursor: pointer;
  }

  /* A 32px target around the 22px swatch. */
  .hike-swatch::before {
    content: "";
    position: absolute;
    inset: -7px;
  }

  .hike-swatch[aria-pressed="true"] {
    --hike-ring: var(--ink);
  }

  /* The swatch's own ring outranks the global one, so restate it. */
  .hike-swatch:focus-visible {
    box-shadow:
      0 0 0 1px var(--hike-ring),
      0 0 0 3px var(--paper),
      0 0 0 5px var(--ink);
  }

  .hike-acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 28px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }

  .hike-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
  }

  .hike-go {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
  }

  .hike-go > .btn {
    flex: 1 1 auto;
  }

  .hike-dialog {
    width: min(64rem, calc(100vw - 1.5rem));
    max-height: calc(100dvh - 1.5rem);
    margin: auto;
    overflow: auto;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
  }

  .hike-dialog::backdrop {
    background: color-mix(in srgb, #000 55%, transparent);
  }

  .hike-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--rule);
  }

  .hike-dialog-title {
    margin: 2px 0 0;
    font-size: 19px;
    font-weight: 300;
    line-height: 1.3;
  }

  .hike-well {
    padding: 12px;
    background: var(--band);
  }

  .hike-postcard {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
  }

  /* "Develop postcard" develops: the print comes up pale and grainy and the
     contrast and colour come in, like a print in the tray. The grain is an
     ordered-dither screen (the Bayer idea behind Cult UI's dither-image). The
     download is the canvas itself, so none of this touches the PNG. */
  .hike-print {
    position: relative;
  }
  /* The postmark slamming onto the print once it's up (hiking.ts); then it's
     painted into the canvas and this copy goes. */
  .hike-print :global(.hike-postmark) {
    position: absolute;
    height: auto;
    pointer-events: none;
  }
  .hike-grain {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background-image:
      radial-gradient(
        circle at 25% 25%,
        rgb(20 18 12 / 0.55) 0 0.9px,
        transparent 1.1px
      ),
      radial-gradient(
        circle at 75% 75%,
        rgb(20 18 12 / 0.35) 0 0.9px,
        transparent 1.1px
      );
    background-size: 4px 4px;
    mix-blend-mode: multiply;
  }
  .hike-print.developing .hike-postcard {
    animation: hike-develop 1700ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
  }
  .hike-print.developing .hike-grain {
    animation: hike-undither 1400ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
  }
  @keyframes hike-develop {
    0% {
      filter: contrast(0.25) brightness(1.55) sepia(0.6) blur(1.2px);
    }
    55% {
      filter: contrast(0.75) brightness(1.15) sepia(0.25) blur(0.3px);
    }
    100% {
      filter: none;
    }
  }
  @keyframes hike-undither {
    0% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hike-print.developing .hike-postcard,
    .hike-print.developing .hike-grain {
      animation: none;
    }
  }

  .hike-dialog-foot {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 12px 16px;
    border-top: 1px solid var(--rule);
  }

  .hike-export {
    margin: 0;
    font-size: 12px;
    color: var(--ink-2);
  }

  .hike-dialog-acts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  [data-pixel-hike] [hidden] {
    display: none !important;
  }

  /* Four landscapes need a little less air on the narrowest phones. */
  @media (max-width: 359px) {
    .hike-field .utabs {
      gap: 16px;
    }
  }

  @media (min-width: 640px) {
    .hike-overlay {
      padding: 16px;
    }

    .hike-moments,
    .hike-points {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .hike-go > .btn {
      flex: none;
    }

    .hike-dialog-head,
    .hike-dialog-foot {
      padding: 14px 20px;
    }

    .hike-dialog-foot {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .hike-well {
      padding: 20px;
    }
  }

  @media (min-width: 1024px) {
    .hike-studio {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      gap: 34px;
    }

    .hike-route {
      padding: 0 0 0 26px;
      border-top: 0;
      border-left: 1px solid var(--rule);
    }

    .hike-points {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>

<style is:global>
  /* The itinerary tags and terrain sliders are built at runtime by
     src/lib/hobbies/hiking.ts, so Astro's scoped attribute never reaches
     them. Global, but only inside the hike builder. */
  [data-pixel-hike] .hike-tag {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border: 1px solid var(--rule);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 12px;
    line-height: 18px;
    cursor: pointer;
    transition: border-color 150ms var(--ease);
  }

  /* The tag stays small; its target grows to 32px. */
  [data-pixel-hike] .hike-tag::before {
    content: "";
    position: absolute;
    inset: -4px 0;
  }

  [data-pixel-hike] .hike-tag:hover {
    border-color: var(--ink);
  }

  [data-pixel-hike] .hike-tag-x {
    color: var(--ink-2);
  }

  [data-pixel-hike] .hike-empty {
    font-size: 12px;
    color: var(--ink-2);
  }

  [data-pixel-hike] .hike-point {
    display: grid;
    min-width: 0;
    font-size: 11px;
    line-height: 1.4;
    color: var(--ink-2);
  }

  /* 32px tall for touch; the track stays centred in the box. */
  [data-pixel-hike] .hike-point > input {
    width: 100%;
    height: 32px;
    margin: 0;
    accent-color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-pixel-hike] .hike-tag {
      transition: none;
    }
  }
</style>

<script>
  import { initHikeBuilder } from "@/lib/hobbies/hiking";
  import { initAllUnderlineTabs } from "@/lib/motion";

  document
    .querySelectorAll<HTMLElement>("[data-pixel-hike]")
    .forEach((root) => {
