---
import { Picture, getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { sessionSlug, splitSessionTitle } from "@/lib/sessions";

const sessionImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/sessions/**/images/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);

/** How many photographs you can thumb through on a card. */
const SKIM = 8;

interface Props {
  entry: CollectionEntry<"sessions">;
  cover: ImageMetadata;
  /** Reserve eager loading for the cards above the fold. */
  priority?: boolean;
}

const { entry, cover, priority = false } = Astro.props;
const slug = sessionSlug(entry);
const { title, location, images } = entry.data;
const count = images.length;

/* The card shows the place and moves the period into the line underneath, so
   neither is printed twice. */
const { label, period } = splitSessionTitle(title);

/* The session's first photographs, in the order the session page shows them,
   small: pointing across the card thumbs through them. Nothing loads until
   someone points. */
const skim = (
  await Promise.all(
    images.slice(0, SKIM).map(async (image) => {
      const mod =
        sessionImages[`/src/content/sessions/${slug}/images/${image.file}`];
      if (!mod) return null;
      const small = await getImage({
        src: mod.default,
        width: 480,
        format: "webp",
      });
      return small.src;
    }),
  )
).filter((src): src is string => Boolean(src));
---

<a
  class="card"
  href={`/sessions/${slug}/`}
  data-session-card
  data-open="session"
  data-location={location ?? ""}
  data-note={`${count} photograph${count === 1 ? "" : "s"}`}
  data-skim={skim.length > 1 ? JSON.stringify(skim) : undefined}
>
  <span class="shotwrap">
    <i class="s1" aria-hidden="true"></i>
    <i class="s2" aria-hidden="true"></i>
    <span class="shot">
      <Picture
        src={cover}
        alt={`${label} — cover photograph`}
        widths={[320, 480, 640, 960]}
        sizes="(min-width: 1300px) 24vw, (min-width: 900px) 30vw, 44vw"
        formats={["webp"]}
        fallbackFormat="jpeg"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        class="shot-img"
      />
      {
        skim.length > 1 && (
          <>
            <img class="skim-frame" alt="" decoding="async" hidden />
            <span class="skim" aria-hidden="true">
              <b />
            </span>
          </>
        )
      }
      <span class="n">{count}</span>
    </span>
  </span>
  <span class="t">{label}</span>
  <span class="m">
    {period && <span class="dt">{period} · </span>}
    {count} photograph{count === 1 ? "" : "s"}
  </span>
</a>

<style>
  /* Every card is the same size and the same click target. The cover is
     cropped to 4:3 on purpose: a uniform grid of collections reads as
     something to open, which a ragged wall of uncropped pictures does not. */
  .card {
    display: block;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }
  .card:hover {
    text-decoration: none;
  }

  .shotwrap {
    position: relative;
    display: block;
  }
  /* Two sheets of paper behind the cover, so a card reads as a stack of
     photographs rather than a single picture. */
  .shotwrap i {
    position: absolute;
    inset: 0;
    display: block;
    transition: transform 260ms ease;
  }
  .shotwrap i.s1 {
    background: var(--stack-1);
    transform: translate(8px, 8px);
  }
  .shotwrap i.s2 {
    background: var(--stack-2);
    transform: translate(4px, 4px);
  }
  .card:hover .shotwrap i.s1 {
    transform: translate(11px, 11px);
  }
  .card:hover .shotwrap i.s2 {
    transform: translate(5.5px, 5.5px);
  }

  .shot {
    position: relative;
    display: block;
  }
  .shot :global(.shot-img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--band);
    display: block;
  }
  /* While you thumb through a session, its photographs sit over the cover and
     a 2px rule along the bottom shows how far into the stack you are. */
  .skim-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .skim-frame[hidden] {
    display: none;
  }
  .skim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    pointer-events: none;
  }
  .skim b {
    position: absolute;
    inset: 0;
    background: var(--paper);
    transform: scaleX(0);
    transform-origin: left;
  }
  .n {
    position: absolute;
    right: 0;
    bottom: 0;
    background: var(--ink);
    color: var(--paper);
    font-size: 10px;
    letter-spacing: 0.14em;
    padding: 4px 8px;
  }

  .t {
    display: block;
    margin-top: 11px;
    font-size: 15px;
    line-height: 1.3;
    color: var(--ink);
  }
  .card:hover .t {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .m {
    display: block;
    margin-top: 2px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  @media (max-width: 899px) {
    .t {
      font-size: 14px;
    }
    .m .dt {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shotwrap i {
      transition: none;
    }
  }
</style>

<script>
  /* Thumb through a session from its card: pointing across the cover shows
     its first photographs in order, like flicking through a stack of prints.
     Mouse only; a tap or a click opens the session as before. */
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

  document
    .querySelectorAll<HTMLAnchorElement>("[data-skim]")
    .forEach((card) => {
      const shot = card.querySelector<HTMLElement>(".shot");
      const frame = shot?.querySelector<HTMLImageElement>(".skim-frame");
      const fill = shot?.querySelector<HTMLElement>(".skim > b");
      let frames: string[] = [];
      try {
        frames = JSON.parse(card.dataset.skim ?? "[]");
      } catch {
        frames = [];
      }
      if (!shot || !frame || !fill || frames.length < 2) return;

      let warmed = false;
      let at = -1;
      const isMouse = (event: PointerEvent) =>
        event.pointerType === "mouse" && finePointer.matches;

      shot.addEventListener("pointerenter", (event) => {
        if (!isMouse(event) || warmed) return;
        warmed = true;
        for (const src of frames) {
          const preload = new Image();
          preload.decoding = "async";
          preload.src = src;
        }
      });

      shot.addEventListener("pointermove", (event) => {
        if (!isMouse(event)) return;
        const box = shot.getBoundingClientRect();
        const index = Math.min(
          frames.length - 1,
          Math.max(
            0,
            Math.floor(
              ((event.clientX - box.left) / box.width) * frames.length,
            ),
          ),
        );
        if (index === at) return;
        at = index;
        frame.src = frames[index];
        frame.hidden = false;
        fill.style.transform = `scaleX(${(index + 1) / frames.length})`;
      });

      shot.addEventListener("pointerleave", () => {
        at = -1;
        frame.hidden = true;
        fill.style.transform = "scaleX(0)";
      });
    });
</script>
