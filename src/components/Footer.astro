---
import { copyrightLine } from '@/lib/sessions';
import { PRINTS_PATH } from '@/lib/prints';
import { siteConfig } from '../../site.config';
import { instagramUrl } from '@/lib/instagram';

const instagram = instagramUrl();
---

{
  /* pb-24 leaves room under the links for the fixed mail button, which would
     otherwise sit on top of them once you reach the bottom of a page. */
}
<footer class="mt-16 border-t border-rule pb-24 pt-8 text-sm text-ink-2">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 sm:px-6">
    <p>{copyrightLine()}</p>
    <div class="flex flex-wrap gap-x-5 gap-y-2">
      {
        siteConfig.prints && (
          <a href={PRINTS_PATH} class="draw text-ink-2 no-underline hover:text-ink">
            Prints
          </a>
        )
      }
      <a href="/privacy/" class="draw text-ink-2 no-underline hover:text-ink">Privacy</a>
      {
        instagram && (
          <a
            href={instagram}
            target="_blank"
            rel="me noopener noreferrer"
            class="draw text-ink-2 no-underline hover:text-ink"
          >Instagram</a>
        )
      }
      <a
        href="https://github.com/TrumanBrown/photography-website"
        target="_blank"
        rel="noopener noreferrer"
        class="draw text-ink-2 no-underline hover:text-ink"
      >How this site is built</a>
    </div>
  </div>
</footer>
