---
import { siteConfig } from "../../site.config";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** Active top-level section, for nav highlight + which chrome to show. */
  section?: "photography" | "hobbies";
}

const { section = "photography" } = Astro.props;
// Each link is a 24px row (WCAG 2.5.8) and, from 360px up, one line. Below
// md the theme word sits beside the name, which leaves the nav row room for
// its three links.
const linkBase =
  "inline-flex min-h-6 items-center no-underline hover:underline min-[360px]:whitespace-nowrap";
const activeClass = "text-ink";
const idleClass = "text-ink-2 hover:text-ink";
---

<header class="site-header border-b" style="border-color: var(--rule)">
  <div
    class="mx-auto max-w-6xl px-4 py-2 sm:px-6 md:flex md:items-center md:justify-between md:gap-4 md:py-4"
  >
    <div
      class="flex min-w-0 items-center justify-between gap-2 md:justify-start"
    >
      {
        section === "photography" && (
          <button
            id="session-nav-open"
            type="button"
            class="rounded p-1 text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-900 lg:hidden"
            aria-label="Open sessions navigation"
            aria-controls="session-nav"
            aria-expanded="false"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M3 6h18M3 12h18M3 18h18" />
            </svg>
          </button>
        )
      }
      <a
        href="/"
        data-open="page"
        class="truncate text-[11px] uppercase tracking-[0.18em] no-underline hover:opacity-80"
      >
        {siteConfig.ownerName}
      </a>
      <ThemeToggle class="min-h-6 md:hidden" />
    </div>
    <nav
      aria-label="Primary"
      class="mt-2 flex items-center justify-between gap-3 border-t pt-2 text-[11px] uppercase tracking-[0.16em] max-[419px]:tracking-[0.12em] md:mt-0 md:shrink-0 md:justify-end md:gap-5 md:border-0 md:pt-0"
      style="border-color: var(--rule)"
    >
      <a
        href="/photographs/"
        data-open="page"
        class:list={[
          linkBase,
          section === "photography" ? activeClass : idleClass,
        ]}
        aria-current={section === "photography" ? "page" : undefined}
        >Photographs</a
      >
      {
        siteConfig.sections.hobbies && (
          <a
            href="/hobbies/"
            class:list={[
              linkBase,
              section === "hobbies" ? activeClass : idleClass,
            ]}
            aria-current={section === "hobbies" ? "page" : undefined}
          >
            Things to try
          </a>
        )
      }
      <a href="/#weekdays" data-open="page" class:list={[linkBase, idleClass]}
        >About me</a
      >
      <ThemeToggle class="hidden min-h-6 md:inline-block" />
    </nav>
  </div>
</header>
