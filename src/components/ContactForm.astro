---
/**
 * "Write to me": a drawer from the right, opened by any [data-contact-open]
 * (the footer, the rails, the Weekdays side, /prints) or the contact:open
 * event (the lightbox's Prints button), either of which can start the
 * message. Posts to /api/contact, which keeps the message in Table Storage
 * and emails me a copy. A hidden "website" field catches bots.
 */
---

<div class="cf-scrim" id="contact-backdrop" aria-hidden="true"></div>

<aside
  id="contact-drawer"
  class="cf"
  role="dialog"
  aria-labelledby="contact-title"
  aria-modal="true"
  inert
>
  <div class="cf-head">
    <h2 id="contact-title">Write to me</h2>
    <button id="contact-close" type="button" class="linkbtn draw cf-close">
      <span>Back to the page</span>
    </button>
  </div>
  <p class="cf-lede">
    About my work or projects, a print, or a photo you'd like to use. I'll get
    back to you soon.
  </p>

  <form id="contact-form" action="/api/contact" method="POST" class="cf-form">
    <div class="cf-trap" aria-hidden="true">
      <label for="website">Website</label>
      <input
        type="text"
        id="website"
        name="website"
        tabindex="-1"
        autocomplete="off"
      />
    </div>
    <input type="hidden" name="page" id="contact-page" value="" />

    <label class="cf-field" for="contact-name">
      <span class="u-label">Name</span>
      <input
        type="text"
        id="contact-name"
        name="name"
        autocomplete="name"
        required
        maxlength="200"
      />
    </label>

    <label class="cf-field" for="contact-email">
      <span class="u-label">Email</span>
      <input
        type="email"
        id="contact-email"
        name="email"
        autocomplete="email"
        spellcheck="false"
        required
        maxlength="254"
      />
    </label>

    <label class="cf-field" for="contact-message">
      <span class="u-label">Message</span>
      <textarea
        id="contact-message"
        name="message"
        required
        maxlength="5000"
        rows="7"></textarea>
    </label>
    <p class="u-label tabular-nums cf-count">
      <span id="char-count">0</span> / 5,000
    </p>

    <div class="cf-send">
      <p id="contact-feedback" class="cf-status" role="status"></p>
      <button type="submit" class="btn btn-ink">Send message</button>
    </div>

    <p class="cf-privacy">
      I only use your email to reply, and it's never passed on.
      <a href="/privacy/" class="draw">Privacy</a>
    </p>
  </form>
</aside>

<style>
  .cf-scrim {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: color-mix(in srgb, var(--ink) 30%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms var(--ease);
  }
  .cf-scrim.on {
    opacity: 1;
    pointer-events: auto;
  }
  .cf {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 91;
    width: min(440px, 100%);
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 22px 26px 28px;
    overflow-y: auto;
    background: var(--paper);
    border-left: 1px solid var(--rule);
    transform: translateX(100%);
    visibility: hidden;
    transition:
      transform 260ms var(--ease),
      visibility 0s linear 260ms;
  }
  .cf.on {
    transform: none;
    visibility: visible;
    transition: transform 260ms var(--ease);
  }
  .cf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .cf-head h2 {
    margin: 0;
    font-size: 19px;
    font-weight: 300;
    line-height: 1.25;
    color: var(--ink);
  }
  .cf-close {
    font-size: 13px;
    color: var(--ink-2);
  }
  .cf-close:hover {
    color: var(--ink);
  }
  .cf-lede {
    margin: 0;
    max-width: 44ch;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-3);
  }
  .cf-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cf-trap {
    position: absolute;
    left: -9999px;
  }
  .cf-field {
    display: block;
  }
  .cf-field .u-label {
    display: block;
    margin-bottom: 2px;
  }
  .cf-field input,
  .cf-field textarea {
    display: block;
    width: 100%;
    padding: 6px 0;
    border: 0;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
    line-height: 1.5;
    resize: vertical;
  }
  .cf-field input:focus,
  .cf-field textarea:focus {
    outline: none;
    box-shadow: none;
    border-color: var(--ink);
  }
  .cf-count {
    margin: -8px 0 0;
    text-align: right;
  }
  .cf-send {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .cf-status {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    color: var(--ink);
  }
  .cf-privacy {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .cf-privacy a {
    color: var(--ink-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .cf,
    .cf.on,
    .cf-scrim {
      transition: none;
    }
  }
</style>

<script>
  const drawer = document.getElementById("contact-drawer")!;
  const backdrop = document.getElementById("contact-backdrop")!;
  const closeBtn = document.getElementById("contact-close")!;
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const feedback = document.getElementById("contact-feedback")!;
  const charCount = document.getElementById("char-count")!;
  const messageField = document.getElementById(
    "contact-message",
  ) as HTMLTextAreaElement;
  const pageField = document.getElementById("contact-page") as HTMLInputElement;
  const pageShell = document.getElementById("page-shell");

  let isOpen = false;
  let opener: HTMLElement | null = null;
  let previousBodyOverflow = "";

  function focusableElements(): HTMLElement[] {
    return Array.from(
      drawer.querySelectorAll<HTMLElement>(
        'button:not([disabled]):not([tabindex="-1"]), input:not([disabled]):not([type="hidden"]):not([tabindex="-1"]), textarea:not([disabled]):not([tabindex="-1"]), a[href]:not([tabindex="-1"])',
      ),
    ).filter((element) => !element.closest('[aria-hidden="true"]'));
  }

  function openDrawer() {
    if (isOpen) return;
    isOpen = true;
    opener =
      document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;
    previousBodyOverflow = document.body.style.overflow;
    pageField.value = window.location.pathname + window.location.hash;
    drawer.removeAttribute("inert");
    pageShell?.setAttribute("inert", "");
    drawer.classList.add("on");
    backdrop.classList.add("on");
    document.body.style.overflow = "hidden";
    document.getElementById("contact-name")?.focus();
  }

  function closeDrawer() {
    if (!isOpen) return;
    isOpen = false;
    drawer.classList.remove("on");
    backdrop.classList.remove("on");
    document.body.style.overflow = previousBodyOverflow;
    pageShell?.removeAttribute("inert");
    drawer.setAttribute("inert", "");
    opener?.focus();
  }

  closeBtn.addEventListener("click", closeDrawer);
  backdrop.addEventListener("click", closeDrawer);

  /* Other parts of the page can open the form with a message already started:
     the lightbox's Prints button names the photo, and buttons on /prints carry
     data-contact-message. A prefill never replaces something the visitor typed. */
  let lastPrefill = "";
  function openWithMessage(message?: string) {
    const current = messageField.value.trim();
    if (message && (current === "" || current === lastPrefill.trim())) {
      messageField.value = message;
      lastPrefill = message;
      charCount.textContent = String(messageField.value.length);
    }
    openDrawer();
  }
  window.addEventListener("contact:open", (event) => {
    openWithMessage(
      (event as CustomEvent<{ message?: string }>).detail?.message,
    );
  });
  document.addEventListener("click", (event) => {
    const trigger = (event.target as Element | null)?.closest<HTMLElement>(
      "[data-contact-open]",
    );
    if (!trigger) return;
    event.preventDefault();
    openWithMessage(trigger.dataset.contactMessage);
  });

  document.addEventListener("keydown", (e) => {
    if (!isOpen) return;
    if (e.key === "Escape") {
      e.preventDefault();
      closeDrawer();
      return;
    }
    if (e.key !== "Tab") return;
    const focusable = focusableElements();
    if (focusable.length === 0) {
      e.preventDefault();
      return;
    }
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (
      e.shiftKey &&
      (document.activeElement === first ||
        !drawer.contains(document.activeElement))
    ) {
      e.preventDefault();
      last.focus();
    } else if (
      !e.shiftKey &&
      (document.activeElement === last ||
        !drawer.contains(document.activeElement))
    ) {
      e.preventDefault();
      first.focus();
    }
  });

  messageField.addEventListener("input", () => {
    charCount.textContent = String(messageField.value.length);
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    feedback.textContent = "";

    const btn = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = "Sending...";

    try {
      const data = Object.fromEntries(new FormData(form));
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
        // A cold API takes a few seconds. Past this, say so instead of
        // leaving the button on Sending... for good.
        signal: AbortSignal.timeout(20_000),
      });
      const json = await res.json();

      if (json.ok) {
        feedback.textContent = "Message sent. Thank you!";
        form.reset();
        charCount.textContent = "0";
        lastPrefill = "";
      } else {
        feedback.textContent =
          json.errors?.join(" ") ??
          "Failed to send message. Please try again later.";
      }
    } catch {
      feedback.textContent = "Network error. Please try again.";
    } finally {
      btn.disabled = false;
      btn.textContent = originalText;
    }
  });
</script>
