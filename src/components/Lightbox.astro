---
/**
 * Lightbox wrapper. Initializes PhotoSwipe v5 against any element with the
 * given selector. Place once per page that needs a lightbox.
 *
 * The DOM contract: each gallery item must be an <a> with
 *   href={displayUrl}
 *   data-pswp-width={intrinsicWidth}
 *   data-pswp-height={intrinsicHeight}
 *   data-pswp-caption={optional caption}
 * and contain a thumbnail <img> child.
 *
 * Optionally, when href points at a size-capped copy rather than the original:
 *   data-pswp-full={originalUrl}
 * The width/height above must then describe the original. The capped copy is
 * only a first paint: the lightbox swaps the original in as soon as it has
 * loaded, and the download button always uses data-pswp-full.
 */
interface Props {
  /** CSS selector for the gallery container. Defaults to `#gallery`. */
  gallerySelector?: string;
}

const { gallerySelector = "#gallery" } = Astro.props;
---

<script>
  // @ts-ignore - photoswipe ships its own types under subpaths
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  // Read the per-page selector from the marker element below.
  const marker = document.querySelector<HTMLElement>("[data-lightbox-marker]");
  const selector = marker?.dataset.gallery ?? "#gallery";
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  /* A photograph grows out of its own spot in the grid and shrinks back into
     it on close, so you can see where it came from. Thumbnails cropped by
     object-fit (the fishing catches) are marked, so PhotoSwipe animates the
     crop instead of a squashed box. Reduced motion keeps an instant fade. */
  document
    .querySelectorAll<HTMLAnchorElement>(`${selector} a`)
    .forEach((anchor) => {
      const thumb = anchor.querySelector("img");
      if (thumb && getComputedStyle(thumb).objectFit === "cover") {
        anchor.dataset.cropped = "true";
      }
    });

  const lightbox = new PhotoSwipeLightbox({
    gallery: selector,
    children: "a",
    pswpModule: () => import("photoswipe"),
    showHideAnimationType: reduceMotion ? "fade" : "zoom",
    showAnimationDuration: reduceMotion ? 0 : 300,
    hideAnimationDuration: reduceMotion ? 0 : 250,
    bgOpacity: 0.95,
    // Fetch a couple of neighbours ahead so moving through a session doesn't
    // wait on the network at every step. These are the size-capped copies, not
    // the originals, so looking past a photograph stays cheap.
    preload: [1, 2],
  });

  /* PhotoSwipe only reuses the gallery thumbnail as a placeholder on the first
     slide. The thumbnails are already decoded in the grid behind the lightbox,
     so letting every slide use one costs nothing and means a photograph is on
     screen the instant it is opened rather than after a round trip. */
  lightbox.addFilter("placeholderSrc", (src: string | false, content: any) => {
    return content?.data?.msrc || src;
  });

  lightbox.on("uiRegister", function () {
    /* Each photograph has its own address (#photo-12), so the link copied
       here opens straight onto it. On a phone with a share sheet this is
       "Share"; elsewhere it copies the link. */
    const canShare =
      typeof navigator.share === "function" &&
      window.matchMedia("(pointer: coarse)").matches;
    // Screen readers don't reliably read a focused button's new text, so the
    // result is also spoken through this hidden status line.
    let linkStatus: HTMLElement | null = null;
    lightbox.pswp?.ui?.registerElement({
      name: "link-status",
      order: 7,
      tagName: "span",
      onInit: (el) => {
        el.setAttribute("role", "status");
        linkStatus = el;
      },
    });
    lightbox.pswp?.ui?.registerElement({
      name: "link-button",
      order: 7,
      isButton: true,
      tagName: "button",
      html: canShare ? "Share" : "Copy link",
      onInit: (el) => {
        el.setAttribute(
          "title",
          canShare ? "Share this photograph" : "Copy a link to this photograph",
        );
        let reset: number | undefined;
        const say = (text: string) => {
          el.textContent = text;
          if (linkStatus) linkStatus.textContent = text;
          window.clearTimeout(reset);
          reset = window.setTimeout(() => {
            el.textContent = canShare ? "Share" : "Copy link";
            if (linkStatus) linkStatus.textContent = "";
          }, 1600);
        };
        el.addEventListener("click", async () => {
          const url = window.location.href;
          if (canShare) {
            try {
              await navigator.share({ url, title: document.title });
            } catch {
              // Closing the share sheet isn't an error worth reporting.
            }
            return;
          }
          try {
            await navigator.clipboard.writeText(url);
            say("Link copied");
          } catch {
            say("Couldn't copy");
          }
        });
      },
    });

    // Download full-resolution button in the top toolbar.
    lightbox.pswp?.ui?.registerElement({
      name: "download-button",
      order: 8,
      isButton: true,
      tagName: "button",
      html: '<svg aria-hidden="true" class="pswp__icn" viewBox="0 0 32 32" width="32" height="32"><path fill="currentColor" d="M16 19l-6-6h4V5h4v8h4l-6 6zm-7 4h14v2H9z"/></svg>',
      onInit: (el, instance) => {
        el.setAttribute("title", "Download full-resolution photo");
        el.setAttribute("aria-label", "Download full-resolution photo");
        el.addEventListener("click", async () => {
          const slideEl = instance.currSlide?.data?.element as
            | HTMLElement
            | undefined;
          // The anchor points at a size-capped view so the lightbox opens
          // quickly; the download button still hands over the original.
          const url =
            slideEl?.dataset?.pswpFull || slideEl?.getAttribute("href");
          if (!url) return;
          const name =
            slideEl?.dataset?.pswpFilename ||
            url.split("/").pop()?.split("?")[0] ||
            "photo.jpg";
          const btn = el as HTMLButtonElement;
          btn.disabled = true;
          try {
            const res = await fetch(url);
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const blob = await res.blob();
            const objUrl = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = objUrl;
            a.download = name;
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(objUrl);
          } catch {
            // Cross-origin fetch blocked or failed — open in a new tab so the
            // viewer can still save the file manually.
            window.open(url, "_blank", "noopener");
          } finally {
            btn.disabled = false;
          }
        });
      },
    });

    // Caption + EXIF capture settings beneath the photo.
    lightbox.pswp?.ui?.registerElement({
      name: "caption",
      order: 9,
      isButton: false,
      appendTo: "root",
      html: "",
      onInit: (el, instance) => {
        instance.on("change", () => {
          const slideEl = instance.currSlide?.data?.element as
            | HTMLElement
            | undefined;
          const caption = slideEl?.dataset?.pswpCaption ?? "";
          const exif = slideEl?.dataset?.pswpExif ?? "";
          // Build via textContent (not innerHTML) so caption/EXIF strings can
          // never inject markup.
          el.textContent = "";
          if (caption) {
            const c = document.createElement("span");
            c.className = "pswp__caption-text";
            c.textContent = caption;
            el.appendChild(c);
          }
          if (exif) {
            const e = document.createElement("span");
            e.className = "pswp__caption-exif";
            e.textContent = exif;
            el.appendChild(e);
          }
        });
      },
    });
  });

  /* Photographs are what this site is for, so the lightbox always ends up
     showing the untouched original, on every connection and with no exception. The anchor points at a size-capped WebP
     only so something appears instantly instead of waiting on a 6-9 MB file;
     the original is fetched straight afterwards and swapped in underneath the
     viewer. Dimensions declared to PhotoSwipe are the original's, so zoom
     reaches true 100% rather than stopping at the stand-in's size.

     Only the photograph actually on screen is upgraded. Neighbours stay on the
     cheap version until you reach them, so flicking through a session doesn't
     queue up tens of megabytes you never look at. */
  const upgrading = new WeakSet<HTMLElement>();

  function upgradeToOriginal(pswp: any) {
    const slide = pswp?.currSlide;
    const anchor = slide?.data?.element as HTMLElement | undefined;
    const img = slide?.content?.element as HTMLImageElement | undefined;
    if (!anchor || !img || upgrading.has(anchor)) return;

    const full = anchor.dataset.pswpFull;
    // Galleries that already link the original have nothing to upgrade to.
    if (!full || img.src === full) return;

    upgrading.add(anchor);
    const original = new Image();
    original.decoding = "async";
    original.onload = () => {
      // Decode before swapping so the visible image never flashes blank.
      const swap = () => {
        img.src = full;
        img.srcset = "";
      };
      if (original.decode) original.decode().then(swap, swap);
      else swap();
    };
    original.onerror = () => {
      // Leave the stand-in on screen rather than breaking the slide.
      upgrading.delete(anchor);
    };
    original.src = full;
  }

  lightbox.on("afterInit", () => {
    const pswp = lightbox.pswp;
    if (!pswp) return;
    const run = () => upgradeToOriginal(pswp);
    run();
    pswp.on("change", run);
  });

  /* The address follows the photograph on screen. replaceState, not
     pushState, so Back leaves the page instead of stepping through photos. */
  const PHOTO_HASH = /^#photo-(\d+)$/;
  lightbox.on("change", () => {
    const index = lightbox.pswp?.currIndex;
    if (typeof index !== "number") return;
    history.replaceState(history.state, "", `#photo-${index + 1}`);
  });
  lightbox.on("close", () => {
    if (PHOTO_HASH.test(window.location.hash)) {
      history.replaceState(
        history.state,
        "",
        window.location.pathname + window.location.search,
      );
    }
  });

  lightbox.init();

  // A link to one photograph opens the page with it already up.
  const linked = PHOTO_HASH.exec(window.location.hash);
  if (linked) {
    const count = document.querySelectorAll(`${selector} a`).length;
    const index = Number(linked[1]) - 1;
    if (index >= 0 && index < count) lightbox.loadAndOpen(index);
  }
</script>

<span data-lightbox-marker data-gallery={gallerySelector} hidden></span>

<style is:global>
  .pswp__caption {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    color: #f5f5f5;
    font-size: 0.875rem;
    padding: 0.3rem 0.75rem;
    background: rgba(0, 0, 0, 0.55);
    max-width: 90vw;
    text-align: center;
    pointer-events: none;
  }

  /* A word, not an icon, in the toolbar's own colour and size. */
  .pswp__button--link-button {
    width: auto;
    padding: 0 12px;
    font: inherit;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--pswp-icon-color);
  }
  .pswp__button--link-button:hover {
    color: #fff;
  }
  .pswp__link-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .pswp__caption:empty {
    display: none;
  }

  .pswp__caption-exif {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    color: #cfcfcf;
  }
</style>
