---
/**
 * The three side projects on the front door's Weekdays side, side by side in
 * one row, each with something live rather than a screenshot:
 * - trumanbrown.com: the newest session's header photograph, opening it.
 * - cozy-vibe-vids: one of the videos, which loads from YouTube's
 *   privacy-enhanced player only when someone presses play.
 * - balcFlights-LED: the panel's radar, drawn live from the same flight API
 *   (src/lib/led-radar.ts), or its sample when the feed has no planes.
 *
 * Every picture is the same 3:2 frame, and the line under each name uses the
 * Work rows' org line, so the dates read the same as the jobs above. On a
 * phone the three slide sideways with the next one showing at the edge, and
 * a count, a 1px progress rule and arrows under them say there's more.
 */
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import poster from "@/assets/about/cozy-critter.jpg";
import { COZY_VIDEO, monthLabel, PROJECTS } from "@/lib/about";
import { projectName } from "@/lib/track-names";
import { sortSessions, sessionSlug, splitSessionTitle } from "@/lib/sessions";
import { coverFileOf } from "@/lib/archive";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/sessions/**/images/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);

const sessions = sortSessions(await getCollection("sessions"));

/* The newest session's header photograph, chosen the way its page chooses
   its banner: the header picked in the admin panel, else the cover when it's
   wide enough, else the session's widest photograph. Never just its first
   photograph. */
const BANNER_MIN_RATIO = 1.2;
const newest = sessions[0];
const ratio = (i: { width: number; height: number }) => i.width / i.height;
const cover = newest?.data.images.find((i) => i.file === coverFileOf(newest));
const pick = newest
  ? (newest.data.images.find((i) => i.file === newest.data.banner) ??
    (cover && ratio(cover) >= BANNER_MIN_RATIO
      ? cover
      : newest.data.images.reduce((a, b) => (ratio(b) > ratio(a) ? b : a))))
  : undefined;
const pickFocus = newest?.data.bannerFocus;
const pickImage =
  newest && pick
    ? images[`/src/content/sessions/${sessionSlug(newest)}/images/${pick.file}`]
        ?.default
    : undefined;
const pickLabel = newest ? splitSessionTitle(newest.data.title).label : "";

const watchUrl = `https://www.youtube.com/watch?v=${COZY_VIDEO.youtubeId}`;
const SIZES = "(min-width: 900px) 360px, min(80vw, 340px)";
---

<section
  class="wsec"
  aria-labelledby="projects-h"
  data-track-section="projects"
>
  <div class="shead">
    <h2 id="projects-h">Side projects</h2>
    <a
      class="shead-link draw"
      href="https://github.com/TrumanBrown"
      target="_blank"
      rel="noopener noreferrer"
      data-track="github-profile">More on GitHub ↗</a
    >
  </div>
  <div class="slide" data-projs>
    <ul class="projs" data-projs-list>
      {
        PROJECTS.map((project) => (
          <li
            class="proj"
            data-track-section={projectName(project)}
            data-led-radar={project.media === "radar" ? "" : undefined}
            data-project-video={project.media === "video" ? "" : undefined}
            data-youtube-id={
              project.media === "video" ? COZY_VIDEO.youtubeId : undefined
            }
            data-title={
              project.media === "video" ? COZY_VIDEO.title : undefined
            }
          >
            <div class:list={["pic", `pic-${project.media}`]}>
              {project.media === "site" && newest && pickImage && (
                <a
                  class="pic-a"
                  href={`/sessions/${sessionSlug(newest)}/`}
                  data-open="session"
                  data-track={projectName(project, "session")}
                  aria-label={`Open the newest session, ${pickLabel}`}
                >
                  <Picture
                    src={pickImage}
                    alt={
                      pick?.alt ||
                      pick?.caption ||
                      `${pickLabel} header photograph`
                    }
                    widths={[480, 720, 960]}
                    sizes={SIZES}
                    formats={["webp"]}
                    fallbackFormat="jpeg"
                    loading="lazy"
                    style={
                      pickFocus ? `object-position:${pickFocus}` : undefined
                    }
                  />
                </a>
              )}
              {project.media === "video" && (
                <div class="pic-frame" data-project-video-frame>
                  <a
                    class="pic-a"
                    href={watchUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-project-video-play
                    data-track={projectName(project, "play")}
                    aria-label={`Play ${COZY_VIDEO.title}`}
                  >
                    <Picture
                      src={poster}
                      alt=""
                      widths={[480, 720, 960]}
                      sizes={SIZES}
                      formats={["webp"]}
                      fallbackFormat="jpeg"
                      loading="lazy"
                    />
                  </a>
                </div>
              )}
              {project.media === "radar" && (
                <canvas
                  width="320"
                  height="320"
                  role="img"
                  aria-label="A 64 by 64 LED radar of the planes over Seattle."
                />
              )}
            </div>
            <h3 class="proj-name">{project.name}</h3>
            <p class="proj-meta tabular-nums">
              {project.lang} · since {monthLabel(project.since)}
            </p>
            <p class="proj-blurb">{project.blurb}</p>
            {project.media === "radar" && <p class="sr-only" data-radar-says />}
            <p class="proj-links">
              {project.media === "video" && (
                <button
                  type="button"
                  class="linkbtn draw proj-play"
                  data-project-video-play
                  data-track={projectName(project, "play")}
                >
                  <span>Play</span>
                </button>
              )}
              {project.media === "radar" && (
                <button
                  type="button"
                  class="linkbtn draw"
                  data-radar-pause
                  data-track={projectName(project, "pause")}
                >
                  Pause
                </button>
              )}
              <a
                class="draw"
                href={`https://github.com/TrumanBrown/${project.repo}`}
                target="_blank"
                rel="noopener noreferrer"
                data-track={projectName(project, "code")}
              >
                Code on GitHub ↗
              </a>
              {project.media === "video" && (
                <a
                  class="draw"
                  href={watchUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track={projectName(project, "youtube")}
                >
                  YouTube ↗
                </a>
              )}
              {project.media === "radar" && (
                <span class="u-label proj-state" data-radar-state>
                  Live
                </span>
              )}
            </p>
          </li>
        ))
      }
    </ul>
    <div
      class="slide-nav"
      role="group"
      aria-label="Move through the side projects"
    >
      <div class="hair" aria-hidden="true"><i data-projs-bar></i></div>
      <div class="slide-row">
        <span class="u-label tabular-nums" data-projs-count
          >1 / {PROJECTS.length}</span
        >
        <span class="slide-arrows">
          <button
            type="button"
            class="linkbtn"
            data-projs-step="-1"
            data-track="projects:prev"
            aria-label="Previous project"
            disabled>←</button
          >
          <button
            type="button"
            class="linkbtn"
            data-projs-step="1"
            data-track="projects:next"
            aria-label="Next project">→</button
          >
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .wsec {
    padding: 6vh var(--gutter) 0;
  }
  .shead {
    padding-bottom: 6px;
    border-bottom: 1px solid var(--rule);
  }

  /* Three across, one row, so the projects take less room than the work. */
  .projs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 22px 0 0;
  }
  .proj-name {
    margin: 12px 0 0;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--ink);
  }
  .proj-meta {
    margin: 3px 0 0;
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .proj-blurb {
    margin: 8px 0 0;
    max-width: 62ch;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-3);
  }
  .proj-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 20px;
    margin: 6px 0 0;
    font-size: 13px;
  }
  .proj-links a,
  .proj-links button {
    color: var(--ink);
  }
  .proj-links a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }
  .proj-state {
    margin-left: auto;
  }
  .proj.is-live .proj-play {
    display: none;
  }

  /* One frame for all three: 3:2, square corners, nothing laid over it. */
  .pic {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--band);
  }
  .pic-frame,
  .pic-a {
    display: block;
    width: 100%;
    height: 100%;
  }
  .pic :global(picture),
  .pic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pic :global(iframe) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }
  /* The panel is square, so it sits in the middle of a dark frame. */
  .pic-radar {
    background: #0b0b0a;
  }
  .pic-radar canvas {
    position: absolute;
    top: 0;
    left: 50%;
    display: block;
    height: 100%;
    width: auto;
    aspect-ratio: 1;
    transform: translateX(-50%);
    image-rendering: pixelated;
  }

  .slide-nav {
    display: none;
  }

  /* On a phone the cards slide sideways. The next one shows at the edge,
     and the count, the rule and the arrows under them say there's more. */
  @media (max-width: 899px) {
    .projs {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(80%, 340px);
      gap: 14px;
      margin: 0 calc(-1 * var(--gutter));
      padding: 18px var(--gutter) 2px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding: 0 var(--gutter);
      scrollbar-width: none;
      position: relative;
    }
    .projs::-webkit-scrollbar {
      display: none;
    }
    .proj {
      scroll-snap-align: start;
    }
    .slide-nav {
      display: block;
      margin-top: 14px;
    }
    .slide-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 4px;
    }
    .slide-arrows {
      display: flex;
      gap: 4px;
      margin-right: -10px;
    }
    .slide-arrows button {
      justify-content: center;
      min-width: 44px;
      min-height: 40px;
      font-size: 18px;
    }
  }
</style>

<script>
  import { initLedRadar } from "@/lib/led-radar";
  import { embedSrc } from "@/lib/hobbies/hobby-video";
  import { prefersReducedMotion, setHair } from "@/lib/motion";

  document
    .querySelectorAll<HTMLElement>("[data-led-radar]")
    .forEach(initLedRadar);

  /* Nothing loads from YouTube until someone presses play. Then the poster
     becomes the privacy-enhanced player, starting at the top. */
  document
    .querySelectorAll<HTMLElement>("[data-project-video]")
    .forEach((root) => {
      const frame = root.querySelector<HTMLElement>(
        "[data-project-video-frame]",
      );
      const id = root.dataset.youtubeId;
      if (!frame || !id) return;
      const play = (event: Event) => {
        const e = event as MouseEvent;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button > 0) return;
        event.preventDefault();
        if (root.classList.contains("is-live")) return;
        const iframe = document.createElement("iframe");
        iframe.src = embedSrc(id, {
          start: 0,
          autoplay: true,
          origin: window.location.origin,
        });
        iframe.title = root.dataset.title ?? "Video";
        iframe.allow =
          "autoplay; encrypted-media; picture-in-picture; fullscreen";
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        frame.replaceChildren(iframe);
        root.classList.add("is-live");
      };
      root
        .querySelectorAll("[data-project-video-play]")
        .forEach((el) => el.addEventListener("click", play));
    });

  /* The phone's slide: the count, the rule and the arrows follow the scroll.
     A second arrow press while one is still sliding aims one card further
     from where that slide was going, instead of stacking. */
  document.querySelectorAll<HTMLElement>("[data-projs]").forEach((root) => {
    const list = root.querySelector<HTMLElement>("[data-projs-list]");
    const count = root.querySelector<HTMLElement>("[data-projs-count]");
    const bar = root.querySelector<HTMLElement>("[data-projs-bar]");
    const steps = root.querySelectorAll<HTMLButtonElement>("[data-projs-step]");
    if (!list) return;
    const cards = [...list.children] as HTMLElement[];
    let aim = -1;
    let frame = 0;
    let settle = 0;

    const start = (i: number) =>
      cards[i].offsetLeft -
      parseFloat(getComputedStyle(list).scrollPaddingLeft || "0");
    const nearest = () => {
      let best = 0;
      cards.forEach((_, i) => {
        if (
          Math.abs(start(i) - list.scrollLeft) <
          Math.abs(start(best) - list.scrollLeft)
        )
          best = i;
      });
      return best;
    };
    const show = () => {
      frame = 0;
      const max = list.scrollWidth - list.clientWidth;
      const i = nearest();
      if (count) count.textContent = `${i + 1} / ${cards.length}`;
      if (bar)
        setHair(
          bar,
          max > 0 ? (list.scrollLeft + list.clientWidth) / list.scrollWidth : 1,
        );
      steps.forEach((b) => {
        b.disabled =
          Number(b.dataset.projsStep) < 0
            ? list.scrollLeft < 4
            : list.scrollLeft > max - 4;
      });
    };
    list.addEventListener(
      "scroll",
      () => {
        if (!frame) frame = requestAnimationFrame(show);
        clearTimeout(settle);
        settle = window.setTimeout(() => (aim = -1), 160);
      },
      { passive: true },
    );
    steps.forEach((b) =>
      b.addEventListener("click", () => {
        const from = aim >= 0 ? aim : nearest();
        aim = Math.max(
          0,
          Math.min(cards.length - 1, from + Number(b.dataset.projsStep)),
        );
        list.scrollTo({
          left: start(aim),
          behavior: prefersReducedMotion() ? "auto" : "smooth",
        });
      }),
    );
    new ResizeObserver(show).observe(list);
    show();
  });
</script>
