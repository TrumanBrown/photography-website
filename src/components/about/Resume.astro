---
/**
 * The resume on the front door's Weekdays side: work, school and skills, in
 * ruled rows, every line showing. The lines are the ones on my PDF
 * (src/lib/about.ts).
 */
import {
  firstYear,
  periodLabel,
  SCHOOL,
  SKILLS,
  SUMMARY,
  WORK,
  monthLabel,
} from "@/lib/about";
---

<section class="wsec" aria-labelledby="work-h">
  <div class="shead">
    <h2 id="work-h">Work</h2>
    <span class="u-label tabular-nums"
      >{WORK.length} roles since {firstYear(WORK)}</span
    >
  </div>
  <p class="summary">{SUMMARY}</p>
  <ul class="jobs">
    {
      WORK.map((job) => (
        <li class="job">
          <span class="u-label tabular-nums job-when">
            {periodLabel(job.from, job.to)}
          </span>
          <div class="job-body">
            <h3 class="job-role">{job.role}</h3>
            <p class="job-org">
              {job.org} · {job.where}
              {job.note && ` · ${job.note}`}
            </p>
            <ul class="job-lines">
              {job.lines.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<slot />

<section class="wsec" aria-labelledby="school-h">
  <div class="shead"><h2 id="school-h">School</h2></div>
  <ul class="jobs">
    <li class="job">
      <span class="u-label tabular-nums job-when"
        >{monthLabel(SCHOOL.when)}</span
      >
      <div class="job-body">
        <h3 class="job-role">{SCHOOL.degree}</h3>
        <p class="job-org">{SCHOOL.name}</p>
        <ul class="job-lines">{SCHOOL.lines.map((line) => <li>{line}</li>)}</ul>
      </div>
    </li>
  </ul>
</section>

<section class="wsec" aria-labelledby="skills-h">
  <div class="shead"><h2 id="skills-h">Skills</h2></div>
  <dl class="skills">
    {
      SKILLS.map(([label, list]) => (
        <>
          <dt class="u-label">{label}</dt>
          <dd>{list}</dd>
        </>
      ))
    }
  </dl>
</section>

<style>
  .wsec {
    padding: 6vh var(--gutter) 0;
  }
  .shead {
    padding-bottom: 6px;
    border-bottom: 1px solid var(--rule);
  }
  .summary {
    margin: 14px 0 0;
    max-width: 80ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-3);
  }
  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .job {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 4px 28px;
    padding: 22px 0;
    border-top: 1px solid var(--rule);
  }
  .job:first-child {
    border-top: 0;
  }
  .job-when {
    padding-top: 6px;
  }
  .job-role {
    margin: 0;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--ink);
  }
  .job-org {
    margin: 3px 0 0;
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .job-lines {
    margin: 10px 0 0;
    padding: 0 0 0 16px;
    list-style: disc;
    max-width: 88ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-3);
  }
  .job-lines li {
    margin: 5px 0;
  }
  .job-lines li::marker {
    color: var(--ink-2);
  }
  .skills {
    margin: 0;
    padding-top: 16px;
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 10px 28px;
    font-size: 15px;
    line-height: 1.6;
  }
  .skills dt {
    padding-top: 3px;
  }
  .skills dd {
    margin: 0;
    color: var(--ink-3);
    max-width: 88ch;
  }
  @media (max-width: 899px) {
    .job,
    .skills {
      grid-template-columns: 1fr;
    }
    .job-when {
      padding-top: 0;
    }
    .skills dd {
      margin-bottom: 6px;
    }
  }
</style>
