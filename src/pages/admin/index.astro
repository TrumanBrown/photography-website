---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Admin" noindex>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <!-- Sign-in screen (shown when not authenticated) -->
    <div id="admin-signin" class="hidden py-20 text-center">
      <h1 class="mb-3 text-2xl font-semibold tracking-tight">Session Manager</h1>
      <p class="mb-6 text-neutral-500 dark:text-neutral-400">Sign in with GitHub to manage your sessions.</p>
      <a
        href="/.auth/login/github?post_login_redirect_uri=/admin"
        class="inline-flex items-center gap-2 rounded-lg bg-neutral-900 px-6 py-3 text-sm font-medium text-white no-underline hover:bg-neutral-800 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-200"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        Sign in with GitHub
      </a>
    </div>

    <!-- Authenticated UI -->
    <div id="admin-authed" class="hidden">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="text-2xl font-semibold tracking-tight">Admin</h1>
        <div class="flex items-center gap-3 text-sm">
          <button
            id="rebuild-btn"
            type="button"
            class="rounded bg-neutral-900 px-3 py-1.5 text-white hover:bg-neutral-800 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-200"
          >Rebuild Site</button>
          <span id="admin-user" class="text-neutral-500 dark:text-neutral-400"></span>
          <a href="/.auth/logout?post_logout_redirect_uri=/admin" class="text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200">Sign out</a>
        </div>
      </div>

      <!-- Tabs -->
      <div
        class="mb-6 flex gap-1 border-b border-neutral-200 dark:border-neutral-800"
        role="tablist"
        aria-label="Admin views"
      >
        <button
          id="tab-sessions"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="panel-sessions"
          class="border-b-2 border-neutral-900 px-4 py-2 text-sm font-medium dark:border-white"
        >Sessions</button>
        <button
          id="tab-messages"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="panel-messages"
          tabindex="-1"
          class="border-b-2 border-transparent px-4 py-2 text-sm font-medium text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200"
        >Messages</button>
        <button
          id="tab-analytics"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="panel-analytics"
          tabindex="-1"
          class="border-b-2 border-transparent px-4 py-2 text-sm font-medium text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200"
        >Analytics</button>
      </div>

      <!-- Sessions panel -->
      <div id="panel-sessions" role="tabpanel" aria-labelledby="tab-sessions">
        <div id="admin-toolbar" class="mb-4 hidden flex-col gap-3 sm:flex-row sm:items-center">
          <div class="flex flex-1 flex-col gap-3 sm:flex-row">
            <label class="flex-1">
              <span class="sr-only">Search sessions</span>
              <input
                id="session-search"
                type="search"
                placeholder="Search by title, place, or date"
                class="w-full rounded border border-neutral-300 bg-white px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none dark:border-neutral-600 dark:bg-neutral-800"
              />
            </label>
            <label class="sm:w-56">
              <span class="sr-only">Filter sessions</span>
              <select
                id="session-filter"
                class="w-full rounded border border-neutral-300 bg-white px-3 py-2 text-sm dark:border-neutral-600 dark:bg-neutral-800"
              >
                <option value="all">All sessions</option>
                <option value="needs-work">Still unfinished</option>
                <option value="uncaptioned">Missing captions</option>
                <option value="rotation">In the home rotation</option>
              </select>
            </label>
          </div>
          <p id="session-count" class="text-sm tabular-nums text-neutral-500 dark:text-neutral-400"></p>
        </div>
        <div id="admin-loading" class="py-20 text-center text-neutral-500 dark:text-neutral-400">
          Loading sessions...
        </div>
        <div id="admin-error" class="hidden rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-800 dark:border-red-800 dark:bg-red-950 dark:text-red-300"></div>
        <ul id="admin-list" class="hidden space-y-3"></ul>
        <p id="admin-empty" class="hidden py-16 text-center text-neutral-500 dark:text-neutral-400"></p>
      </div>

      <!-- Messages panel -->
      <div id="panel-messages" class="hidden" role="tabpanel" aria-labelledby="tab-messages">
        <div id="messages-loading" class="py-20 text-center text-neutral-500 dark:text-neutral-400">
          Loading messages...
        </div>
        <div id="messages-error" class="hidden rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-800 dark:border-red-800 dark:bg-red-950 dark:text-red-300"></div>
        <ul id="messages-list" class="hidden space-y-3"></ul>
      </div>

      <!-- Analytics panel -->
      <div id="panel-analytics" class="hidden" role="tabpanel" aria-labelledby="tab-analytics">
        <div id="analytics-loading" class="py-20 text-center text-neutral-500 dark:text-neutral-400">
          Loading analytics...
        </div>
        <div id="analytics-error" class="hidden rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-800 dark:border-red-800 dark:bg-red-950 dark:text-red-300"></div>
        <div id="analytics-content" class="hidden space-y-8">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <h2 class="text-lg font-semibold">Traffic overview</h2>
              <p id="analytics-period" class="mt-1 text-sm text-neutral-500 dark:text-neutral-400"></p>
            </div>
            <label class="text-sm text-neutral-500 dark:text-neutral-400">
              Range:
              <select id="analytics-range" class="ml-2 rounded border border-neutral-300 bg-white px-2 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-800">
                <option value="7">Last 7 days</option>
                <option value="30" selected>Last 30 days</option>
                <option value="90">Last 90 days</option>
              </select>
            </label>
          </div>
          <div id="analytics-cards" class="grid grid-cols-2 gap-3 lg:grid-cols-4"></div>

          <section aria-labelledby="analytics-trend-title">
            <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
              <h3 id="analytics-trend-title" class="text-sm font-semibold">Traffic over time</h3>
              <div class="flex items-center gap-4 text-xs text-neutral-500 dark:text-neutral-400" aria-hidden="true">
                <span class="inline-flex items-center gap-1.5"><span class="h-0.5 w-5 bg-neutral-900 dark:bg-neutral-100"></span>Pageviews</span>
                <span class="inline-flex items-center gap-1.5"><span class="h-0.5 w-5 bg-teal-600 dark:bg-teal-400"></span>Daily visitors</span>
              </div>
            </div>
            <div id="analytics-chart-frame" class="relative overflow-hidden rounded border border-neutral-200 bg-white p-2 dark:border-neutral-700 dark:bg-neutral-950">
              <div
                id="analytics-tooltip"
                class="pointer-events-none absolute z-10 hidden min-w-40 rounded border border-neutral-200 bg-white px-3 py-2 text-xs shadow-lg dark:border-neutral-700 dark:bg-neutral-900"
                role="status"
                aria-live="polite"
              ></div>
              <div id="analytics-chart" class="overflow-x-auto"></div>
            </div>
          </section>

          <div id="analytics-quality" class="grid grid-cols-1 divide-y divide-neutral-200 border-y border-neutral-200 dark:divide-neutral-800 dark:border-neutral-800 sm:grid-cols-3 sm:divide-x sm:divide-y-0"></div>

          <section aria-labelledby="analytics-pages-title">
            <div class="mb-3">
              <h3 id="analytics-pages-title" class="text-sm font-semibold">Page performance</h3>
              <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">Views, audience, entry traffic, and measured engagement for every viewed route.</p>
            </div>
            <div class="overflow-x-auto rounded border border-neutral-200 dark:border-neutral-700">
              <table class="w-full min-w-[46rem] text-left text-sm">
                <thead class="bg-neutral-50 text-xs text-neutral-500 dark:bg-neutral-900 dark:text-neutral-400">
                  <tr>
                    <th scope="col" class="px-3 py-2 font-medium">Page</th>
                    <th scope="col" class="px-3 py-2 text-right font-medium">Views</th>
                    <th scope="col" class="px-3 py-2 text-right font-medium">Daily visitors</th>
                    <th scope="col" class="px-3 py-2 text-right font-medium">Entries</th>
                    <th scope="col" class="px-3 py-2 text-right font-medium">Avg. time</th>
                    <th scope="col" class="px-3 py-2 text-right font-medium">Measured</th>
                  </tr>
                </thead>
                <tbody id="analytics-pages" class="divide-y divide-neutral-200 dark:divide-neutral-800"></tbody>
              </table>
            </div>
          </section>

          <section aria-labelledby="analytics-referrers-title">
            <div class="mb-3">
              <h3 id="analytics-referrers-title" class="text-sm font-semibold">Acquisition</h3>
              <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">Where pageviews originated; same-site navigation is grouped with direct traffic.</p>
            </div>
            <div class="overflow-hidden rounded border border-neutral-200 dark:border-neutral-700">
              <table class="w-full text-left text-sm">
                <thead class="bg-neutral-50 text-xs text-neutral-500 dark:bg-neutral-900 dark:text-neutral-400">
                  <tr>
                    <th scope="col" class="px-3 py-2 font-medium">Source</th>
                    <th scope="col" class="px-3 py-2 text-right font-medium">Views</th>
                    <th scope="col" class="px-3 py-2 text-right font-medium">Share</th>
                  </tr>
                </thead>
                <tbody id="analytics-referrers" class="divide-y divide-neutral-200 dark:divide-neutral-800"></tbody>
              </table>
            </div>
          </section>
        </div>
      </div>
    </div>

    <!-- Edit panel: a resizable window rather than a fixed modal, because
         picking frames needs room. Size is remembered between sessions. -->
    <div
      id="edit-modal"
      class="fixed inset-0 z-50 hidden bg-black/60"
      role="dialog"
      aria-modal="true"
      aria-labelledby="edit-modal-title"
      aria-hidden="true"
    >
      <div
        id="edit-panel"
        class="absolute flex flex-col overflow-hidden rounded-lg border border-neutral-200 bg-white shadow-2xl dark:border-neutral-700 dark:bg-neutral-900"
      >
        <header
          id="edit-drag"
          class="flex shrink-0 cursor-move items-start justify-between gap-4 border-b border-neutral-200 px-5 py-3 dark:border-neutral-800"
        >
          <div class="min-w-0">
            <h2 class="truncate text-base font-semibold" id="edit-modal-title">Edit session</h2>
            <p id="edit-modal-meta" class="mt-0.5 truncate text-xs text-neutral-500 dark:text-neutral-400"></p>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <span
              id="edit-dirty"
              class="hidden rounded-full border border-amber-400 px-2 py-0.5 text-xs text-amber-700 dark:border-amber-500 dark:text-amber-300"
            >Unsaved</span>
            <a
              id="edit-view"
              href="#"
              target="_blank"
              rel="noopener"
              class="rounded px-2 py-1 text-xs text-neutral-500 hover:bg-neutral-100 hover:text-neutral-700 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-200"
            >View page →</a>
            <button
              id="edit-expand"
              type="button"
              class="rounded px-2 py-1 text-xs text-neutral-500 hover:bg-neutral-100 hover:text-neutral-700 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-200"
            >Fill screen</button>
            <button
              id="edit-close"
              type="button"
              aria-label="Close the editor"
              class="rounded px-2 py-1 text-sm text-neutral-500 hover:bg-neutral-100 hover:text-neutral-700 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-200"
            >✕</button>
          </div>
        </header>

        <form id="edit-form" class="flex min-h-0 flex-1 flex-col">
          <input type="hidden" id="edit-slug" />

          <div class="grid min-h-0 flex-1 overflow-y-auto lg:grid-cols-[20rem_minmax(0,1fr)] lg:overflow-hidden">
            <!-- Written detail -->
            <div
              class="space-y-4 border-b border-neutral-200 p-5 dark:border-neutral-800 lg:min-h-0 lg:overflow-y-auto lg:border-b-0 lg:border-r"
            >
              <div>
                <label for="edit-title" class="mb-1 block text-sm font-medium">Title</label>
                <input
                  id="edit-title"
                  type="text"
                  maxlength="200"
                  class="w-full rounded border border-neutral-300 bg-white px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none dark:border-neutral-600 dark:bg-neutral-800"
                />
              </div>

              <div>
                <label for="edit-location" class="mb-1 block text-sm font-medium">Location</label>
                <input
                  id="edit-location"
                  type="text"
                  maxlength="200"
                  class="w-full rounded border border-neutral-300 bg-white px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none dark:border-neutral-600 dark:bg-neutral-800"
                />
              </div>

              <div>
                <div class="mb-1 flex items-baseline justify-between gap-3">
                  <label for="edit-description" class="block text-sm font-medium">Description</label>
                  <span id="edit-description-count" class="text-xs tabular-nums text-neutral-500 dark:text-neutral-400"></span>
                </div>
                <textarea
                  id="edit-description"
                  maxlength="1000"
                  rows="7"
                  class="w-full resize-y rounded border border-neutral-300 bg-white px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none dark:border-neutral-600 dark:bg-neutral-800"
                ></textarea>
              </div>

              <div>
                <label for="edit-order" class="mb-1 block text-sm font-medium">Display order</label>
                <input
                  id="edit-order"
                  type="number"
                  step="1"
                  placeholder="Auto (by date)"
                  class="w-full rounded border border-neutral-300 bg-white px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none dark:border-neutral-600 dark:bg-neutral-800"
                />
                <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">Lower numbers appear first (0 is a valid order). Leave blank to sort by date.</p>
              </div>

              <dl id="edit-summary" class="space-y-1.5 border-t border-neutral-200 pt-4 text-xs dark:border-neutral-800"></dl>
            </div>

            <!-- Photographs -->
            <div class="flex flex-col lg:min-h-0">
              <div class="flex shrink-0 flex-wrap items-center gap-x-4 gap-y-2 border-b border-neutral-200 px-5 py-2.5 dark:border-neutral-800">
                <div
                  id="edit-modes"
                  class="flex overflow-hidden rounded border border-neutral-300 dark:border-neutral-600"
                  role="tablist"
                  aria-label="What a tap on a photograph does"
                >
                  <button id="mode-cover" type="button" role="tab" data-mode="cover" class="px-3 py-1.5 text-sm">Cover</button>
                  <button id="mode-header" type="button" role="tab" data-mode="header" class="border-l border-neutral-300 px-3 py-1.5 text-sm dark:border-neutral-600">Header</button>
                  <button id="mode-rotation" type="button" role="tab" data-mode="rotation" class="border-l border-neutral-300 px-3 py-1.5 text-sm dark:border-neutral-600">Rotation</button>
                  <button id="mode-captions" type="button" role="tab" data-mode="captions" class="border-l border-neutral-300 px-3 py-1.5 text-sm dark:border-neutral-600">Captions</button>
                </div>

                <label id="edit-filter-wrap" class="flex items-center gap-2 text-xs text-neutral-600 dark:text-neutral-300">
                  <input id="edit-only-fitting" type="checkbox" class="h-3.5 w-3.5" />
                  <span id="edit-filter-label">Only frames that fit</span>
                </label>

                <label class="ml-auto flex items-center gap-2 text-xs text-neutral-600 dark:text-neutral-300">
                  Size
                  <input id="edit-tile-size" type="range" min="120" max="420" step="20" class="w-28 sm:w-36" aria-label="Thumbnail size" />
                </label>
              </div>

              <p id="edit-mode-help" class="shrink-0 px-5 pt-3 text-xs text-neutral-500 dark:text-neutral-400"></p>

              <div id="edit-grid" class="p-5 lg:min-h-0 lg:flex-1 lg:overflow-y-auto"></div>
            </div>
          </div>

          <footer class="shrink-0 border-t border-neutral-200 px-5 py-3 dark:border-neutral-800">
            <div id="edit-error" class="mb-3 hidden rounded border border-red-300 bg-red-50 p-3 text-sm text-red-800 dark:border-red-800 dark:bg-red-950 dark:text-red-300"></div>
            <div class="flex items-center justify-between gap-3">
              <p id="edit-status" class="truncate text-xs text-neutral-500 dark:text-neutral-400"></p>
              <div class="flex shrink-0 items-center gap-3">
                <button
                  type="button"
                  id="edit-cancel"
                  class="rounded px-4 py-2 text-sm text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800"
                >Cancel</button>
                <button
                  type="submit"
                  id="edit-save"
                  class="rounded bg-neutral-900 px-4 py-2 text-sm font-medium text-white hover:bg-neutral-800 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-200"
                >Save</button>
              </div>
            </div>
          </footer>
        </form>

        <button
          id="edit-resize"
          type="button"
          aria-label="Resize the editor"
          class="absolute bottom-0 right-0 hidden h-5 w-5 cursor-nwse-resize items-center justify-center text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 sm:flex"
        >
          <svg viewBox="0 0 10 10" class="h-3 w-3" fill="currentColor" aria-hidden="true"><path d="M9 1v8H1l8-8z" opacity=".5"></path></svg>
        </button>
      </div>
    </div>

    <!-- Full-size preview, stacked above the editor -->
    <div
      id="preview-overlay"
      class="fixed inset-0 z-[60] hidden flex-col bg-black/90 p-4"
      role="dialog"
      aria-modal="true"
      aria-label="Photograph preview"
    >
      <div class="flex shrink-0 items-center justify-between gap-4 text-sm text-white">
        <p id="preview-name" class="truncate font-medium"></p>
        <div class="flex shrink-0 items-center gap-2">
          <button
            id="preview-assign"
            type="button"
            class="rounded border border-white/40 px-3 py-1.5 text-xs hover:bg-white/10"
          ></button>
          <button
            id="preview-prev"
            type="button"
            aria-label="Previous photograph"
            class="rounded border border-white/40 px-3 py-1.5 text-xs hover:bg-white/10"
          >←</button>
          <button
            id="preview-next"
            type="button"
            aria-label="Next photograph"
            class="rounded border border-white/40 px-3 py-1.5 text-xs hover:bg-white/10"
          >→</button>
          <button
            id="preview-close"
            type="button"
            aria-label="Close the preview"
            class="rounded border border-white/40 px-3 py-1.5 text-xs hover:bg-white/10"
          >✕</button>
        </div>
      </div>
      <div class="flex min-h-0 flex-1 items-center justify-center py-3">
        <img id="preview-image" alt="" class="h-full w-full object-contain" />
      </div>
      <p id="preview-note" class="shrink-0 text-center text-xs text-white/70"></p>
    </div>

    <!-- Toast -->
    <div
      id="toast"
      class="fixed bottom-6 right-6 z-50 hidden rounded-lg border border-green-300 bg-green-50 px-4 py-3 text-sm text-green-800 shadow-lg dark:border-green-800 dark:bg-green-950 dark:text-green-300"
      role="status"
      aria-live="polite"
    ></div>
  </section>

  <script src="@/lib/admin.ts"></script>
</BaseLayout>
