---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AquariumTank from "@/components/hobbies/AquariumTank.astro";
import TidePool from "@/components/hobbies/TidePool.astro";
import Fishing from "@/components/hobbies/Fishing.astro";
import Birding from "@/components/hobbies/Birding.astro";
import HerpingNight from "@/components/hobbies/HerpingNight.astro";
import PixelHike from "@/components/hobbies/PixelHike.astro";
import HobbyVideo from "@/components/hobbies/HobbyVideo.astro";
import BirdingSpark from "@/components/hobbies/BirdingSpark.astro";
import BirdingLifeList from "@/components/hobbies/BirdingLifeList.astro";
import INatObservations from "@/components/hobbies/INatObservations.astro";
import INatHerpMap from "@/components/hobbies/INatHerpMap.astro";
import DayList from "@/components/hobbies/DayList.astro";
import Lightbox from "@/components/Lightbox.astro";
import { hobbySlug } from "@/lib/hobbies";
import { hobbyFacts } from "@/lib/hobby-facts";

export async function getStaticPaths() {
  const hobbies = await getCollection("hobbies");
  return hobbies.map((entry) => ({
    params: { slug: hobbySlug(entry) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"hobbies">;
}

const { entry } = Astro.props;
const {
  title,
  summary,
  intro,
  interactive,
  media,
  mediaTitle,
  video,
  inaturalist,
  lifeList,
  spark,
  herpMap,
  dayList,
} = entry.data;
// A video takes the hero's place, and the hero photo joins the grid.
const heroPhoto = video ? undefined : media?.hero;
const galleryItems = [
  ...(video && media?.hero ? [media.hero] : []),
  ...(media?.gallery ?? []),
];
const facts = hobbyFacts(entry);
---

<BaseLayout title={title} description={summary} section="hobbies">
  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <header class="hobby-head">
      <a href="/hobbies/" class="hobby-back"
        >← <span class="draw">Things to try</span></a
      >
      <h1>{title}</h1>
      {facts && <p class="u-label hobby-facts">{facts}</p>}
      {intro && <p class="hobby-intro">{intro}</p>}
    </header>

    {interactive === "aquarium" && <AquariumTank moments={video?.moments} />}
    {interactive === "tidepool" && <TidePool />}
    {interactive === "fishing" && <Fishing />}
    {interactive === "birding" && <Birding />}
    {interactive === "roadcruise" && <HerpingNight />}
    {interactive === "pixel-hike" && <PixelHike />}

    {dayList && <DayList heading={dayList.heading} />}

    {
      spark && (
        <BirdingSpark
          userId={spark.userId}
          taxonId={spark.taxonId}
          heading={spark.heading}
          species={spark.species}
          scientificName={spark.scientificName}
          story={spark.story}
        />
      )
    }

    {
      lifeList && (
        <BirdingLifeList
          userId={lifeList.userId}
          url={lifeList.url}
          heading={lifeList.heading}
          blurb={lifeList.blurb}
          iconicTaxa={lifeList.iconicTaxa}
          featured={lifeList.featured}
        />
      )
    }

    {
      (media?.hero || video) && (
        <section class="mt-12" aria-label={mediaTitle ?? "Photos"}>
          <div class="mb-4">
            <div class="shead">
              <h2>{mediaTitle ?? "Photos"}</h2>
              {video && (
                <a
                  href={`https://www.youtube.com/watch?v=${video.youtubeId}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="shead-link"
                >
                  <span class="draw">{video.linkText}</span> →
                </a>
              )}
            </div>
            {video?.caption && <p class="shead-blurb">{video.caption}</p>}
          </div>
          {video && (
            <HobbyVideo
              youtubeId={video.youtubeId}
              title={video.title}
              lengthSeconds={video.lengthSeconds}
              poster={
                media?.hero && {
                  src: media.hero.display,
                  width: media.hero.width,
                  height: media.hero.height,
                }
              }
            />
          )}
          <div id="hobby-media">
            {heroPhoto && (
              <a
                href={heroPhoto.src}
                data-pswp-width={heroPhoto.width}
                data-pswp-height={heroPhoto.height}
                data-pswp-caption={heroPhoto.caption ?? ""}
                class="group block overflow-hidden border border-rule no-underline"
                aria-label={heroPhoto.caption || "Open full-resolution photo"}
              >
                <img
                  src={heroPhoto.display}
                  alt={heroPhoto.caption ?? ""}
                  width={heroPhoto.width}
                  height={heroPhoto.height}
                  loading="lazy"
                  class="block max-h-[70vh] w-full bg-band object-cover transition-opacity duration-300 group-hover:opacity-95"
                />
              </a>
            )}
            {galleryItems.length > 0 && (
              <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                {galleryItems.map((it) => (
                  <li>
                    <a
                      href={it.src}
                      data-pswp-width={it.width}
                      data-pswp-height={it.height}
                      data-pswp-caption={it.caption ?? ""}
                      class="group block overflow-hidden bg-band no-underline"
                      aria-label={it.caption || "Open full-resolution photo"}
                    >
                      <img
                        src={it.display}
                        alt={it.caption ?? ""}
                        loading="lazy"
                        class="aspect-square w-full object-cover transition-opacity duration-300 group-hover:opacity-90"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <Lightbox gallerySelector="#hobby-media" />
        </section>
      )
    }

    {
      inaturalist && (
        <INatObservations
          userId={inaturalist.userId}
          url={inaturalist.url}
          heading={inaturalist.heading}
          blurb={inaturalist.blurb}
          limit={inaturalist.limit}
          iconicTaxa={inaturalist.iconicTaxa}
          taxonId={inaturalist.taxonId}
        />
      )
    }

    {
      herpMap && (
        <INatHerpMap
          userId={herpMap.userId}
          url={herpMap.url}
          heading={herpMap.heading}
          blurb={herpMap.blurb}
          limit={herpMap.limit}
        />
      )
    }
  </article>
</BaseLayout>

<style>
  /* The archive's heading voice: light weight, sentence case, one tracked
     line of facts. */
  .hobby-head {
    margin-bottom: 28px;
  }
  .hobby-back {
    display: inline-block;
    font-size: 12px;
    color: var(--ink-2);
    text-decoration: none;
  }
  .hobby-back:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .hobby-head h1 {
    margin: 10px 0 0;
    font-size: clamp(22px, 2.4vw, 27px);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  .hobby-facts {
    margin: 6px 0 0;
  }
  .hobby-intro {
    margin: 12px 0 0;
    max-width: 62ch;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-3);
  }
</style>

<script>
  import { settleDots } from "@/lib/landing";

  settleDots();
</script>
