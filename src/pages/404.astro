---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="That page could not be found.">
  <section class="mx-auto max-w-prose px-4 py-20 text-center sm:px-6">
    <h1 class="text-2xl font-light tracking-tight sm:text-[30px]">404</h1>
    <p class="mt-2 text-sm text-ink-3">That page doesn't exist.</p>
    <p class="mt-6">
      <a href="/" class="u-label">← All sessions</a>
    </p>
  </section>
</BaseLayout>
