---
import { getCollection, type CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SessionCard from "@/components/SessionCard.astro";
import { sortSessions, sessionSlug } from "@/lib/sessions";
import { groupByRegion, countLine, type RegionGroup } from "@/lib/places";
import { siteConfig } from "../../../site.config";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/sessions/**/images/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);

export async function getStaticPaths() {
  const sessions = sortSessions(await getCollection("sessions"));
  return groupByRegion(sessions).map((group) => ({
    params: { region: group.slug },
    props: { group },
  }));
}

interface Props {
  group: RegionGroup;
}

const { group } = Astro.props;
const sessions = sortSessions(group.sessions);

function resolveCover(
  slug: string,
  coverFile: string | undefined,
  fallbackFile: string,
): ImageMetadata {
  const file = coverFile ?? fallbackFile;
  const mod = images[`/src/content/sessions/${slug}/images/${file}`];
  if (!mod)
    throw new Error(
      `Cover image not found for session "${slug}": expected ${file}.`,
    );
  return mod.default;
}

const toLabel = (entry: CollectionEntry<"sessions">) => entry.data.location;
// The distinct sub-locations inside this region, which is what makes the page
// worth reading rather than just a filtered list.
const places = [...new Set(sessions.map(toLabel).filter(Boolean))];
const years = [...new Set(sessions.map((s) => s.data.date.slice(0, 4)))].sort();
const yearRange = years.length > 1 ? `${years[0]}–${years.at(-1)}` : years[0];

const title = `${group.region} photography`;
const description = `Photographs from ${group.region}: ${countLine(group)}${yearRange ? `, ${yearRange}` : ""}. ${places.slice(0, 4).join(", ")}.`;

const cover = sessions[0];
const coverFile = cover?.data.cover ?? cover?.data.images[0]?.file;
const coverRecord = cover?.data.images.find((i) => i.file === coverFile);

const siteOrigin = (Astro.site ?? `https://${siteConfig.domain}`).toString();
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Photography", item: siteOrigin },
    {
      "@type": "ListItem",
      position: 2,
      name: group.region,
      item: new URL(`/places/${group.slug}/`, siteOrigin).toString(),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={coverRecord?.fullUrl}
  ogImageAlt={cover ? `${cover.data.title} cover photograph` : undefined}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumb)}
    is:inline
  />

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <header class="mb-8 space-y-2">
      <a
        href="/"
        class="text-xs text-neutral-600 no-underline hover:underline dark:text-neutral-400"
        >← All sessions</a
      >
      <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h1>
      <p class="text-xs tabular-nums text-neutral-500 dark:text-neutral-400">
        {countLine(group)}{yearRange && <span> · {yearRange}</span>}
      </p>
      {
        places.length > 0 && (
          <p class="max-w-prose text-sm text-neutral-700 dark:text-neutral-300">
            Everything I've photographed in {group.region}, grouped in one
            place: {places.join(", ")}.
          </p>
        )
      }
    </header>

    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        sessions.map((entry, index) => {
          const slug = sessionSlug(entry);
          return (
            <li>
              <SessionCard
                entry={entry}
                cover={resolveCover(
                  slug,
                  entry.data.cover,
                  entry.data.images[0].file,
                )}
                priority={index === 0}
              />
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>
