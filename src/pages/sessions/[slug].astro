---
import { getCollection, type CollectionEntry } from "astro:content";
import { Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Lightbox from "@/components/Lightbox.astro";
import {
  sessionSlug,
  formatDate,
  formatExif,
  sortSessions,
  copyrightLine,
  splitSessionTitle,
} from "@/lib/sessions";
import { siteConfig } from "../../../site.config";

type SessionLink = {
  slug: string;
  title: string;
  date: string;
  location: string;
};

export async function getStaticPaths() {
  const sessions = sortSessions(await getCollection("sessions"));
  const toLink = (entry: CollectionEntry<"sessions">): SessionLink => ({
    slug: sessionSlug(entry),
    title: entry.data.title,
    date: entry.data.date,
    location: entry.data.location,
  });
  return sessions.map((entry, index) => ({
    params: { slug: sessionSlug(entry) },
    props: {
      entry,
      previousSession: index > 0 ? toLink(sessions[index - 1]) : undefined,
      nextSession:
        index < sessions.length - 1 ? toLink(sessions[index + 1]) : undefined,
    },
  }));
}

interface Props {
  entry: CollectionEntry<"sessions">;
  previousSession?: SessionLink;
  nextSession?: SessionLink;
}

const { entry, previousSession, nextSession } = Astro.props;
const slug = sessionSlug(entry);
const { title, date, location, description, images: imageList } = entry.data;

// Pull processed ImageMetadata for every image in this session.
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/sessions/**/images/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);

type Resolved = {
  src: ImageMetadata;
  file: string;
  caption?: string;
  exif: string;
  fullUrl: string;
  ratio: number;
  viewUrl: string;
};

// Widest image the lightbox will ever need. Beyond this the extra pixels are
// invisible on any display we serve but cost megabytes per photograph.
const VIEW_MAX_WIDTH = 2400;

const resolved: Resolved[] = await Promise.all(
  imageList.map(async (img) => {
    const key = `/src/content/sessions/${slug}/images/${img.file}`;
    const mod = allImages[key];
    if (!mod) {
      throw new Error(
        `Image not found for session "${slug}": expected ${key}.`,
      );
    }
    // fullUrl points at the public Blob URL when running off remote prebuild.
    // In local-only mode the prebuild leaves it empty; fall back to the local
    // file path so the lightbox still works during development.
    const fullUrl = img.fullUrl ?? mod.default.src;

    // The lightbox used to open the untouched original: 3-13 MB per photograph,
    // served without a Cache-Control header, with nothing prefetched. Clicking
    // through a session re-downloaded all of that every time. It now opens this
    // capped WebP instead and fetches the original only once a photograph is
    // shown larger than this can fill, so zooming still reaches full detail.
    const viewWidth = Math.min(VIEW_MAX_WIDTH, mod.default.width);
    const view = await getImage({
      src: mod.default,
      width: viewWidth,
      format: "webp",
    });

    return {
      src: mod.default,
      file: img.file,
      caption: img.caption,
      exif: formatExif(img.exif),
      fullUrl,
      ratio: mod.default.width / mod.default.height,
      viewUrl: view.src,
    };
  }),
);

// The session opens on one photograph at full width, then the rest of the roll
// is laid out as justified rows: a row's photographs share a height and their
// widths stay proportional to their own shape, so nothing is cropped and both
// edges of the grid stay flush. Rows are grouped here rather than in the
// browser so the page needs no layout script and never reflows after load.
const lead = resolved[0];
const rest = resolved.slice(1);

// Roughly how many landscape frames sit across one row. Portraits count for
// less, so a row of them packs more in.
const TARGET_ROW_RATIO = 3.1;

type Row = { items: typeof rest; sum: number; pad: number };
const rows: Row[] = [];
let current: typeof rest = [];
let sum = 0;
for (const img of rest) {
  current.push(img);
  sum += img.ratio;
  if (sum >= TARGET_ROW_RATIO) {
    rows.push({ items: current, sum, pad: 0 });
    current = [];
    sum = 0;
  }
}
if (current.length) {
  // A short final row would otherwise stretch to full width and tower over
  // everything above it. Pad it so it keeps the height of its neighbours.
  rows.push({
    items: current,
    sum,
    pad: Math.max(0, TARGET_ROW_RATIO - sum),
  });
}

// Social-share preview image: the session cover (or first image). Prefer the
// public Blob URL so it resolves for crawlers; fall back to the local asset.
const coverFile = entry.data.cover ?? imageList[0]?.file;
const coverResolved = resolved.find((r) => r.file === coverFile) ?? resolved[0];
const ogImage = coverResolved?.fullUrl;
// Skip the location when the title already names it, so auto-generated copy
// doesn't read "Mt Everest May 2026 in Tibet side of Mt Everest".
const locationSuffix =
  location && !title.toLowerCase().includes(location.toLowerCase())
    ? `, ${location}`
    : "";
const pageDescription =
  description ||
  `${imageList.length} photograph${imageList.length === 1 ? "" : "s"} from ${title}${locationSuffix}, by ${siteConfig.ownerName}.`;

// Titles carry the place and date, so they stand alone as alt text. Appending
// the location too would just repeat it ("Gunn Peak, Washington — June 2026,
// Central Cascades, Washington").
const fallbackAlt = title;

const siteOrigin = Astro.site ?? `https://${siteConfig.domain}`;
const pageUrl = new URL(`/sessions/${slug}/`, siteOrigin).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Photography",
          item: siteOrigin.toString(),
        },
        { "@type": "ListItem", position: 2, name: title, item: pageUrl },
      ],
    },
    // Image metadata is the one image-related markup Google documents support
    // for. contentUrl points at the full-resolution original so Google Images
    // has a discovery path to it beyond the single og:image cover.
    ...resolved
      .filter((img) => img.fullUrl.startsWith("http"))
      .map((img) => ({
        "@type": "ImageObject",
        contentUrl: img.fullUrl,
        representativeOfPage: img.file === coverFile,
        ...(img.caption
          ? { caption: img.caption, name: img.caption }
          : { name: fallbackAlt }),
        creator: { "@type": "Person", name: siteConfig.ownerName },
        creditText: siteConfig.ownerName,
        copyrightNotice: copyrightLine(),
      })),
  ],
};
---

<BaseLayout
  title={title}
  description={pageDescription}
  ogImage={ogImage}
  ogImageAlt={coverResolved?.caption ?? `${title} cover photograph`}
  activeSlug={slug}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
    is:inline
  />

  <article class="session">
    <header class="shead">
      <a class="back u-label" href="/">← All sessions</a>
      <div class="row">
        <h1>{splitSessionTitle(title).label}</h1>
        <span class="meta u-label">
          <time datetime={date}>{formatDate(date)}</time>
          {location && <span> · {location}</span>}
          <span>
            · {resolved.length} photograph{
              resolved.length === 1 ? "" : "s"
            }</span
          >
        </span>
      </div>
      {description && <p class="note">{description}</p>}
    </header>

    <ul id="gallery" class="photos">
      {
        lead && (
          <li class="lead-shot">
            <figure>
              <a
                href={lead.viewUrl}
                data-pswp-full={lead.fullUrl}
                data-pswp-width={lead.src.width}
                data-pswp-height={lead.src.height}
                data-pswp-caption={lead.caption ?? ""}
                data-pswp-exif={lead.exif}
                data-pswp-filename={lead.file}
                class="frame"
                aria-label={
                  lead.caption ?? `${title}, photo 1 of ${resolved.length}`
                }
              >
                <Picture
                  src={lead.src}
                  alt={lead.caption || fallbackAlt}
                  widths={[480, 800, 1200, 1600]}
                  width={Math.min(1600, lead.src.width)}
                  sizes="(min-width: 900px) 72vw, 100vw"
                  formats={["webp"]}
                  fallbackFormat="jpeg"
                  loading="eager"
                  fetchpriority="high"
                  class="photo"
                />
              </a>
              <figcaption class="u-label">
                <span>01 / {resolved.length}</span>
                {lead.exif && <span class="exif">{lead.exif}</span>}
              </figcaption>
            </figure>
          </li>
        )
      }
      {
        rows.map((row, rowIndex) => (
          <li class="band" style={`--pad:${row.pad.toFixed(4)}`}>
            <ul class="band-inner">
              {row.items.map((img, itemIndex) => {
                // Position within the whole session, for the caption numbering.
                const index =
                  rows
                    .slice(0, rowIndex)
                    .reduce((n, r) => n + r.items.length, 0) +
                  itemIndex +
                  1;
                return (
                  <li style={`--ar:${img.ratio.toFixed(4)}`}>
                    <figure>
                      <a
                        href={img.viewUrl}
                        data-pswp-full={img.fullUrl}
                        data-pswp-width={img.src.width}
                        data-pswp-height={img.src.height}
                        data-pswp-caption={img.caption ?? ""}
                        data-pswp-exif={img.exif}
                        data-pswp-filename={img.file}
                        class="frame"
                        aria-label={
                          img.caption ??
                          `${title}, photo ${index + 1} of ${resolved.length}`
                        }
                      >
                        <Picture
                          src={img.src}
                          alt={img.caption || fallbackAlt}
                          widths={[480, 800, 1200, 1600]}
                          width={Math.min(1600, img.src.width)}
                          sizes="(min-width: 900px) 26vw, 100vw"
                          formats={["webp"]}
                          fallbackFormat="jpeg"
                          loading={rowIndex === 0 ? "eager" : "lazy"}
                          class="photo"
                        />
                      </a>
                      <figcaption class="u-label">
                        <span>
                          {String(index + 1).padStart(2, "0")} /{" "}
                          {resolved.length}
                        </span>
                        {img.exif && <span class="exif">{img.exif}</span>}
                      </figcaption>
                    </figure>
                  </li>
                );
              })}
              {row.pad > 0 && <li class="pad" aria-hidden="true" />}
            </ul>
          </li>
        ))
      }
    </ul>

    <Lightbox gallerySelector="#gallery" />

    {
      (previousSession || nextSession) && (
        <nav aria-label="More photography sessions" class="keep">
          <p class="u-label">Keep exploring</p>
          <div class="keep-row">
            {previousSession && (
              <a href={`/sessions/${previousSession.slug}/`} class="keep-link">
                <span class="u-label">← Previous in archive</span>
                <span class="kt">
                  {splitSessionTitle(previousSession.title).label}
                </span>
              </a>
            )}
            {nextSession && (
              <a href={`/sessions/${nextSession.slug}/`} class="keep-link next">
                <span class="u-label">Next in archive →</span>
                <span class="kt">
                  {splitSessionTitle(nextSession.title).label}
                </span>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .session {
    display: block;
  }

  .shead {
    padding: 26px var(--gutter) 0;
    max-width: 70ch;
  }
  .back {
    text-decoration: none;
  }
  .back:hover {
    color: var(--ink);
  }
  .shead .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
  .shead h1 {
    font-size: clamp(20px, 2.2vw, 27px);
    font-weight: 300;
    margin: 0;
    line-height: 1.12;
    letter-spacing: -0.012em;
  }
  .shead .note {
    margin: 14px 0 0;
    color: var(--ink-3);
    font-size: 15px;
    line-height: 1.6;
  }

  /* One column of large photographs, each at the shape it was taken. */
  .photos {
    list-style: none;
    margin: 0;
    padding: 22px var(--gutter) 12vh;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .photos li {
    margin: 0;
  }
  .lead-shot {
    margin-bottom: 3vh;
  }
  .band-inner {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 5px;
  }
  /* Widths grow in proportion to each photograph's own shape, so every frame
     in a row lands on the same height with nothing cropped. */
  .band-inner > li {
    flex: var(--ar) 1 0;
    min-width: 0;
  }
  .band-inner > li.pad {
    flex: var(--pad) 1 0;
  }
  .photos figure {
    margin: 0;
  }
  .frame {
    display: flex;
    justify-content: center;
    text-decoration: none;
  }
  .frame :global(.photo) {
    max-height: 88vh;
    width: auto;
    max-width: 100%;
    height: auto;
    background: var(--band);
    cursor: zoom-in;
  }
  .lead-shot :global(.photo) {
    max-height: 78vh;
  }
  .band-inner :global(.photo) {
    width: 100%;
    max-height: none;
  }
  /* The grid stays quiet: numbering and exif live in the lightbox. */
  .photos figcaption {
    margin-top: 9px;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding-top: 8px;
    border-top: 1px solid var(--rule);
  }
  .photos .band-inner figcaption {
    display: none;
  }

  .keep {
    border-top: 1px solid var(--rule);
    margin: 0 var(--gutter);
    padding: 18px 0 12vh;
  }
  .keep-row {
    display: grid;
    gap: 16px;
    margin-top: 10px;
  }
  .keep-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .keep-link .kt {
    display: block;
    margin-top: 2px;
    font-size: 15px;
  }
  .keep-link:hover .kt {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 640px) {
    .keep-row {
      grid-template-columns: 1fr 1fr;
    }
    .keep-link.next {
      grid-column-start: 2;
      text-align: right;
    }
  }
  @media (max-width: 899px) {
    .shead {
      padding-top: 18px;
    }
    .shead .row {
      flex-direction: column;
      gap: 4px;
    }
    .frame :global(.photo) {
      max-height: 70vh;
    }
    .photos {
      gap: 4vh;
    }
    .lead-shot {
      margin-bottom: 1vh;
    }
    /* A three-up row would put each photograph at about 120px on a phone.
       Stack them instead and let the lightbox do the close looking. */
    .band-inner {
      flex-direction: column;
      gap: 4vh;
    }
    .band-inner > li {
      flex: none;
    }
    .band-inner > li.pad {
      display: none;
    }
    .band-inner :global(.photo) {
      width: auto;
      max-height: 70vh;
    }
    .photos .band-inner figcaption {
      display: flex;
    }
    .photos figcaption .exif {
      display: none;
    }
  }
</style>
